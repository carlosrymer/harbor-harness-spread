[65.905178, "i", "python3 -c \"import rdflib\ng = rdflib.Graph()\ng.parse('/app/university_graph.ttl', format='turtle')\nUNI = rdflib.Namespace('http://university.org/ontology/')\n\nfor s in sorted(g.subjects(UNI.role, rdflib.Literal('Student'))):\n    enrolled_in = list(g.objects(s, UNI.isEnrolledIn))\n    enr_date = list(g.objects(s, UNI.hasEnrollmentDate))\n    grad_date = list(g.objects(s, UNI.hasGraduationDate))\n    print(s, 'Enrolled in:', [str(x).split('/')[-1] for x in enrolled_in], 'Enr:', enr_date, 'Grad:', grad_date)\n\"\n"]
[65.908125, "o", "python3 -c \"import rdflib\r\n\u001b[?2004l\r"]
[65.910985, "o", "\u001b[?2004h> g = rdflib.Graph()\r\n\u001b[?2004l\r\u001b[?2004h> g.parse('/app/university_graph.ttl', format='turtle')\r\n\u001b[?2004l\r\u001b[?2004h> UNI = rdflib.Namespace('http://university.org/ontology/')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for s in sorted(g.subjects(UNI.role, rdflib.Literal('Student'))):\r\n\u001b[?2004l\r\u001b[?2004h>     enrolled_in = list(g.objects(s, UNI.isEnrolledIn))\r\n\u001b[?2004l\r\u001b[?2004h>     enr_date = list(g.objects(s, UNI.hasEnrollmentDate))\r\n\u001b[?2004l\r\u001b[?2004h>     grad_date = list(g.objects(s, UNI.hasGraduationDate))\r\n\u001b[?2004l\r\u001b[?2004h>     print(s, 'Enrolled in:', [str(x).split('/')[-1] for x in enrolled_in], 'Enr:', enr_date, 'Grad:', grad_date)\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
