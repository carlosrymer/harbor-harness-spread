[81.132171, "i", "python3 -c \"import rdflib; g=rdflib.Graph(); g.parse('/app/university_graph.ttl', format='turtle'); UNI=rdflib.Namespace('http://university.org/ontology/'); ref='2025-08-16';\nfor dept in sorted(set(g.objects(None, UNI.isTaughtIn))):\n    courses = list(g.subjects(UNI.isTaughtIn, dept))\n    students_active = set()\n    students_total = set()\n    for c in courses:\n        for s in g.subjects(UNI.isEnrolledIn, c):\n            students_total.add(s)\n            enr = list(g.objects(s, UNI.hasEnrollmentDate))\n            grad = list(g.objects(s, UNI.hasGraduationDate))\n            enr_ok = enr and str(enr[0]) <= ref\n            grad_ok = not grad or str(grad[0]) > ref\n            if enr_ok and grad_ok:\n                students_active.add(s)\n    print(str(dept).split('/')[-1], 'Total distinct students:', len(students_total), 'Active distinct students:', len(students_active))\n\"\n"]
