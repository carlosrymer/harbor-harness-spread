[168.546229, "i", "python3 -c \"import rdflib; g = rdflib.Graph(); g.parse('/app/university_graph.ttl'); q = '''PREFIX uni: <http://university.org/ontology/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT ?dept (COUNT(DISTINCT ?student) AS ?cnt) WHERE { ?course uni:isTaughtIn ?dept . ?student uni:isEnrolledIn ?course . OPTIONAL { ?student uni:hasEnrollmentDate ?enrDate } OPTIONAL { ?student uni:hasGraduationDate ?gradDate } FILTER (!BOUND(?enrDate) || ?enrDate <= '2025-08-16'^^xsd:date) FILTER (!BOUND(?gradDate) || ?gradDate > '2025-08-16'^^xsd:date) } GROUP BY ?dept HAVING (?cnt > 10)'''; [print(r[0], r[1]) for r in g.query(q)]\"\n"]
[168.549044, "o", "python3 -c \"import rdflib; g = rdflib.Graph(); g.parse('/app/university_graph.ttl'); q = '''PREFIX uni: <http://university.org/ontology/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT ?dept (COUNT(DISTINCT ?student) AS ?cnt) WHERE { ?course uni:isTaughtIn ?dept . ?student uni:isEnrolledIn ?course . OPTIONAL { ?student uni:hasEnrollmentDate ?enrDate } OPTIONAL { ?student uni:hasGraduationDate ?gradDate } FILTER (!BOUND(?enrDate) || ?enrDate <= '2025-08-16'^^xsd:date) FILTER (!BOUND(?gradDate) || ?gradDate > '2025-08-16'^^xsd:date) } GROUP BY ?dept HAVING (?cnt > 10)'''; [print(r[0], r[1]) for r in g.query(q)]\"\r\n\u001b[?2004l\r"]
