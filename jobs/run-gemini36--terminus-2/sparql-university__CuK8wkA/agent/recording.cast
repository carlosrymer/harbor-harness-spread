('2024-01-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))], [rdflib.term.Literal('2025-06-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))]), (rdflib.term.URIRef('http://university.org/ontology/Student22'), [rdflib.term.Literal('2024-01-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))], [rdflib.term.Literal('2025-06-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))]), (rdflib.term.URIRef('http://university.org/ontology/Student23'), [rdflib.term.Literal('2024-01-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))], [rdflib.term.Literal('2025-06-11', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))]), (rdflib.term.URIRef('http://university.org/ontology/Student24'), [rdflib.term.Literal('2024-01-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))], [rdflib.term.Literal('2026-06-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))]), (rdflib.term.URIRef('http://university.org/ontology/Student25'), [rdflib.term.Literal('2024-01-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))], [rdflib.term.Literal('2025-06-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))]), (rdflib.term.URIRef('http://university.org/ontology/Student26'), [rdflib.term.Literal('2024-01-12', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))], [rdflib.term.Literal('2025-06-02', datatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#date'))])]\r\n"]
