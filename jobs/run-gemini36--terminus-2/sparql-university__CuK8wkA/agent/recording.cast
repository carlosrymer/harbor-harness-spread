[59.983775, "i", "python3 -c \"import rdflib\ng = rdflib.Graph()\ng.parse('/app/university_graph.ttl', format='turtle')\nUNI = rdflib.Namespace('http://university.org/ontology/')\nfor prof in g.subjects(UNI.role, None):\n    role = list(g.objects(prof, UNI.role))[0]\n    if 'Student' in str(role):\n        continue\n    name = list(g.objects(prof, UNI.hasName))[0]\n    print(f'\\nProfessor: {name} - Role: {role}')\n    depts = list(g.objects(prof, UNI.worksIn))\n    for dept in depts:\n        unis = list(g.objects(dept, UNI.belongsTo))\n        for uni in unis:\n            countries = list(g.objects(uni, UNI.locatedInCountry))\n            print(f'  Dept: {dept} | Uni: {uni} | Country: {countries}')\n    courses = list(g.objects(prof, UNI.teaches))\n    print(f'  Teaches: {courses}')\n\"\n"]
[59.984373, "o", "python3 -c \"import rdflib\r\n\u001b[?2004l\r"]
[59.985803, "o", "\u001b[?2004h> g = rdflib.Graph()\r\n\u001b[?2004l\r\u001b[?2004h> g.parse('/app/university_graph.ttl', format='turtle')\r\n\u001b[?2004l\r\u001b[?2004h> UNI = rdflib.Namespace('http://university.org/ontology/')\r\n\u001b[?2004l\r\u001b[?2004h> for prof in g.subjects(UNI.role, None):\r\n\u001b[?2004l\r\u001b[?2004h>     role = list(g.objects(prof, UNI.role))[0]\r\n\u001b[?2004l\r\u001b[?2004h>     if 'Student' in str(role):\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     name = list(g.objects(prof, UNI.hasName))[0]\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'\\nProfessor: {name} - Role: {role}')\r\n\u001b[?2004l\r\u001b[?2004h>     depts = list(g.objects(prof, UNI.worksIn))\r\n\u001b[?2004l\r\u001b[?2004h>     for dept in depts:\r\n\u001b[?2004l\r\u001b[?2004h>         unis = list(g.objects(dept, UNI.belongsTo))\r\n\u001b[?2004l\r\u001b[?2004h>         for uni in unis:\r\n\u001b[?2004l\r\u001b[?2004h>             countries = list(g.objects(uni, UNI.locatedInCountry))\r\n\u001b[?2004l\r\u001b[?2004h>             print(f'  Dept: {dept} | Uni: {uni} | Country: {countries}')\r\n\u001b[?2004l\r\u001b[?2004h>     courses = list(g.objects(prof, UNI.teaches))"]
[59.986236, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.98651, "o", "    print(f'  Teaches: {courses}')\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
