[60.094909, "o", "  Dept: http://university.org/ontology/Sloan_MIT | Uni: http://university.org/ontology/MIT | Country: [rdflib.term.Literal('US')]\r\n  Teaches: [rdflib.term.URIRef('http://university.org/ontology/CS101')]\r\n\r\nProfessor: Athanasios Voulodimos - Role: Assistant Professor of Computer Science\r\n  Dept: http://university.org/ontology/ComputerScience_NTUA | Uni: http://university.org/ontology/NTUA | Country: [rdflib.term.Literal('GR')]\r\n  Teaches: [rdflib.term.URIRef('http://university.org/ontology/CS101')]\r\n\r\nProfessor: Pepe Attanasio - Role: Professor of Mathematics\r\n  Dept: http://university.org/ontology/Mathematics_IST | Uni: http://university.org/ontology/IST | Country: [rdflib.term.Literal('PT')]\r\n  Dept: http://university.org/ontology/ComputerScience_NTUA | Uni: http://university.org/ontology/NTUA | Country: [rdflib.term.Literal('GR')]\r\n"]
[60.095038, "o", "  Teaches: [rdflib.term.URIRef('http://university.org/ontology/Math101'), rdflib.term.URIRef('http://university.org/ontology/AI101')]\r\n\r\nProfessor: Marie Dubois - Role: Professor of Mathematics"]
[60.095245, "o", "\r\n  Dept: http://university.org/ontology/Mathematics_Sorbonne | Uni: http://university.org/ontology/Sorbonne | Country: [rdflib.term.Literal('FR')]\r\n  Teaches: [rdflib.term.URIRef('http://university.org/ontology/Math201')]\r\n\r\nProfessor: Aristotle Tympas - Role: Professor of History of Scienceand Technology\r\n  Dept: http://university.org/ontology/HistoryAndPhilosophy_NKUA | Uni: http://university.org/ontology/NKUA | Country: [rdflib.term.Literal('GR')]\r\n  Teaches: [rdflib.term.URIRef('http://university.org/ontology/STS101')]\r\n\r\nProfessor: John Smith - Role: Professor of Biology\r\n  Dept: http://university.org/ontology/Biology_MIT | Uni: http://university.org/ontology/MIT | Country: [rdflib.term.Literal('US')]\r\n  Teaches: [rdflib.term.URIRef('http://university.org/ontology/Bio101')]\r\n"]
