[118.696477, "i", "python3 -c \"import rdflib; g=rdflib.Graph(); g.parse('/app/university_graph.ttl', format='turtle'); q='''PREFIX uni: <http://university.org/ontology/>\\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\\nSELECT ?bigDept (COUNT(DISTINCT ?student) AS ?sc) WHERE { ?course uni:isTaughtIn ?bigDept . ?student uni:isEnrolledIn ?course . OPTIONAL { ?student uni:hasEnrollmentDate ?enrDate } OPTIONAL { ?student uni:hasGraduationDate ?gradDate } FILTER (!BOUND(?enrDate) || ?enrDate <= '2025-08-16'^^xsd:date) FILTER (!BOUND(?gradDate) || ?gradDate > '2025-08-16'^^xsd:date) } GROUP BY ?bigDept HAVING (?sc > 10)'''; [print(r[0], r[1]) for r in g.query(q)]\"\n"]
[118.698872, "o", "python3 -c \"import rdflib; g=rdflib.Graph(); g.parse('/app/university_graph.ttl', format='turtle'); q='''PREFIX uni: <http://university.org/ontology/>\\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\\nSELECT ?bigDept (COUNT(DISTINCT ?student) AS ?sc) WHERE { ?course uni:isTaughtIn ?bigDept . ?student uni:isEnrolledIn ?course . OPTIONAL { ?student uni:hasEnrollmentDate ?enrDate } OPTIONAL { ?student uni:hasGraduationDate ?gradDate } FILTER (!BOUND(?enrDate) || ?enrDate <= '2025-08-16'^^xsd:date) FILTER (!BOUND(?gradDate) || ?gradDate > '2025-08-16'^^xsd:date) } GROUP BY ?bigDept HAVING (?sc > 10)'''; [print(r[0], r[1]) for r in g.query(q)]\""]
[118.69916, "o", "\r\n\u001b[?2004l\rbash: !BOUND: event not found\r\n"]
