[75.201662, "i", "python3 -c \"import rdflib; g=rdflib.Graph(); g.parse('/app/university_graph.ttl', format='turtle'); UNI=rdflib.Namespace('http://university.org/ontology/'); ref='2025-08-16'; [print(str(c).split('/')[-1], str(list(g.objects(c, UNI.isTaughtIn))[0]).split('/')[-1], len(list(g.subjects(UNI.isEnrolledIn, c))), len([s for s in g.subjects(UNI.isEnrolledIn, c) if (not list(g.objects(s, UNI.hasGraduationDate)) or str(list(g.objects(s, UNI.hasGraduationDate))[0]) > ref)])) for c in sorted(g.subjects(rdflib.RDF.type, UNI.Course))]\"\n"]
