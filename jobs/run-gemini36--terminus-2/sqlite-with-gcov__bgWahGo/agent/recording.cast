[93.788466, "o", "\u001b[?2004hroot@05793b0e80a3:/app/sqlite# "]
[116.861536, "i", "./configure --help\n"]
[116.861817, "o", "./configure --help"]
[116.865747, "o", "\r\n\u001b[?2004l\r"]
[116.885939, "o", "Usage: configure [options] [settings]\r\r\n\r\r\nThis is autosetup v0.7.2, a build environment \"autoconfigurator\"\r\r\nSee the documentation online at https://msteveb.github.io/autosetup/\r\r\n\r\r\n"]
[116.895346, "o", "  --help?=all?                     display help and options. Optional: module name, such as --help=system\r\r\n  --license                        display the autosetup license\r\r\n  --version                        display the version of autosetup\r\r\n  --reference?=text?               display the autosetup command reference. 'text', 'wiki', 'asciidoc' or 'markdown'\r\r\n  --autosetup-debug                display debugging output as autosetup runs\r\r\n"]
[116.895485, "o", "  --install?=.?                    install autosetup to the current or given directory\r\r\n  --init?=help?                    create initial auto.def, etc. Use --init=help for known types\r\r\n"]
[116.895709, "o", "  --host=host-alias                a complete or partial cpu-vendor-opsys for the system where the application will run (defaults to the same value as\r\r\n                                   --build)\r\r\n"]
[116.895932, "o", "  --build=build-alias              a complete or partial cpu-vendor-opsys for the system where the application will be built (defaults to the result of\r\r\n                                   running config.guess)\r\r\n  --prefix=dir                     the target directory for the build (default: '/usr/local')\r\r\nLocal Options:\r\r\n  --disable-shared                 Disable build of shared library\r\r\n  --disable-static                 Disable build of static library\r\r\n  --disable-amalgamation           Disable the amalgamation and instead build all files separately\r\r\n  --disable-threadsafe             Disable mutexing\r\r\n  --with-tempstore?=no?            Use an in-RAM database for temporary tables: never,no,yes,always\r\r\n  --disable-load-extension         Disable loading of external extensions\r\r\n  --disable-math                   Disable math functions\r\r\n  --disable-json                   Disable JSON functions\r\r\n  --memsys5                        Enable MEMSYS5\r\r\n  --memsys3                        Enable MEMSYS3\r\r\n  --fts3                           Enable the FTS3 extension\r\r\n  --fts4                           Enable the FTS4 extension\r\r\n  --fts5                           Enable the FTS5 extension\r\r\n  --update-limit                   Enable the UPDATE/DELETE LIMIT clause\r\r\n  --geopoly                        Enable the GEOPOLY extension\r\r\n  --rtree                          Enable the RTREE extension\r\r\n  --session                        Enable the SESSION extension\r\r\n  --all                            Enable these extensions: fts4 fts5 rtree geopoly session\r\r\n"]
[116.895954, "o", "  --disable-largefile              This legacy flag has no effect on the library but may influence the generated sqlite_cfg.h by adding #define HAVE_LFS\r\r\n"]
[116.896265, "o", "  --disable-tcl                    Disable components which require TCL, including all tests. This tree requires TCL for code generation but can use the\r\r\n                                   in-tree copy of autosetup/jimsh0.c for that. The SQLite TCL extension and the test code require a canonical tclsh.\r\r\n"]
[116.8972, "o", "  --with-tcl=DIR                   Directory containing tclConfig.sh or a directory one level up from that, from which we can derive a directory containing\r\r\n                                   tclConfig.sh. A dir name of \"prefix\" is equivalent to the directory specified by the --prefix flag.\r\r\n  --with-tclsh=PATH                Full pathname of tclsh to use. It is used for (A) trying to find tclConfig.sh and (B) all TCL-based code generation.\r\r\n                                   Warning: if its containing dir has multiple tclsh versions, it may select the wrong tclConfig.sh!\r\r\n"]
[116.897714, "o", "  --static-tclsqlite3              Statically-link tclsqlite3. This only works if TCL support is enabled and all requisite libraries are available in static\r\r\n                                   form. Note that glibc is unable to fully statically link certain libraries required by tclsqlite3, so this won't work on\r\r\n                                   most Linux environments.\r\r\n  --disable-readline               Disable readline support\r\r\n  --with-readline-ldflags?=auto?   Readline LDFLAGS, e.g. -lreadline -lncurses\r\r\n  --with-readline-cflags?=auto?    Readline CFLAGS, e.g. -I/path/to/includes\r\r\n  --with-readline-header=PATH      Full path to readline.h, from which --with-readline-cflags will be derived\r\r\n  --with-linenoise=DIR             Source directory for linenoise.c and linenoise.h\r\r\n  --editline                       Enable BSD editline support\r\r\n  --with-icu-ldflags=LDFLAGS       Enable SQLITE_ENABLE_ICU and add the given linker flags for the ICU libraries. e.g. on Ubuntu systems, try '-licui18n\r\r\n                                   -licuuc -licudata'.\r\r\n  --with-icu-cflags=CFLAGS         Apply extra CFLAGS/CPPFLAGS necessary for building with ICU. e.g. -I/usr/local/include\r\r\n  --with-icu-config?=auto?         Enable SQLITE_ENABLE_ICU. Value must be one of: auto, pkg-config, /path/to/icu-config\r\r\n  --icu-collations                 Enable SQLITE_ENABLE_ICU_COLLATIONS. Requires --with-icu-ldflags=... or --with-icu-config\r\r\n  --with-wasi-sdk?=/opt/wasi-sdk?  Top-most dir of the wasi-sdk for a WASI build\r\r\n  --static-cli-shell               Statically-link the sqlite3 CLI shell. This only works if the requisite libraries are all available in static form.\r\r\n  --static-shells                  Shorthand for --static-cli-shell --static-tclsqlite3\r\r\n  --with-emsdk?=auto?              Top-most dir of the Emscripten SDK installation. Needed only by ext/wasm. Default=EMSDK env var.\r\r\n  --amalgamation-extra-src=FILES   Space-separated list of soure files to append as-is to the resulting sqlite3.c amalgamation file. May be provided multiple\r\r\n                                   times.\r\r\n  --soname?=legacy?                SONAME for libsqlite3.so. \"none\", or not using this flag, sets no soname. \"legacy\" sets it to its historical value of\r\r\n                                   libsqlite3.so.0. A value matching the glob \"libsqlite3.*\" sets it to that literal value. Any other value is assumed to be a\r\r\n                                   suffix which gets applied to \"libsqlite3.so.\", e.g. --soname=9.10 equates to \"libsqlite3.so.9.10\".\r\r\n  --dll-basename?=auto?            Specifies the base name of the resulting DLL file. If not provided, \"libsqlite3\" is usually assumed but on some platforms a\r\r\n                                   platform-dependent default is used. On some platforms this flag gets automatically enabled if it is not provided. Use\r\r\n                                   \"default\" to explicitly disable platform-dependent activation on such systems.\r\r\n  --out-implib?=auto?              Enable use of --out-implib linker flag to generate an \"import library\" for the DLL. The output's base name is specified by\r\r\n                                   this flag's value, with \"auto\" meaning to figure out a name automatically. On some platforms this flag gets automatically\r\r\n                                   enabled if it is not provided. Use \"none\" to explicitly disable this feature on such platforms.\r\r\n  --debug                          Enable debug build flags. This option will impact performance by as much as 4x, as it includes large numbers of assert()s\r\r\n                                   in performance-critical loops. Never use --debug for production builds.\r\r\n  --scanstatus                     Enable the SQLITE_ENABLE_STMT_SCANSTATUS feature flag\r\r\n  --dev                            Enable dev-mode build: automatically enables certain other flags\r\r\n  --test-status                    Enable status of tests\r\r\n  --gcov                           Enable coverage testing using gcov\r\r\n  --linemacros                     Enable #line macr"]
[116.898033, "o", "os in the amalgamation\r\r\n  --dynlink-tools                  Dynamically link libsqlite3 to certain tools which normally statically embed it\r\r\n  --asan-fsanitize?=auto?          Comma- or space-separated list of -fsanitize flags for use with the fuzzcheck-asan tool. Only those which the compiler\r\r\n                                   claims to support will actually be used. May be provided multiple times.\r\r\n  --dump-defines                   Dump autosetup defines to ./config.defines.txt (for build debugging)\r\r\n"]
[116.898407, "o", "\u001b[?2004hroot@05793b0e80a3:/app/sqlite# "]
