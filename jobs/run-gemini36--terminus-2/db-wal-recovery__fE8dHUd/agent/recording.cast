d/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/9/fs/app 2>/dev/null\\r\\n   13  ls -la /var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/1043/fs/app\\r\\n   14  ls /var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/\\r\\n   15  ls -la /app; which ext4magic extundelete fls icat 2>/dev/null; history | tail -n 20\\r\\n\"]\r\n\u001b[35m\u001b[K/logs/agent/recording.cast\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K[136.703068, \"i\", \"python3 -c \\\"with open('/dev/vda', 'rb') as f: pos=0; chunk_size=1024*1024\\n while True:\\n  d=f.read(chunk_size)\\n  if not d: break\\n  if b'\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K' in d: print('Found at', pos)\\n  pos+=len(d)\\\"\\n\"]\r\n"]
[310.042869, "o", "\u001b[35m\u001b[K/logs/agent/recording.cast\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K[136.709234, \"o\", \">  while True:\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>   d=f.read(chunk_size)\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>   if not d: break\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>   if b'\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K' in d: print('Found at', pos)\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>   pos+=len(d)\\\"\\r\\n\\u001b[?2004l\\r\"]\r\n"]
[310.043024, "o", "\u001b[35m\u001b[K/logs/agent/recording.cast\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K[153.900255, \"i\", \"cat << 'EOF' > /tmp/find_wal.py\\nwith open('/dev/vda', 'rb') as f:\\n    pos = 0\\n    chunk_size = 1024 * 1024\\n    while True:\\n        data = f.read(chunk_size)\\n        if not data:\\n            break\\n        if b'\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K' in data:\\n            print(f'Found \u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K around offset {pos}')\\n            idx = 0\\n            while True:\\n                idx = data.find(b'\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K', idx)\\n                if idx == -1:\\n                    break\\n                abs_pos = pos + idx\\n                print(f'  Exact offset: {abs_pos} (0x{abs_pos:x})')\\n                idx += len(b'\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K')\\n        pos += len(data)\\nEOF\\npython3 /tmp/find_wal.py\\n\"]\r\n\u001b[35m\u001b[K/logs/agent/recording.cast\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K[153.904265, \"o\", \"with open('/dev/vda', 'rb') as f:\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>     pos = 0\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>     chunk_size = 1024 * 1024\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>     while True:\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>         data = f.read(chunk_size)\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>         if not data:\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>             break\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>         if b'\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K' in data:\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>             print(f'Found \u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K around offset {pos}')\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>             idx = 0\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>             while True:\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>                 idx = data.find(b'\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K', idx)\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>                 if idx == -1:\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>                     break\\r\\n\\u001b[?2004l\\r\\u001b[?2004h>                 abs_pos = po"]
