K\u001b[35m\u001b[K/logs/agent/recording.cast\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K[153.900255, \"i\", \"cat << 'EOF' > /tmp/find_wal.py\\nwith open('/dev/vda', 'rb') as f:\\n    pos = 0\\n    chunk_size = 1024 * 1024\\n    while True:\\n        data = f.read(chunk_size)\\n        if not data:\\n            break\\n        if b'\u001b[01;31m\u001b[K\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K\u001b[m\u001b[K' in data:\\n            print(f'Found \u001b[01;31m\u001b[K\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K\u001b[m\u001b[K around offset {pos}')\\n            idx = 0\\n            while True:\\n                idx = data.find(b'\u001b[01;31m\u001b[K\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K\u001b[m\u001b[K', idx)\\n                if idx == -1:\\n                    break\\n                abs_pos = pos + idx\\n                print(f'  Exact offset: {abs_pos} (0x{abs_pos:x})')\\n                idx += len(b'\u001b[01;31m\u001b[K\u001b[01;31m\u001b[Kelderberry\u001b[m\u001b[K\u001b[m\u001b[K')\\n        pos += len(data)\\nEOF\\npython3 /tmp/find_wal.py\\n\"]\r\r\n"]
