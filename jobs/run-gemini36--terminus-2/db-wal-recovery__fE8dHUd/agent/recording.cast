[153.900255, "i", "cat << 'EOF' > /tmp/find_wal.py\nwith open('/dev/vda', 'rb') as f:\n    pos = 0\n    chunk_size = 1024 * 1024\n    while True:\n        data = f.read(chunk_size)\n        if not data:\n            break\n        if b'elderberry' in data:\n            print(f'Found elderberry around offset {pos}')\n            idx = 0\n            while True:\n                idx = data.find(b'elderberry', idx)\n                if idx == -1:\n                    break\n                abs_pos = pos + idx\n                print(f'  Exact offset: {abs_pos} (0x{abs_pos:x})')\n                idx += len(b'elderberry')\n        pos += len(data)\nEOF\npython3 /tmp/find_wal.py\n"]
[153.900689, "o", "cat << 'EOF' > /tmp/find_wal.py"]
