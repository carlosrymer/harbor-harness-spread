04l\r\u001b[?2004h> x3 = model.model.norm(x2)\r\n\u001b[?2004l\r\u001b[?2004h> logits = model.lm_head(x3)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Shift logits and labels for causal LM\r\n\u001b[?2004l\r\u001b[?2004h> shift_logits = logits[..., :-1, :].contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> shift_labels = targets[..., 1:].contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> loss_fn = torch.nn.CrossEntropyLoss()\r\n\u001b[?2004l\r\u001b[?2004h> loss_manual = loss_fn(shift_logits.view(-1, cfg.vocab_size), shift_labels.view(-1))\r\n\u001b[?2004l\r\u001b[?2004h> loss_manual.backward()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> grads_manual = {n: p.grad.clone() for n, p in model.named_parameters() if p.grad is not None}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Loss diff with shift:\", torch.abs(loss_std - loss_manual).item())\r\n\u001b[?2004l\r\u001b[?2004h> max_grad_diff = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> for n in grads_std:\r\n\u001b[?2004l\r\u001b[?2004h> "]
