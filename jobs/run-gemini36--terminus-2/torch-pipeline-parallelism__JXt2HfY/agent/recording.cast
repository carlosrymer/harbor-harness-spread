01b[?2004h> for n in grads_std:\r\n\u001b[?2004l\r\u001b[?2004h>     diff = torch.max(torch.abs(grads_std[n] - grads_manual[n])).item()\r\n\u001b[?2004l\r\u001b[?2004h>     if diff > max_grad_diff:\r\n\u001b[?2004l\r\u001b[?2004h>         max_grad_diff = diff\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Max grad diff:\", max_grad_diff)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
