[318.332007, "i", "cat << 'EOF' > /app/test_llama_forward.py\nimport torch\nfrom transformers import LlamaConfig, LlamaForCausalLM\n\ntorch.manual_seed(42)\ncfg = LlamaConfig(num_hidden_layers=4, hidden_size=16, intermediate_size=32, num_attention_heads=2, num_key_value_heads=2, vocab_size=100)\nmodel = LlamaForCausalLM(cfg)\ndevice = torch.device(\"cpu\")\ndtype = torch.float32\nmodel.to(device, dtype=dtype)\n\ninput_ids = torch.randint(0, 100, (2, 8), device=device)\ntargets = torch.randint(0, 100, (2, 8), device=device)\n\n# 1. Standard forward & backward\nmodel.zero_grad()\nout_std = model(input_ids=input_ids, labels=targets)\nloss_std = out_std.loss\nloss_std.backward()\ngrads_std = {n: p.grad.clone() for n, p in model.named_parameters() if p.grad is not None}\n\n# 2. Layer-by-layer forward & backward\nmodel.zero_grad()\nseq_len = input_ids.shape[1]\nposition_ids = torch.arange(0, seq_len, dtype=torch.long, device=device).unsqueeze(0)\n\n# Stage 0: Embed tokens\nx0 = model.model.embed_tokens(input_ids)\nposition_embeddings = model.model.rotary_emb(x0, position_ids)\n\n# Layers 0..1\nx1 = x0\nfor layer in model.model.layers[:2]:\n    res = layer(x1, position_ids=position_ids, position_embeddings=position_embeddings)\n    x1 = res[0] if isinstance(res, tuple) else res\n\n# Layers 2..3\nx2 = x1\nfor layer in model.model.layers[2:]:\n    res = layer(x2, position_ids=position_ids, position_embeddings=position_embeddings)\n    x2 = res[0] if isinstance(res, tuple) else res\n\nx3 = model.model.norm(x2)\nlogits = model.lm_head(x3)\n\n# Shift logits and labels for causal LM\nshift_logits = logits[..., :-1, :].contiguous()\nshift_labels = targets[..., 1:].contiguous()\nloss_fn = torch.nn.CrossEntropyLoss()\nloss_manual = loss_fn(shift_logits.view(-1, cfg.vocab_size), shift_labels.view(-1))\nloss_manual.backward()\n\ngrads_manual = {n: p.grad.clone() for n, p in model.named_parameters() if p.grad is not None}\n\nprint(\"Loss diff with shift:\", torch.abs(loss_std - loss_manual).item())\nmax_grad_diff = 0.0\nfor n in grads_std:\n    diff = torch.max(torch.abs(grads_std[n] - grads_manual[n])).item()\n    if diff > max_grad_diff:\n        max_grad_diff = diff\nprint(\"Max grad diff:\", max_grad_diff)\nEOF\npython3 /app/test_llama_forward.py\n"]
