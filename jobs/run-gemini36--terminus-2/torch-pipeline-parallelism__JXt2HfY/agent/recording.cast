[251.189904, "i", "cat << 'EOF' > /app/test_rotary.py\nimport torch\nfrom transformers import LlamaConfig, LlamaForCausalLM\n\ncfg = LlamaConfig(num_hidden_layers=4, hidden_size=16, intermediate_size=32, num_attention_heads=2, num_key_value_heads=2, vocab_size=100)\nmodel = LlamaForCausalLM(cfg)\n\ninput_ids = torch.randint(0, 100, (2, 8))\nseq_len = input_ids.shape[1]\nposition_ids = torch.arange(0, seq_len, dtype=torch.long, device=input_ids.device).unsqueeze(0)\n\nx = model.model.embed_tokens(input_ids)\nposition_embeddings = model.model.rotary_emb(x, position_ids)\nprint(\"position_embeddings:\", type(position_embeddings))\n\nfor i, layer in enumerate(model.model.layers):\n    res = layer(x, position_ids=position_ids, position_embeddings=position_embeddings)\n    x = res[0] if isinstance(res, tuple) else res\n\nx = model.model.norm(x)\nlogits = model.lm_head(x)\n\nout_std = model(input_ids=input_ids)\nprint(\"Logits diff:\", torch.max(torch.abs(logits - out_std.logits)).item())\nEOF\npython3 /app/test_rotary.py\n"]
