cat << 'EOF' > /app/test_dist.py
import os
import torch
import torch.distributed as dist
import torch.multiprocessing as mp

def run(rank, world_size):
    dist.init_process_group('gloo', init_method='tcp://127.0.0.1:29505', rank=rank, world_size=world_size)
    print(f"Rank {rank} initialized successfully", flush=True)
    dist.destroy_process_group()

if __name__ == '__main__':
    mp.spawn(run, args=(2,), nprocs=2, join=True)
