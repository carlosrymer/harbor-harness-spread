cat << 'EOF' > /app/test_step.py
import torch
from transformers import LlamaConfig, LlamaForCausalLM

torch.manual_seed(42)
cfg = LlamaConfig(num_hidden_layers=4, hidden_size=16, intermediate_size=32, num_attention_heads=2, num_key_value_heads=2, vocab_size=100)
model = LlamaForCausalLM(cfg)

input_ids = torch.randint(0, 100, (2, 8))
labels = torch.randint(0, 100, (2, 8))

# Standard forward
out_std = model(input_ids=input_ids, labels=labels)

# Manual step-by-step forward
# 1. Embed tokens
x = model.model.embed_tokens(input_ids)

# 2. Rotary embeddings / position ids / attention mask if needed
# Let's check what position_embeddings or position_ids or attention_mask are passed to layers
# In transformers, how are rotary_emb used or position_ids calculated?
print("embed_tokens shape:", x.shape)
for i, layer in enumerate(model.model.layers):
    # Let's try calling layer(x)
    try:
        res = layer(x)
        x = res[0] if isinstance(res, tuple) else res
    except Exception as e:
        print(f"Layer {i} failed:", e)
        break

x = model.model.norm(x)
logits = model.lm_head(x)
print("Logits diff:", torch.max(torch.abs(logits - out_std.logits)).item())
EOF
