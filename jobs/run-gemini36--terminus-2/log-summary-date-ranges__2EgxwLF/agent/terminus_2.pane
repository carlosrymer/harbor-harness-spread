[?2004l[?2004h> 
[?2004l[?2004h> REF_DATE = date(2025, 8, 12)
[?2004l[?2004h> 
[?2004l[?2004h> def is_today(d):
[?2004l[?2004h>     return d == REF_DATE
[?2004l[?2004h> 
[?2004l[?2004h> def is_last_7_days(d):
[?2004l[?2004h>     return (REF_DATE - timedelta(days=6)) <= d <= REF_DATE
[?2004l[?2004h> 
[?2004l[?2004h> def is_last_30_days(d):
[?2004l[?2004h>     return (REF_DATE - timedelta(days=29)) <= d <= REF_DATE
[?2004l[?2004h> 
[?2004l[?2004h> def is_month_to_date(d):
[?2004l[?2004h>     return date(REF_DATE.year, REF_DATE.month, 1) <= d <= REF_DATE
[?2004l[?2004h> 
[?2004l[?2004h> def is_total(d):
[?2004l[?2004h>     return True
[?2004l[?2004h> 
[?2004l[?2004h> periods = [
[?2004l[?2004h>     ('today', is_today),
[?2004l[?2004h>     ('last_7_days', is_last_7_days),
[?2004l[?2004h>     ('last_30_days', is_last_30_days),
[?2004l[?2004h>     ('month_to_date', is_month_to_date),
[?2004l[?2004h>     ('total', is_total),
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> severities = ['ERROR', 'WARNING', 'INFO']
[?2004l[?2004h> 
[?2004l[?2004h> counts = {p_name: {s: 0 for s in severities} for p_name, _ in periods}
[?2004l[?2004h> 
[?2004l[?2004h> log_dir = '/app/logs'
[?2004l[?2004h> for fname in os.listdir(log_dir):
[?2004l[?2004h>     if not fname.endswith('.log'):
[?2004l[?2004h>         continue
[?2004l[?2004h>     file_date_str = fname.split('_')[0]
[?2004l[?2004h>     try:
[?2004l[?2004h>         fdate = datetime.strptime(file_date_str, '%Y-%m-%d').date()
[?2004l[?2004h>     except ValueError:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     filepath = os.path.join(log_dir, fname)
[?2004l[?2004h>     with open(filepath, 'r', encoding='utf-8') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             m = re.search(r'\[(ERROR|WARNING|INFO)\]', line)
[?2004l[?2004h>             if m:
[?2004l[?2004h>                 sev = m.group(1)
[?2004l[?2004h>                 for p_name, p_filter in periods:
[?2004l[?2004h>                     if p_filter(fdate):
[?2004l[?2004h>                         counts[p_name][sev] += 1
[?2004l[?2004h> 
[?2004l[?2004h> output_file = '/app/summary.csv'
[?2004l[?2004h> with open(output_file, 'w', newline='', encoding='utf-8') as csvfile:
[?2004l[?2004h>     writer = csv.writer(csvfile)
