[40.093983, "i", "cat << 'EOF' > test_dates.py\nimport os\n\nlog_dir = '/app/logs'\nfiles = os.listdir(log_dir)\ndates = set()\nfor f in files:\n    if f.endswith('.log'):\n        dates.add(f.split('_')[0])\n\nsorted_dates = sorted(list(dates))\nprint('Min date:', sorted_dates[0])\nprint('Max date:', sorted_dates[-1])\nprint('All dates count:', len(sorted_dates))\nEOF\npython3 test_dates.py\nrm test_dates.py\n"]
