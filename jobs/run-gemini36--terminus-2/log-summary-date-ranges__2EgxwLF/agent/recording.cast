[22.358089, "i", "cat << 'EOF' > test_check.py\nimport os\n\nlog_dir = '/app/logs'\nfiles = os.listdir(log_dir)\nmismatched_dates = 0\ntotal_lines = 0\nfor f in files:\n    if not f.endswith('.log'): continue\n    file_date = f.split('_')[0]\n    with open(os.path.join(log_dir, f)) as fp:\n        for line in fp:\n            total_lines += 1\n            line_date = line[:10]\n            if line_date != file_date:\n                mismatched_dates += 1\nprint(f'Total lines: {total_lines}, Mismatched date lines: {mismatched_dates}')\nEOF\npython3 test_check.py\nrm test_check.py\n"]
