[31.456598, "i", "cat << 'EOF' > test_severity.py\nimport os, re\nfrom collections import Counter\n\nlog_dir = '/app/logs'\nfiles = os.listdir(log_dir)\nbracket_patterns = Counter()\n\nfor f in files:\n    if not f.endswith('.log'): continue\n    with open(os.path.join(log_dir, f)) as fp:\n        for line in fp:\n            b = re.search(r'\\[([^\\]]+)\\]', line)\n            if b:\n                bracket_patterns[b.group(1)] += 1\n\nprint('Bracket occurrences:', bracket_patterns)\nEOF\npython3 test_severity.py\nrm test_severity.py\n"]
