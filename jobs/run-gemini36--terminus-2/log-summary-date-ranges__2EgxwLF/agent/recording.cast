[54.422654, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> def is_today(d):\r\n\u001b[?2004l\r\u001b[?2004h>     return d == REF_DATE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def is_last_7_days(d):\r\n\u001b[?2004l\r"]
[54.422855, "o", "\u001b[?2004h"]
[54.423073, "o", "> "]
[54.423612, "o", "    return (REF_DATE - timedelta(days=6)) <= d <= REF_DATE"]
[54.423821, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.423909, "o", "> \r\n\u001b[?2004l\r"]
[54.423917, "o", "\u001b[?2004h"]
[54.424162, "o", "> def is_last_30_days(d):\r\n\u001b[?2004l\r"]
[54.424177, "o", "\u001b[?2004h"]
[54.424193, "o", "> "]
[54.42431, "o", "    return (REF_DATE - timedelta(days=29)) <= d <= REF_DATE"]
[54.424457, "o", "\r\n"]
[54.42451, "o", "\u001b[?2004l\r"]
[54.424602, "o", "\u001b[?2004h> "]
[54.424704, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.424756, "o", "> "]
[54.424827, "o", "def is_month_to_date(d):"]
[54.425073, "o", "\r\n\u001b[?2004l\r"]
[54.42529, "o", "\u001b[?2004h> "]
[54.425461, "o", "    return date(REF_DATE.year, REF_DATE.month, 1) <= d <= REF_DATE\r\n"]
[54.425515, "o", "\u001b[?2004l\r"]
[54.425564, "o", "\u001b[?2004h"]
[54.425764, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.425958, "o", "> "]
[54.426148, "o", "def is_total(d):"]
[54.426236, "o", "\r\n\u001b[?2004l\r"]
[54.426248, "o", "\u001b[?2004h"]
[54.42636, "o", "> "]
[54.42664, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.426677, "o", "> "]
[54.426793, "o", "\r\n"]
[54.427253, "o", "\u001b[?2004l\r\u001b[?2004h"]
[54.427284, "o", "> periods = [\r\n\u001b[?2004l\r\u001b[?2004h>     ('today', is_today),"]
[54.427315, "o", "\r\n"]
[54.427348, "o", "\u001b[?2004l\r"]
[54.427419, "o", "\u001b[?2004h"]
[54.427634, "o", ">     ('last_7_days', is_last_7_days),"]
[54.428175, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     ('last_30_days', is_last_30_days),\r\n\u001b[?2004l\r\u001b[?2004h>     ('month_to_date', is_month_to_date),\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.429897, "o", "> "]
[54.429961, "o", "    ('total', is_total),\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> severities = ['ERROR', 'WARNING', 'INFO']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> counts = {p_name: {s: 0 for s in severities} for p_name, _ in periods}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> log_dir = '/app/logs'\r\n\u001b[?2004l\r\u001b[?2004h> for fname in os.listdir(log_dir):\r\n\u001b[?2004l\r\u001b[?2004h>     if not fname.endswith('.log'):\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     file_date_str = fname.split('_')[0]\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.430322, "o", "        fdate = datetime.strptime(file_date_str, '%Y-%m-%d').date()\r\n\u001b[?2004l\r"]
[54.430768, "o", "\u001b[?2004h>     except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.430926, "o", ">     \r\n\u001b[?2004l\r"]
[54.431154, "o", "\u001b[?2004h> "]
[54.431285, "o", "    filepath = os.path.join(log_dir, fname)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.431546, "o", "    with open(filepath, 'r', encoding='utf-8') as f:\r\n"]
[54.43176, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[54.431821, "o", "        for line in f:\r\n"]
[54.431901, "o", "\u001b[?2004l\r"]
[54.432122, "o", "\u001b[?2004h> "]
[54.432332, "o", "            m = re.search(r'\\[(ERROR|WARNING|INFO)\\]', line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.432403, "o", "> "]
[54.432685, "o", "            if m:\r\n\u001b[?2004l\r\u001b[?2004h>                 sev = m.group(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.432742, "o", "> "]
[54.432958, "o", "                for p_name, p_filter in periods:\r\n\u001b[?2004l\r"]
[54.433101, "o", "\u001b[?2004h> "]
[54.433232, "o", "                    if p_filter(fdate):\r\n\u001b[?2004l\r"]
[54.433329, "o", "\u001b[?2004h> "]
[54.434624, "o", "                        counts[p_name][sev] += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> output_file = '/app/summary.csv'\r\n\u001b[?2004l\r\u001b[?2004h> with open(output_file, 'w', newline='', encoding='utf-8') as csvfile:\r\n\u001b[?2004l\r\u001b[?2004h>     writer = csv.writer(csvfile)\r\n\u001b[?2004l\r\u001b[?2004h>     writer.writerow(['period', 'severity', 'count'])\r\n\u001b[?2004l\r\u001b[?2004h>     for p_name, _ in periods:\r\n\u001b[?2004l\r\u001b[?2004h>         for sev in severities:\r\n\u001b[?2004l\r\u001b[?2004h>             writer.writerow([p_name, sev, counts[p_name][sev]])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Summary generated successfully:')\r\n\u001b[?2004l\r\u001b[?2004h> with open(output_file, 'r') as csvfile:\r\n\u001b[?2004l\r\u001b[?2004h>     print(csvfile.read())\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
