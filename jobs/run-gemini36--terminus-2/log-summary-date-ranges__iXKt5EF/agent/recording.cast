[20.260475, "i", "cat << 'EOF' > /tmp/analyze.py\nimport glob, os, re\n\nlog_files = glob.glob('/app/logs/*.log')\nprint(f'Total log files: {len(log_files)}')\n\nseverities = set()\nfile_date_mismatch = 0\n\nfor f in log_files:\n    fname = os.path.basename(f)\n    fdate_str = fname.split('_')[0]\n    with open(f) as fp:\n        for line in fp:\n            m = re.search(r'\\[([A-Z]+)\\]', line)\n            if m:\n                severities.add(m.group(1))\n            ldate_str = line[:10]\n            if ldate_str != fdate_str:\n                file_date_mismatch += 1\n\nprint('Severities found:', severities)\nprint('Line date vs file date mismatches:', file_date_mismatch)\nEOF\npython3 /tmp/analyze.py\n"]
[20.260712, "o", "cat << 'EOF' > /tmp/analyze.py"]
[20.260732, "o", "\r\n"]
