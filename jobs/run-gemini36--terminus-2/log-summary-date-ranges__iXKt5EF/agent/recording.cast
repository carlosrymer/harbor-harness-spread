[33.002614, "i", "cat << 'EOF' > /tmp/process.py\nimport glob, os, re, datetime\n\nref_date = datetime.date(2025, 8, 12)\n\ntoday_date = ref_date\nlast_7_start = ref_date - datetime.timedelta(days=6)\nlast_30_start = ref_date - datetime.timedelta(days=29)\nmonth_to_date_start = datetime.date(ref_date.year, ref_date.month, 1)\n\nprint(\"Today:\", today_date)\nprint(\"Last 7 days:\", last_7_start, \"to\", ref_date)\nprint(\"Last 30 days:\", last_30_start, \"to\", ref_date)\nprint(\"Month to date:\", month_to_date_start, \"to\", ref_date)\n\nperiods = ['today', 'last_7_days', 'last_30_days', 'month_to_date', 'total']\nseverities = ['ERROR', 'WARNING', 'INFO']\n\ncounts = {p: {s: 0 for s in severities} for p in periods}\n\nlog_files = glob.glob('/app/logs/*.log')\n\nfor f in log_files:\n    fname = os.path.basename(f)\n    fdate_str = fname.split('_')[0]\n    try:\n        fdate = datetime.datetime.strptime(fdate_str, '%Y-%m-%d').date()\n    except ValueError:\n        continue\n    \n    with open(f, 'r', encoding='utf-8', errors='ignore') as fp:\n        for line in fp:\n  "]
[33.002755, "i", "          m = re.search(r'\\[(ERROR|WARNING|INFO)\\]', line)\n            if not m:\n                continue\n            sev = m.group(1)\n            \n            counts['total'][sev] += 1\n            \n            if fdate == today_date:\n                counts['today'][sev] += 1\n            if last_7_start <= fdate <= ref_date:\n                counts['last_7_days'][sev] += 1\n            if last_30_start <= fdate <= ref_date:\n                counts['last_30_days'][sev] += 1\n            if month_to_date_start <= fdate <= ref_date:\n                counts['month_to_date'][sev] += 1\n\noutput_lines = ['period,severity,count']\nfor p in periods:\n    for s in severities:\n        output_lines.append(f\"{p},{s},{counts[p][s]}\")\n\ncsv_content = '\\n'.join(output_lines) + '\\n'\nprint('\\nGenerated CSV:')\nprint(csv_content)\n\nwith open('/app/summary.csv', 'w') as f:\n    f.write(csv_content)\n\nprint(\"Saved to /app/summary.csv\")\nEOF\npython3 /tmp/process.py\n"]
