[143.892978, "i", "cat << 'EOF' > inspect.c\n#include <stdio.h>\n#include <stdlib.h>\n\nint main() {\n    FILE *f = fopen(\"gpt2-124M.ckpt\", \"rb\");\n    if (!f) { perror(\"fopen\"); return 1; }\n    float buf[10];\n    if (fread(buf, sizeof(float), 10, f) == 10) {\n        for (int i = 0; i < 10; i++) printf(\"%f \", buf[i]);\n        printf(\"\\n\");\n    }\n    fclose(f);\n    return 0;\n}\nEOF\ngcc inspect.c -o inspect && ./inspect\n"]
