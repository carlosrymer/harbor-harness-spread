[53.086498, "i", "python3 -c \"\nimport struct\n\ndef read_floats(f, count):\n    return struct.unpack(f'{count}f', f.read(count * 4))\n\nwith open('gpt2-124M.ckpt', 'rb') as f:\n    # Tensor 0: wte (50257 * 768 = 38597376 floats)\n    f.seek(0)\n    wte0 = read_floats(f, 10)\n    print('wte start:', wte0)\n    \n    # After wte is wpe (1024 * 768 = 786432 floats)\n    f.seek((38597376) * 4)\n    wpe0 = read_floats(f, 10)\n    print('wpe start:', wpe0)\n    \n    # After wpe (offset 39383808), block 0 ln_1 weight (768 floats)\n    f.seek((38597376 + 786432) * 4)\n    ln1_g = read_floats(f, 10)\n    ln1_b = read_floats(f, 10)\n    print('ln1_g (expected ~1):', ln1_g[:5])\n    print('ln1_b (expected ~0):', ln1_b[:5])\n\"\n"]
