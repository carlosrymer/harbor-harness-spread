[202.299706, "i", "python3 -c \"\nimport struct\n\n# Let's list the expected TF variable order:\n# Root level:\n# 1. model/ln_f/b: [768]\n# 2. model/ln_f/g: [768]\n# 3. model/wpe: [1024, 768]\n# 4. model/wte: [50257, 768]\n# OR model/h0..h11, model/ln_f, model/wpe, model/wte?\n# Let's test the root variable order vs block variable order!\n\n# In TF v1 checkpoint, all variables in the entire model are sorted ALPHABETICALLY by their full tensor name!\n# Full tensor names in TF GPT-2:\n# model/h0/attn/c_attn/b (2304)\n# model/h0/attn/c_attn/w (768*2304)\n# model/h0/attn/c_proj/b (768)\n# model/h0/attn/c_proj/w (768*768)\n# model/h0/ln_1/b (768)\n# model/h0/ln_1/g (768)\n# model/h0/ln_2/b (768)\n# model/h0/ln_2/g (768)\n# model/h0/mlp/c_fc/b (3072)\n# model/h0/mlp/c_fc/w (768*3072)\n# model/h0/mlp/c_proj/b (768)\n# model/h0/mlp/c_proj/w (3072*768)\n# ...\n# model/h11/...\n# model/ln_f/b (768)\n# model/ln_f/g (768)\n# model/wpe (1024*768)\n# model/wte (50257*768)\n\n# WAIT! Where are wte and wpe? \n# 'model/h0' comes BEFORE 'model/ln_f', 'model/wpe', 'model/wte' alphabetically!\n# Alphabetical order:\n# model/h0/...\n# model/h1/...\n# ...\n# model/h10/...\n# model/h11/...\n# model/h2/...\n# WAIT! Standard alphabetical string sorting vs h0..h11!\nprint('Let's test string sort of TF tensor names')\n\"\n"]
