[207.701797, "i", "python3 -c \"\nimport struct\n\nwith open('gpt2-124M.ckpt', 'rb') as f:\n    # Offset 0: wte (38597376)\n    # Offset 38597376: wpe (786432)\n    # Offset 39383808: block 0\n    # Each block has 12 tensors in alphabetical order within block:\n    # 1. attn/c_attn/b: 2304\n    # 2. attn/c_attn/w: 1769472\n    # 3. attn/c_proj/b: 768\n    # 4. attn/c_proj/w: 589824\n    # 5. ln_1/b: 768\n    # 6. ln_1/g: 768\n    # 7. ln_2/b: 768\n    # 8. ln_2/g: 768\n    # 9. mlp/c_fc/b: 3072\n    # 10. mlp/c_fc/w: 2359296\n    # 11. mlp/c_proj/b: 768\n    # 12. mlp/c_proj/w: 2360064 - wait, c_proj/w is 3072*768 = 2359296\n    block_len = 2304 + 1769472 + 768 + 589824 + 768 + 768 + 768 + 768 + 3072 + 2359296 + 768 + 2359296\n    print('Block len:', block_len) # Should be 7087872\n    print('12 blocks len:', 12 * block_len)\n    print('wte + wpe + 12*block:', 39383808 + 12 * block_len)\n    print('Remaining floats:', 124439808 - (39383808 + 12 * block_len))\n\"\n"]
