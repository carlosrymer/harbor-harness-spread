= -0.2518 max=  0.1976\r\nL1.ln_2.g                 count=768        mean= -0.0005 std=  0.0830 min= -0.3406 max=  0.3198\r\nL1.ln_2.b                 count=768        mean= -0.0001 std=  0.0794 min= -0.3014 max=  0.3219\r\nL1.mlp_c_fc.w             count=2359296    mean= -0.0000 std=  0.1170 min= -2.3135 max=  4.0140\r\nL1.mlp_c_fc.b             count=3072       mean= -0.0004 std=  0.1338 min= -0.5920 max=  0.4601\r\nL1.mlp_c_proj.w           count=2359296    mean= -0.0032 std=  0.1197 min= -1.9833 max=  1.7617\r\nL1.mlp_c_proj.b           count=768        mean= -0.0245 std=  0.1209 min= -0.4990 max=  0.3284\r\nL2.ln_1.g                 count=768        mean= -0.0157 std=  0.1273 min= -0.5073 max=  0.3444\r\nL2.ln_1.b                 count=768        mean= -0.0157 std=  0.1292 min= -0.3832 max=  0.3741\r\nL2.attn_c_attn.w          count=1769472    mean= -0.0011 std=  0.1119 min= -2.1041 max=  2.7329\r\n"]
