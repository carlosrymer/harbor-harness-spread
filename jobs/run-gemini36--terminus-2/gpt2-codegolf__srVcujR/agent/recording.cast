[196.533261, "i", "python3 -c \"\nimport struct\n# Check if offset 39383808 starts with attn/c_attn/b (2304 floats)\nwith open('gpt2-124M.ckpt', 'rb') as f:\n    f.seek((39383808) * 4)\n    # Read 2304 floats (c_attn bias)\n    c_attn_b = struct.unpack('2304f', f.read(2304 * 4))\n    # c_attn bias in GPT-2 has 3 parts: q_bias (768), k_bias (768), v_bias (768)\n    print('c_attn_b mean:', sum(c_attn_b)/2304)\n    # After c_attn/b (2304) is c_attn/w (768 * 2304 = 1769472 floats)\n    c_attn_w_first = struct.unpack('10f', f.read(40))\n    print('c_attn_w_first:', c_attn_w_first)\n\"\n"]
