[159.152418, "i", "cat << 'EOF' > inspect_layout.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/mman.h>\n#include <sys/stat.h>\n#include <fcntl.h>\n#include <unistd.h>\n#include <math.h>\n\nvoid print_stats(const char* name, const float* ptr, size_t n) {\n    double sum = 0, sq_sum = 0;\n    float min_val = ptr[0], max_val = ptr[0];\n    for (size_t i = 0; i < n; i++) {\n        float v = ptr[i];\n        sum += v;\n        sq_sum += v * v;\n        if (v < min_val) min_val = v;\n        if (v > max_val) max_val = v;\n    }\n    double mean = sum / n;\n    double var = (sq_sum / n) - (mean * mean);\n    printf(\"%-25s count=%-10zu mean=%8.4f std=%8.4f min=%8.4f max=%8.4f\\n\",\n           name, n, mean, sqrt(var > 0 ? var : 0), min_val, max_val);\n}\n\nint main() {\n    int fd = open(\"gpt2-124M.ckpt\", O_RDONLY);\n    if (fd < 0) { perror(\"open\"); return 1; }\n    struct stat st;\n    fstat(fd, &st);\n    size_t num_floats = st.st_size / sizeof(float);\n    float* w = mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);\n    if (w == MAP_FAILED) { perror(\"mmap\"); return 1; }\n    printf(\"Mapped %zu floats\\n\", num_floats);\n\n    // Test Layout 1: Karpathy / standard export order\n    // wte (50257*768), wpe (1024*768),\n    // then 12 blocks: ln_1.g(768), ln_1.b(768), attn.c_attn.w(768*2304), attn.c_attn.b(2304),\n    // attn.c_proj.w(768*768), attn.c_proj.b(768), ln_2.g(768), ln_2.b(768),\n    // mlp.c_fc.w(768*3072), mlp.c_fc.b(3072), mlp.c_proj.w(3072*768), mlp.c_proj.b(768)\n    // finally ln_f.g(768), ln_f.b(768)\n    \n    size_t off = 0;\n    print_stats(\"wte\", w + off, 50257 * 768); off += 50257 * 768;\n    print_stats(\"wpe\", w + off, 1024 * 768); off += 1024 * 768;\n    \n    for (int l = 0; l < 12; l++) {\n        char label[64];\n        snprintf(label, sizeof(label), \"L%d.ln_1.g\", l);\n        print_stats(label, w + off, 768); off += 768;\n        snprintf(label, sizeof(label), \"L%d.ln_1.b\", l);\n        print_stats(label, w + off, 768); off += 768;\n        snprintf(label, sizeof(label), \"L%d.attn_c_attn.w\", l);\n        print_stats(label, w + off, 768 * 2304); off += 768 * 2304;\n        snprintf(label, sizeof(label), \"L%d.attn_c_attn.b\", l);\n        print_stats(label, w + off, 2304); off += 2304;\n        snprintf(label, sizeof(label), \"L%d.attn_c_proj.w\", l);\n        print_stats(label, w + off, 768 * 768); off += 768 * 768;\n        snprintf(label, sizeof(label), \"L%d.attn_c_proj.b\", l);\n        print_stats(label, w + off, 768); off += 768;\n        snprintf(label, sizeof(label), \"L%d.ln_2.g\", l);\n        print_stats(label, w + off, 768); off += 768;\n        snprintf(label, sizeof(label), \"L%d.ln_2.b\", l);\n        print_stats(label, w + off, 768); off += 768;\n        snprintf(label, sizeof(label), \"L%d.mlp_c_fc.w\", l);\n        print_stats(label, w + off, 768 * 3072); off += 768 * 3072;\n        snprintf(label, sizeof(label), \"L%d.mlp_c_fc.b\", l);\n        print_stats(label, w + off, 3072); off += 3072;\n        snprintf(label, sizeof(label), \"L%d.mlp_c_proj.w\", l);\n        print_stats(label, w + off, 3072 * 768); off += 3072 * 768;\n        snprintf(label, sizeof(label), \"L%d.mlp_c_proj.b\", l);\n        print_stats(label, w + off, 768); off += 768;\n    }\n    print_stats(\"ln_f.g\", w + off, 768); off += 768;\n    print_stats(\"ln_f.b\", w + off, 768); off += 768;\n    printf(\"Total off=%zu, expected=%zu\\n\", off, num_floats);\n\n    munmap(w, st.st_size);\n    close(fd);\n    return 0;\n}\nEOF\ngcc inspect_layout.c -o inspect_layout -lm && ./inspect_layout | head -n 30\n"]
[159.152723, "o", "cat << 'EOF' > inspect_layout.c"]
[159.155204, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/mman.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/stat.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <fcntl.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <unistd.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <math.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void print_stats(const char* name, const float* ptr, size_t n) {\r\n\u001b[?2004l\r\u001b[?2004h>     double sum = 0, sq_sum = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     float min_val = ptr[0], max_val = ptr[0];\r\n\u001b[?2004l\r\u001b[?2004h>     for (size_t i = 0; i < n; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         float v = ptr[i];\r\n\u001b[?2004l\r\u001b[?2004h>         sum += v;\r\n\u001b[?2004l\r\u001b[?2004h>         sq_sum += v * v;\r\n\u001b[?2004l\r\u001b[?2004h> "]
