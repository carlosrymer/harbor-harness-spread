[106.856123, "i", "python3 -c \"\nimport struct\n# Let's inspect the exact list of variables in standard TF GPT-2 model (model/wte, model/wpe, model/h0/ln_1/g, model/h0/ln_1/b, ...)\n# Let's print min/max/mean of the first few 100k float blocks to understand data ranges across the file.\nwith open('gpt2-124M.ckpt', 'rb') as f:\n    data = f.read()\nfloats = struct.unpack(f'{len(data)//4}f', data)\n\nstep = 1000000\nfor i in range(0, len(floats), step):\n    chunk = floats[i:i+step]\n    print(f'Offset {i:9d}: min={min(chunk):8.3f}, max={max(chunk):8.3f}, mean={sum(chunk)/len(chunk):8.4f}')\n\"\n"]
[106.856551, "o", "python3 -c \"\r\nimport struct\r\n# Let's inspect the exact list of variables in standard TF GPT-2 model (model/wte, model/wpe, model/h0/ln_1/g, model/h0/ln_1/b, ...)\r\n# Let's print min/max/mean of the first few 100k float blocks to understand data ranges across the file.\r\nwith open('gpt2-124M.ckpt', 'rb') as f:\r\n    data = f.read()\r\nfloats = struct.unpack(f'{len(data)//4}f', data)\r\n\r\nstep = 1000000\r\nfor i in range(0, len(floats), step):\r\n    chunk = floats[i:i+step]\r\n    print(f'Offset {i:9d}: min={min(chunk):8.3f}, max={max(chunk):8.3f}, mean={sum(chunk)/len(chunk):8.4f}')\r\n\"\r\n"]
