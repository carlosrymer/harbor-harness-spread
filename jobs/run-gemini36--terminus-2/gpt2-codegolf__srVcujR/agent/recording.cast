[69.244998, "i", "python3 -c \"\nimport struct\n# Let's inspect TF GPT-2 checkpoint default export order.\n# Standard TF v1 checkpoint order of keys or standard dump order.\n# Let's search for positional embedding wpe (1024, 768).\n# Row 0 of wpe: position 0 embedding.\n# Let's check if wpe is at offset 0, or if wte is at the end, or if bias vectors exist.\nwith open('gpt2-124M.ckpt', 'rb') as f:\n    data = f.read(1000 * 4)\n    floats = struct.unpack('1000f', data)\n    print('First 20 floats:', floats[:20])\n\"\n"]
[69.245363, "o", "python3 -c \"\r\nimport struct\r\n# Let's inspect TF GPT-2 checkpoint default export order.\r\n# Standard TF v1 checkpoint order of keys or standard dump order.\r\n# Let's search for positional embedding wpe (1024, 768).\r\n# Row 0 of wpe: position 0 embedding.\r\n# Let's check if wpe is at offset 0, or if wte is at the end, or if bias vectors exist.\r\nwith open('gpt2-124M.ckpt', 'rb') as f:\r\n    data = f.read(1000 * 4)\r\n    floats = struct.unpack('1000f', data)\r\n    print('First 20 floats:', floats[:20])\r\n\"\r\n"]
