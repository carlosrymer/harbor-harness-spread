[159.167356, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.167896, "o", "\u001b[?2004h> int main() {\r\n\u001b[?2004l\r\u001b[?2004h>     int fd = open(\"gpt2-124M.ckpt\", O_RDONLY);\r\n\u001b[?2004l\r\u001b[?2004h>     if (fd < 0) { perror(\"open\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     struct stat st;\r\n\u001b[?2004l\r\u001b[?2004h>     fstat(fd, &st);\r\n\u001b[?2004l\r\u001b[?2004h>     size_t num_floats = st.st_size / sizeof(float);\r\n\u001b[?2004l\r\u001b[?2004h>     float* w = mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);\r\n\u001b[?2004l\r\u001b[?2004h>     if (w == MAP_FAILED) { perror(\"mmap\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"Mapped %zu floats\\n\", num_floats);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     // Test Layout 1: Karpathy / standard export order\r\n\u001b[?2004l\r\u001b[?2004h>     // wte (50257*768), wpe (1024*768),\r\n\u001b[?2004l\r\u001b[?2004h>     // then 12 blocks: ln_1.g(768), ln_1.b(768), attn.c_attn.w(768*2304), attn.c_attn.b(2304),\r\n\u001b[?2004l\r\u001b[?2004h>     // attn.c_proj.w(768*768), attn.c_proj.b(768), ln_2.g(768), ln_2.b(768),\r\n\u001b[?2004l\r\u001b[?2004h>     // mlp.c_fc.w(768*3072), mlp.c_fc.b(3072), mlp.c_proj.w(3072*768), mlp.c_proj.b(768)\r\n\u001b[?2004l\r\u001b[?2004h>     // finally ln_f.g(768), ln_f.b(768)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     size_t off = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     print_stats(\"wte\", w + off, 50257 * 768); off += 50257 * 768;\r\n\u001b[?2004l\r\u001b[?2004h>     print_stats(\"wpe\", w + off, 1024 * 768); off += 1024 * 768;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for (int l = 0; l < 12; l++) {\r\n\u001b[?2004l\r\u001b[?2004h>         char label[64];\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.ln_1.g\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768); off += 768;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.ln_1.b\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768); off += 768;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.attn_c_attn.w\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768 * 2304); off += 768 * 2304;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.attn_c_attn.b\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 2304); off += 2304;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.attn_c_proj.w\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768 * 768); off += 768 * 768;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.attn_c_proj.b\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768); off += 768;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.ln_2.g\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768); off += 768;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.ln_2.b\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768); off += 768;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.mlp_c_fc.w\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768 * 3072); off += 768 * 3072;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.mlp_c_fc.b\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 3072); off += 3072;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.169375, "o", "        snprintf(label, sizeof(label), \"L%d.mlp_c_proj.w\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 3072 * 768); off += 3072 * 768;\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(label, sizeof(label), \"L%d.mlp_c_proj.b\", l);\r\n\u001b[?2004l\r\u001b[?2004h>         print_stats(label, w + off, 768); off += 768;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     print_stats(\"ln_f.g\", w + off, 768); off += 768;\r\n\u001b[?2004l\r\u001b[?2004h>     print_stats(\"ln_f.b\", w + off, 768); off += 768;\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"Total off=%zu, expected=%zu\\n\", off, num_floats);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     munmap(w, st.st_size);\r\n\u001b[?2004l\r\u001b[?2004h>     close(fd);\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
