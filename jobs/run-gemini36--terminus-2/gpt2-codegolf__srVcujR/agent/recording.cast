[61.643338, "i", "python3 -c \"import struct; f = open('gpt2-124M.ckpt', 'rb'); [print(f'Chunk {i} at offset {i*768}: mean={sum(vals)/768:.3f}') for i in range(124439808 // 768) for vals in [struct.unpack('768f', f.read(768*4))] if 0.8 < sum(vals)/768 < 1.2 and sum((x - sum(vals)/768)**2 for x in vals)/768 < 0.1]; f.close()\"\n"]
