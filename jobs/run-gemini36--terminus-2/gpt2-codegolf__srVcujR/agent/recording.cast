[165.801577, "i", "cat << 'EOF' > find_ln.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/mman.h>\n#include <sys/stat.h>\n#include <fcntl.h>\n#include <unistd.h>\n#include <math.h>\n\nint main() {\n    int fd = open(\"gpt2-124M.ckpt\", O_RDONLY);\n    struct stat st;\n    fstat(fd, &st);\n    size_t num_floats = st.st_size / sizeof(float);\n    float* w = mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);\n\n    for (size_t i = 0; i < num_floats - 768; i += 4) { // check every 4 floats\n        double sum = 0;\n        for (int k = 0; k < 768; k++) sum += w[i+k];\n        double mean = sum / 768;\n        if (mean > 0.7 && mean < 1.3) {\n            double var = 0;\n            for (int k = 0; k < 768; k++) {\n                double d = w[i+k] - mean;\n                var += d * d;\n            }\n            var /= 768;\n            if (var < 0.2) {\n                printf(\"Found candidate LN g at float offset %zu (%zu bytes): mean=%.3f, std=%.3f, first5=[%.2f, %.2f, %.2f, %.2f, %.2f]\\n\",\n                       i, i*4, mean, sqrt(var), w[i], w[i+1], w[i+2], w[i+3], w[i+4]);\n            }\n        }\n    }\n    munmap(w, st.st_size);\n    close(fd);\n    return 0;\n}\nEOF\ngcc find_ln.c -o find_ln -lm && ./find_ln | head -n 30\n"]
[165.802743, "o", "cat << 'EOF' > find_ln.c\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/mman.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/stat.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <fcntl.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <unistd.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <math.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main() {\r\n\u001b[?2004l\r\u001b[?2004h>     int fd = open(\"gpt2-124M.ckpt\", O_RDONLY);\r\n\u001b[?2004l\r\u001b[?2004h>     struct stat st;\r\n\u001b[?2004l\r\u001b[?2004h>     fstat(fd, &st);\r\n\u001b[?2004l\r\u001b[?2004h>     size_t num_floats = st.st_size / sizeof(float);\r\n\u001b[?2004l\r\u001b[?2004h>     float* w = mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
