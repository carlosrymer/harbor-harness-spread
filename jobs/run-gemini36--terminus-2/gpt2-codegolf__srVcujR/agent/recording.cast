[174.347176, "i", "python3 -c \"\n# Let's check TF variable order if TF is installed, or construct the TF key list\n# Standard TF GPT-2 124M variables in model/:\n# model/wte: [50257, 768] (38597376)\n# model/wpe: [1024, 768] (786432)\n# model/h0/attn/c_attn/w: [1, 768, 2304] (1769472)\n# model/h0/attn/c_attn/b: [2304]\n# model/h0/attn/c_proj/w: [1, 768, 768] (589824)\n# model/h0/attn/c_proj/b: [768]\n# model/h0/ln_1/g: [768]\n# model/h0/ln_1/b: [768]\n# model/h0/ln_2/g: [768]\n# model/h0/ln_2/b: [768]\n# model/h0/mlp/c_fc/w: [1, 768, 3072] (2359296)\n# model/h0/mlp/c_fc/b: [3072]\n# model/h0/mlp/c_proj/w: [1, 3072, 768] (2359296)\n# model/h0/mlp/c_proj/b: [768]\n# ...\n# model/ln_f/g: [768]\n# model/ln_f/b: [768]\n# Notice in TF, c_attn/b, c_attn/w, c_proj/b, c_proj/w, ln_1/b, ln_1/g, ln_2/b, ln_2/g, mlp/c_fc/b, mlp/c_fc/w, mlp/c_proj/b, mlp/c_proj/w!\n# Alphabetical order per layer h0:\n# 1. attn/c_attn/b (2304)\n# 2. attn/c_attn/w (1769472)\n# 3. attn/c_proj/b (768)\n# 4. attn/c_proj/w (589824)\n# 5. ln_1/b (768)\n# 6. ln_1/g (768)\n# 7. ln_2/b (768)\n# 8. ln_2/g (768)\n# 9. mlp/c_fc/b (3072)\n# 10. mlp/c_fc/w (2359296)\n# 11. mlp/c_proj/b (768)\n# 12. mlp/c_proj/w (2359296)\nprint('Alphabetical idea listed')\n\"\n"]
[174.347701, "o", "python3 -c \"\r\n# Let's check TF variable order if TF is installed, or construct the TF key list\r\n# Standard TF GPT-2 124M variables in model/:\r\n# model/wte: [50257, 768] (38597376)\r\n# model/wpe: [1024, 768] (786432)\r\n# model/h0/attn/c_attn/w: [1, 768, 2304] (1769472)\r\n# model/h0/attn/c_attn/b: [2304]\r\n# model/h0/attn/c_proj/w: [1, 768, 768] (589824)\r\n# model/h0/attn/c_proj/b: [768]\r\n# model/h0/ln_1/g: [768]\r\n# model/h0/ln_1/b: [768]\r\n# model/h0/ln_2/g: [768]\r\n# model/h0/ln_2/b: [768]\r\n# model/h0/mlp/c_fc/w: [1, 768, 3072] (2359296)\r\n# model/h0/mlp/c_fc/b: [3072]\r\n# model/h0/mlp/c_proj/w: [1, 3072, 768] (2359296)\r\n# model/h0/mlp/c_proj/b: [768]\r\n# ...\r\n# model/ln_f/g: [768]\r\n# model/ln_f/b: [768]\r\n# Notice in TF, c_attn/b, c_attn/w, c_proj/b, c_proj/w, ln_1/b, ln_1/g, ln_2/b, ln_2/g, mlp/c_fc/b, mlp/c_fc/w, mlp/c_proj/b, mlp/c_proj/w!\r\n# Alphabetical order per layer h0:\r\n# 1. attn/c_attn/b (2304)\r\n# 2. attn/c_attn/w (1769472)\r\n# 3. attn/c_proj/b (768)\r\n# 4. attn/c_proj/w (589824)\r\n# 5. ln_1/b (768)\r\n# 6. ln_1/g (768)\r\n# 7. ln_2/b (768)\r\n# 8. ln_2/g (768)\r\n# 9. mlp/c_fc/b (3072)\r\n# 10. mlp/c_fc/w (2359296)\r\n# 11. mlp/c_proj/b (768)\r\n# 12. mlp/c_proj/w (2359296)\r\nprint('Alphabetical idea listed')\r\n\"\r\n"]
[176.971457, "i", "python3 -c \"import tensorflow as tf; print(tf.__version__)\" 2>/dev/null || echo \"No TF\"\n"]
[176.975394, "o", "python3 -c \"import tensorflow as tf; print(tf.__version__)\" 2>/dev/null || echo \"No TF\"\r\n"]
[180.53769, "i", "python3 -c \"\nimport struct\nwith open('gpt2-124M.ckpt', 'rb') as f:\n    data = f.read(10 * 768 * 4)\n    floats = struct.unpack(f'{10*768}f', data)\n    print('Token 0 norm:', sum(x*x for x in floats[:768])**0.5)\n    print('Token 1 norm:', sum(x*x for x in floats[768:1536])**0.5)\n\"\n"]
[180.539493, "o", "python3 -c \"\r\nimport struct\r\nwith open('gpt2-124M.ckpt', 'rb') as f:\r\n    data = f.read(10 * 768 * 4)\r\n    floats = struct.unpack(f'{10*768}f', data)\r\n    print('Token 0 norm:', sum(x*x for x in floats[:768])**0.5)\r\n    print('Token 1 norm:', sum(x*x for x in floats[768:1536])**0.5)\r\n\"\r\n"]
