import struct
# Let's inspect the exact list of variables in standard TF GPT-2 model (model/wte, model/wpe, model/h0/ln_1/g, model/h0/ln_1/b, ...)
# Let's print min/max/mean of the first few 100k float blocks to understand data ranges across the file.
with open('gpt2-124M.ckpt', 'rb') as f:
    data = f.read()
floats = struct.unpack(f'{len(data)//4}f', data)

step = 1000000
for i in range(0, len(floats), step):
    chunk = floats[i:i+step]
    print(f'Offset {i:9d}: min={min(chunk):8.3f}, max={max(chunk):8.3f}, mean={sum(chunk)/len(chunk):8.4f}')
"
