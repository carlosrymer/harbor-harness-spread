import struct
# Let's inspect TF GPT-2 checkpoint default export order.
# Standard TF v1 checkpoint order of keys or standard dump order.
# Let's search for positional embedding wpe (1024, 768).
# Row 0 of wpe: position 0 embedding.
# Let's check if wpe is at offset 0, or if wte is at the end, or if bias vectors exist.
with open('gpt2-124M.ckpt', 'rb') as f:
    data = f.read(1000 * 4)
    floats = struct.unpack('1000f', data)
    print('First 20 floats:', floats[:20])
"
