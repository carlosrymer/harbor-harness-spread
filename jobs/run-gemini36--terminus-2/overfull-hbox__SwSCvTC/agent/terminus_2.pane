cat << 'EOF' > fast_solve.py
import re, subprocess

def eval_doc(paras):
    text = '\n\n'.join(paras)
    with open('input.tex', 'w') as f:
        f.write(text)
    subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)
    log = open('main.log', errors='ignore').read()
    overfulls = re.findall(r'Overfull \\hbox \(([0-9\.]+)pt too wide\) in paragraph at lines ([0-9]+)--([0-9]+)', log)
    return len(overfulls), sum(float(o[0]) for o in overfulls), overfulls

with open('synonyms.txt') as f:
    syn_lines = [line.strip().split(', ') for line in f if line.strip()]

word_map = {}
for grp in syn_lines:
    for w in grp:
        word_map[w] = grp

orig_text = open('input.tex.bak').read()
paras = orig_text.split('\n\n')

current_paras = list(paras)

for p_idx in range(len(paras)):
    print(f'--- Optimizing paragraph {p_idx} ---')
    p_orig = current_paras[p_idx]
    
    count, total_w, ovs = eval_doc(current_paras)
    if count == 0:
        print('0 overfulls remaining!')
        break
        
    words = re.findall(r'\b[A-Za-z]+\b', p_orig)
    replaceable = list(set([w for w in words if w in word_map]))
    if not replaceable:
        continue
        
    best_p = p_orig
    best_count = count
    best_w = total_w
    
    improved = True
    step = 0
    while improved and step < 20:
        improved = False
        step += 1
        for w in replaceable:
            for syn in word_map[w]:
                if syn == w: continue
                cand_p = re.sub(r'\b' + re.escape(w) + r'\b', syn, best_p)
                current_paras[p_idx] = cand_p
                c, tw, _ = eval_doc(current_paras)
                if c < best_count or (c == best_count and tw < best_w - 0.001):
                    print(f'Para {p_idx} step {step}: replaced {w}->{syn}: count={c}, total_width={tw:.2f}')
                    best_count = c
                    best_w = tw
                    best_p = cand_p
                    improved = True
                    break
            if improved:
                break
        current_paras[p_idx] = best_p

count, total_w, ovs = eval_doc(current_paras)
print(f'DONE. RemaCould not fix para 2 with 1 replacement. Trying 2 replacements...
