import re, subprocess, random, copy

def check_overfull(text):
    with open('input.tex', 'w') as f:
        f.write(text)
    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)
    log = open('main.log', errors='ignore').read()
    overfulls = re.findall(r'Overfull \\hbox \(([0-9\.]+)pt too wide\) in paragraph at lines ([0-9]+)--([0-9]+)', log)
    # Return total overfull width and count
    total_width = sum(float(o[0]) for o in overfulls)
    return len(overfulls), total_width, overfulls

with open('synonyms.txt') as f:
    syn_lines = [line.strip().split(', ') for line in f if line.strip()]

word_map = {}
for grp in syn_lines:
    for w in grp:
        word_map[w] = grp

orig_text = open('input.tex.bak').read()
paras = orig_text.split('\n\n')

# Find all replaceable word occurrences in text
# We will represent the state as a list of (word_index, selected_synonym)
# For each paragraph, find all replaceable words and their synonym choices

print("Initial:", check_overfull(orig_text))
