[49.303444, "i", "cat << 'EOF' > run_opt.py\nimport re, subprocess\n\ndef check_overfull(text):\n    with open('input.tex', 'w') as f:\n        f.write(text)\n    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\n    log = open('main.log', errors='ignore').read()\n    overfulls = re.findall(r'Overfull \\\\hbox \\(([0-9\\.]+)pt too wide\\) in paragraph at lines ([0-9]+)--([0-9]+)', log)\n    return len(overfulls), overfulls\n\nwith open('synonyms.txt') as f:\n    syn_lines = [line.strip().split(', ') for line in f if line.strip()]\n\nword_map = {}\nfor grp in syn_lines:\n    for w in grp:\n        word_map[w] = grp\n\norig_text = open('input.tex.bak').read()\nparagraphs = orig_text.split('\\n\\n')\n\nfor p_idx, para in enumerate(paragraphs):\n    words = re.findall(r'\\b[A-Za-z]+\\b', para)\n    replaceable = [w for w in set(words) if w in word_map]\n    if replaceable:\n        print(f'Paragraph {p_idx} has replaceable words: {replaceable}')\nEOF\npython3 run_opt.py\n"]
[49.304843, "o", "cat << 'EOF' > run_opt.py\r\n\u001b[?2004l\r"]
[49.305224, "o", "\u001b[?2004h> "]
[49.305791, "o", "import re, subprocess\r\n\u001b[?2004l\r\u001b[?2004h"]
