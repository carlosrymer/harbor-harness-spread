[101.083418, "i", "cat << 'EOF' > fast_solve.py\nimport re, subprocess, random, copy\n\ndef check_overfull(text):\n    with open('input.tex', 'w') as f:\n        f.write(text)\n    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\n    log = open('main.log', errors='ignore').read()\n    overfulls = re.findall(r'Overfull \\\\hbox \\(([0-9\\.]+)pt too wide\\) in paragraph at lines ([0-9]+)--([0-9]+)', log)\n    # Return total overfull width and count\n    total_width = sum(float(o[0]) for o in overfulls)\n    return len(overfulls), total_width, overfulls\n\nwith open('synonyms.txt') as f:\n    syn_lines = [line.strip().split(', ') for line in f if line.strip()]\n\nword_map = {}\nfor grp in syn_lines:\n    for w in grp:\n        word_map[w] = grp\n\norig_text = open('input.tex.bak').read()\nparas = orig_text.split('\\n\\n')\n\n# Find all replaceable word occurrences in text\n# We will represent the state as a list of (word_index, selected_synonym)\n# For each paragraph, find all replaceable words and their synonym choices\n\nprint(\"Initial:\", check_overfull(orig_text))\nEOF\npython3 fast_solve.py\n"]
[101.087594, "o", "cat << 'EOF' > fast_solve.py\r\nimport re, subprocess, random, copy\r\n\r\ndef check_overfull(text):\r\n    with open('input.tex', 'w') as f:\r\n        f.write(text)\r\n    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\r\n    log = open('main.log', errors='ignore').read()\r\n    overfulls = re.findall(r'Overfull \\\\hbox \\(([0-9\\.]+)pt too wide\\) in paragraph at lines ([0-9]+)--([0-9]+)', log)\r\n    # Return total overfull width and count\r\n    total_width = sum(float(o[0]) for o in overfulls)\r\n    return len(overfulls), total_width, overfulls\r\n\r\nwith open('synonyms.txt') as f:\r\n    syn_lines = [line.strip().split(', ') for line in f if line.strip()]\r\n\r\nword_map = {}\r\nfor grp in syn_lines:\r\n    for w in grp:\r\n        word_map[w] = grp\r\n\r\norig_text = open('input.tex.bak').read()\r\nparas = orig_text.split('\\n\\n')\r\n\r\n# Find all replaceable word occurrences in text\r\n# We will represent the state as a list of (word_index, selected_synonym)\r\n# For each paragraph, find all replaceable words and their synonym choices\r\n\r\nprint(\"Initial:\", check_overfull(orig_text))\r\nEOF\r\npython3 fast_solve.py\r\n"]
[103.502416, "o", "Para 2: curious -> odd reduced overfulls from 6 to 5\r\n"]
