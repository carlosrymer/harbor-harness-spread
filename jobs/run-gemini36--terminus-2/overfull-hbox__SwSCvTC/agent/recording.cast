[49.308054, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def check_overfull(text):\r\n\u001b[?2004l\r\u001b[?2004h>     with open('input.tex', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(text)\r\n\u001b[?2004l\r\u001b[?2004h>     res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\r\n\u001b[?2004l\r\u001b[?2004h>     log = open('main.log', errors='ignore').read()\r\n\u001b[?2004l\r\u001b[?2004h>     overfulls = re.findall(r'Overfull \\\\hbox \\(([0-9\\.]+)pt too wide\\) in paragraph at lines ([0-9]+)--([0-9]+)', log)\r\n\u001b[?2004l\r\u001b[?2004h>     return len(overfulls), overfulls\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('synonyms.txt') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     syn_lines = [line.strip().split(', ') for line in f if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> word_map = {}\r\n\u001b[?2004l\r\u001b[?2004h> for grp in syn_lines:\r\n\u001b[?2004l\r\u001b[?2004h>     for w in grp:\r\n\u001b[?2004l\r\u001b[?2004h>         word_map[w] = grp\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> orig_text = open('input.tex.bak').read()\r\n\u001b[?2004l\r\u001b[?2004h> paragraphs = orig_text.split('\\n\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for p_idx, para in enumerate(paragraphs):\r\n\u001b[?2004l\r\u001b[?2004h>     words = re.findall(r'\\b[A-Za-z]+\\b', para)\r\n\u001b[?2004l\r\u001b[?2004h>     replaceable = [w for w in set(words) if w in word_map]\r\n\u001b[?2004l\r\u001b[?2004h>     if replaceable:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'Paragraph {p_idx} has replaceable words: {replaceable}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
