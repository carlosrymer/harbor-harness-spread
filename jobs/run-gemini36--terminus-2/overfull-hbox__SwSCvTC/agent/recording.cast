[36.279704, "i", "cat << 'EOF' > run_opt.py\nimport re\nimport subprocess\n\ndef check_overfull(text):\n    with open('input.tex', 'w') as f:\n        f.write(text)\n    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\n    log = open('main.log', errors='ignore').read()\n    overfulls = re.findall(r'Overfull \\\\hbox \\(([0-9\\.]+)pt too wide\\) in paragraph at lines ([0-9]+)--([0-9]+)', log)\n    return overfulls\n\nwith open('synonyms.txt') as f:\n    syn_lines = [line.strip().split(', ') for line in f if line.strip()]\n\nword_map = {}\nfor grp in syn_lines:\n    for w in grp:\n        word_map[w] = grp\n\norig_text = open('input.tex.bak' if subprocess.os.path.exists('input.tex.bak') else 'input.tex').read()\nwith open('input.tex.bak', 'w') as f:\n    f.write(orig_text)\n\nprint('Initial overfulls:', check_overfull(orig_text))\nEOF\npython3 run_opt.py\n"]
[36.283688, "o", "cat << 'EOF' > run_opt.py\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def check_overfull(text):\r\n\u001b[?2004l\r\u001b[?2004h>     with open('input.tex', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(text)\r\n\u001b[?2004l\r\u001b[?2004h>     res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\r\n\u001b[?2004l\r\u001b[?2004h>     log = open('main.log', errors='ignore').read()\r\n\u001b[?2004l\r\u001b[?2004h>     overfulls = re.findall(r'Overfull \\\\hbox \\(([0-9\\.]+)pt too wide\\) in paragraph at lines ([0-9]+)--([0-9]+)', log)\r\n\u001b[?2004l\r\u001b[?2004h>     return overfulls\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('synonyms.txt') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     syn_lines = [line.strip().split(', ') for line in f if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> word_map = {}\r\n\u001b[?2004l\r\u001b[?2004h> for grp in syn_lines:\r\n\u001b[?2004l\r\u001b[?2004h>     for w in grp:\r\n\u001b[?2004l\r\u001b[?2004h>         word_map[w] = grp\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> orig_text = open('input.tex.bak' if subprocess.os.path.exists('input.tex.bak') else 'input.tex').read()\r\n\u001b[?2004l\r\u001b[?2004h> with open('input.tex.bak', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write(orig_text)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Initial overfulls:', check_overfull(orig_text))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
