Sending keys: ["cat << 'EOF' > generate_summary.py\nimport os\nimport re\nfrom datetime import datetime, date, timedelta\nimport csv\n\nREF_DATE = date(2025, 8, 12)\n\ndef is_today(d):\n    return d == REF_DATE\n\ndef is_last_7_days(d):\n    return (REF_DATE - timedelta(days=6)) <= d <= REF_DATE\n\ndef is_last_30_days(d):\n    return (REF_DATE - timedelta(days=29)) <= d <= REF_DATE\n\ndef is_month_to_date(d):\n    return date(REF_DATE.year, REF_DATE.month, 1) <= d <= REF_DATE\n\ndef is_total(d):\n    return True\n\nperiods = [\n    ('today', is_today),\n    ('last_7_days', is_last_7_days),\n    ('last_30_days', is_last_30_days),\n    ('month_to_date', is_month_to_date),\n    ('total', is_total),\n]\n\nseverities = ['ERROR', 'WARNING', 'INFO']\n\ncounts = {p_name: {s: 0 for s in severities} for p_name, _ in periods}\n\nlog_dir = '/app/logs'\nfor fname in os.listdir(log_dir):\n    if not fname.endswith('.log'):\n        continue\n    file_date_str = fname.split('_')[0]\n    try:\n        fdate = datetime.strptime(file_date_str, '%Y-%m-%d').date()\n    except ValueError:\n        continue\n    \n    filepath = os.path.join(log_dir, fname)\n    with open(filepath, 'r', encoding='utf-8') as f:\n        for line in f:\n            m = re.search(r'\\[(ERROR|WARNING|INFO)\\]', line)\n            if m:\n                sev = m.group(1)\n                for p_name, p_filter in periods:\n                    if p_filter(fdate):\n                        counts[p_name][sev] += 1\n\noutput_file = '/app/summary.csv'\nwith open(output_file, 'w', newline='', encoding='utf-8') as csvfile:\n    writer = csv.writer(csvfile)\n    writer.writerow(['period', 'severity', 'count'])\n    for p_name, _ in periods:\n        for sev in severities:\n            writer.writerow([p_name, sev, counts[p_name][sev]])\n\nprint('Summary generated successfully:')\nwith open(output_file, 'r') as csvfile:\n    print(csvfile.read())\nEOF\npython3 generate_summary.py\nrm generate_summary.py\n"] min_timeout_s