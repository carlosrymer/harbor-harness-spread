Sending keys: ["cat << 'EOF' > solve.py\nimport re, subprocess\n\ndef get_overfulls(text):\n    with open('input.tex', 'w') as f:\n        f.write(text)\n    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\n    log = open('main.log', errors='ignore').read()\n    overfulls = re.findall(r'Overfull \\\\hbox \\(([0-9\\.]+)pt too wide\\) in paragraph at lines ([0-9]+)--([0-9]+)', log)\n    return overfulls\n\nwith open('synonyms.txt') as f:\n    syn_lines = [line.strip().split(', ') for line in f if line.strip()]\n\nword_map = {}\nfor grp in syn_lines:\n    for w in grp:\n        word_map[w] = grp\n\norig_text = open('input.tex.bak').read()\nparas = orig_text.split('\\n\\n')\n\ndef replace_word_in_para(para, old_w, new_w):\n    return re.sub(r'\\b' + re.escape(old_w) + r'\\b', new_w, para)\n\ncurr_text = list(paras)\n\nfor p_idx in range(len(paras)):\n    while True:\n        ovs = get_overfulls('\\n\\n'.join(curr_text))\n        if not ovs:\n            break\n        # Check if current paragraph has overfulls\n        line_nums = [int(o[1]) for o in ovs]\n        # Map line nums to para idx: para 0=1..3, para 1=3..5, para 2=5..6 etc\n        # Para line start roughly: 1 + 2*p_idx\n        p_start = 1 + 2 * p_idx\n        has_ov = any(abs(ln - p_start) <= 2 for ln in line_nums)\n        if not has_ov:\n            break\n        print(f'Paragraph {p_idx} has overfulls. Trying replacements...')\n        orig_p = curr_text[p_idx]\n        words = re.findall(r'\\b[A-Za-z]+\\b', orig_p)\n        candidates = [w for w in set(words) if w in word_map]\n        improved = False\n        \n        # Try 1 word\n        for w in candidates:\n            for syn in word_map[w]:\n                if syn == w: continue\n                test_p = replace_word_in_para(orig_p, w, syn)\n                curr_text[p_idx] = test_p\n                new_ovs = get_overfulls('\\n\\n'.join(curr_text))\n                if len(new_ovs) < len(ovs):\n                    print(f'Para {p_idx}: {w} -> {syn} reduced overfulls from {len(ovs)} to {len(new_ovs)}')\n                    improved = True\n                    break\n            if improved: break\n        \n        if not improved:\n            print(f'Could not fix para {p_idx} with 1 replacement. Trying 2 replacements...')\n            for i, w1 in enumerate(candidates):\n                for syn1 in word_map[w1]:\n                    if syn1 == w1: continue\n                    p1 = replace_word_in_para(orig_p, w1, syn1)\n                    for w2 in candidates[i:]:\n                        for syn2 in word_map[w2]:\n                            if syn2 == w2 and w1 == w2: continue\n                            p2 = replace_word_in_para(p1, w2, syn2)\n                            curr_text[p_idx] = p2\n                            new_ovs = get_overfulls('\\n\\n'.join(curr_text))\n                            if len(new_ovs) < len(ovs):\n                                print(f'Para {p_idx}: {w1}->{syn1}, {w2}->{syn2} reduced overfulls from {len(ovs)} to {len(new_ovs)}')\n                                improved = True\n                                break\n                        if improved: break\n                    if improved: break\n                if improved: break\n        if not improved:\n            print(f'Failed to improve para {p_idx}')\n            curr_text[p_idx] = orig_p\n            break\n\nfinal_ovs = get_overfulls('\\n\\n'.join(curr_text))\nprint(f'Final remaining overfulls: {len(final_ovs)}')\nEOF\npython3 solve.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
