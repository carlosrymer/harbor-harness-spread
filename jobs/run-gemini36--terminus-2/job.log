Sending keys: ["cat << 'EOF' > solve_fast.py\nimport subprocess, re, sys\n\nwith open('synonyms.txt') as f:\n    syn_lines = [line.strip() for line in f if line.strip()]\n\nword_to_group = {}\nfor line in syn_lines:\n    words = [w.strip() for w in line.split(',')]\n    for w in words:\n        word_to_group[w.lower()] = words\n\ndef match_case(src_word, target_word):\n    if src_word.isupper():\n        return target_word.upper()\n    elif src_word.istitle():\n        return target_word.capitalize()\n    else:\n        return target_word.lower()\n\nwith open('input.tex') as f:\n    text = f.read()\n\ndef run_latex(t):\n    with open('input.tex', 'w') as f:\n        f.write(t)\n    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\n    overfulls = re.findall(r'Overfull \\\\hbox .*', res.stdout)\n    return res.stdout, overfulls\n\ndef tokenize(para):\n    return re.split(r'([a-zA-Z]+)', para)\n\ncurrent_paras = text.split('\\n\\n')\n\nlog, overfulls = run_latex('\\n\\n'.join(current_paras))\nprint(f'Starting overfull count: {len(overfulls)}')\nfor o in overfulls:\n    print(' ', o)\n\nfor p_idx in range(len(current_paras)):\n    log, overfulls = run_latex('\\n\\n'.join(current_paras))\n    if len(overfulls) == 0:\n        break\n    \n    tokens = tokenize(current_paras[p_idx])\n    replaceable = []\n    for i, tok in enumerate(tokens):\n        if tok.lower() in word_to_group:\n            replaceable.append((i, tok, word_to_group[tok.lower()]))\n    \n    if not replaceable:\n        continue\n        \n    improved = True\n    while improved:\n        improved = False\n        _, base_of = run_latex('\\n\\n'.join(current_paras))\n        best_count = len(base_of)\n        if best_count == 0:\n            break\n            \n        best_i = -1\n        best_syn = None\n        for i, orig_tok, choices in replaceable:\n            curr_tok = tokens[i]\n            for choice in choices:\n                c_tok = match_case(orig_tok, choice)\n                if c_tok == curr_tok:\n                    continue\n                tokens[i] = c_tok\n                current_paras[p_idx] = ''.join(tokens)\n                _, new_of = run_latex('\\n\\n'.join(current_paras))\n                if len(new_of) < best_count:\n                    best_count = len(new_of)\n                    best_i = i\n                    best_syn = c_tok\n                    print(f'P{p_idx}: {orig_tok} -> {c_tok} (Overfulls: {best_count})')\n                tokens[i] = curr_tok\n                current_paras[p_idx] = ''.join(tokens)\n        \n        if best_i != -1:\n            tokens[best_i] = best_syn\n            current_paras[p_idx] = ''.join(tokens)\n            improved = True\n\nlog, final_of = run_latex('\\n\\n'.join(current_paras))\nprint(f'FINAL OVERFULL COUNT: {len(final_of)}')\nfor o in final_of:\n    print(' ', o)\nEOF\npython3 solve_fast.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
