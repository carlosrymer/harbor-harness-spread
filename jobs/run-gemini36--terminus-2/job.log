Sending keys: ["cat << 'EOF' > make_script.py\ncode = '''import subprocess, re, sys\n\nwith open('synonyms.txt') as f:\n    syn_lines = [line.strip() for line in f if line.strip()]\n\nword_to_group = {}\nfor line in syn_lines:\n    words = [w.strip() for w in line.split(',')]\n    for w in words:\n        word_to_group[w.lower()] = words\n\ndef match_case(src_word, target_word):\n    if src_word.isupper():\n        return target_word.upper()\n    elif src_word.istitle():\n        return target_word.capitalize()\n    else:\n        return target_word.lower()\n\nwith open('input.tex') as f:\n    original_text = f.read()\n\nparas = original_text.split('\\n\\n')\n\ndef test_full_text(para_list):\n    full = '\\n\\n'.join(para_list)\n    with open('input.tex', 'w') as f:\n        f.write(full)\n    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\n    overfulls = re.findall(r'Overfull \\\\hbox .*', res.stdout)\n    return overfulls\n\ndef tokenize(para):\n    return re.split(r'([a-zA-Z]+)', para)\n\ncurrent_paras = list(paras)\n\nfor p_idx, para in enumerate(current_paras):\n    base_overfulls = test_full_text(current_paras)\n    print(f'=== Paragraph {p_idx} === (Total overfulls: {len(base_overfulls)})')\n    if len(base_overfulls) == 0:\n        break\n\n    tokens = tokenize(para)\n    replaceable = []\n    for i, tok in enumerate(tokens):\n        if tok.lower() in word_to_group:\n            replaceable.append((i, tok, word_to_group[tok.lower()]))\n    \n    improved = True\n    while improved:\n        improved = False\n        best_count = len(test_full_text(current_paras))\n        if best_count == 0:\n            break\n        \n        best_i = -1\n        best_syn = None\n        for i, original_tok, choices in replaceable:\n            curr_tok = tokens[i]\n            for choice in choices:\n                c_tok = match_case(original_tok, choice)\n                if c_tok == curr_tok:\n                    continue\n                tokens[i] = c_tok\n                current_paras[p_idx] = ''.join(tokens)\n                ofs = test_full_text(current_paras)\n                if len(ofs) < best_count:\n                    best_count = len(ofs)\n                    best_i = i\n                    best_syn = c_tok\n                    print(f'  Improved! New overfull count: {best_count} ({original_tok} -> {c_tok})')\n                tokens[i] = curr_tok\n                current_paras[p_idx] = ''.join(tokens)\n        \n        if best_i != -1:\n            tokens[best_i] = best_syn\n            current_paras[p_idx] = ''.join(tokens)\n            improved = True\n\nfinal_ofs = test_full_text(current_paras)\nprint(f'FINAL OVERFULL COUNT: {len(final_ofs)}')\nfor o in final_ofs:\n    print(o)\n\nif len(final_ofs) == 0:\n    print('SUCCESS!')\n'''\nwith open('solve.py', 'w') as f:\n    f.write(code)\nEOF\npython3 make_script.py\npython3 solve.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
