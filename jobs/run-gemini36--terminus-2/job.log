Sending keys: ["cat << 'EOF' > fast_solve.py\nimport re, subprocess\n\ndef eval_doc(paras):\n    text = '\\n\\n'.join(paras)\n    with open('input.tex', 'w') as f:\n        f.write(text)\n    subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\n    log = open('main.log', errors='ignore').read()\n    overfulls = re.findall(r'Overfull \\\\hbox \\(([0-9\\.]+)pt too wide\\) in paragraph at lines ([0-9]+)--([0-9]+)', log)\n    return len(overfulls), sum(float(o[0]) for o in overfulls), overfulls\n\nwith open('synonyms.txt') as f:\n    syn_lines = [line.strip().split(', ') for line in f if line.strip()]\n\nword_map = {}\nfor grp in syn_lines:\n    for w in grp:\n        word_map[w] = grp\n\norig_text = open('input.tex.bak').read()\nparas = orig_text.split('\\n\\n')\n\ncurrent_paras = list(paras)\n\nfor p_idx in range(len(paras)):\n    print(f'--- Optimizing paragraph {p_idx} ---')\n    p_orig = current_paras[p_idx]\n    \n    count, total_w, ovs = eval_doc(current_paras)\n    if count == 0:\n        print('0 overfulls remaining!')\n        break\n        \n    words = re.findall(r'\\b[A-Za-z]+\\b', p_orig)\n    replaceable = list(set([w for w in words if w in word_map]))\n    if not replaceable:\n        continue\n        \n    best_p = p_orig\n    best_count = count\n    best_w = total_w\n    \n    improved = True\n    step = 0\n    while improved and step < 20:\n        improved = False\n        step += 1\n        for w in replaceable:\n            for syn in word_map[w]:\n                if syn == w: continue\n                cand_p = re.sub(r'\\b' + re.escape(w) + r'\\b', syn, best_p)\n                current_paras[p_idx] = cand_p\n                c, tw, _ = eval_doc(current_paras)\n                if c < best_count or (c == best_count and tw < best_w - 0.001):\n                    print(f'Para {p_idx} step {step}: replaced {w}->{syn}: count={c}, total_width={tw:.2f}')\n                    best_count = c\n                    best_w = tw\n                    best_p = cand_p\n                    improved = True\n                    break\n            if improved:\n                break\n        current_paras[p_idx] = best_p\n\ncount, total_w, ovs = eval_doc(current_paras)\nprint(f'DONE. Remaining overfulls: {count}, total width: {total_w:.2f}')\nfor o in ovs:\n    print(o)\nEOF\npython3 fast_solve.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
