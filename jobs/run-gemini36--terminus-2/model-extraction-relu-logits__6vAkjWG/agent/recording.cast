[56.836383, "o", "\n\u001b[?2004l\r\u001b[?2004h>         t_test = t1 + 0.382 * (t2 - t1)\r\n\u001b[?2004l\r\u001b[?2004h>         f_test = eval_f(t_test)\r\n\u001b[?2004l\r\u001b[?2004h>         f_interp_test = f1 + 0.382 * (f2 - f1)\r\n\u001b[?2004l\r\u001b[?2004h>         if max(abs(fm - f_interp), abs(f_test - f_interp_test)) > tol:\r\n\u001b[?2004l\r\u001b[?2004h>             if (t2 - t1) < 1e-4:\r\n\u001b[?2004l\r\u001b[?2004h>                 kinks.append((t1 + t2) / 2.0)\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 search(t1, tm, f1, fm, depth + 1)\r\n\u001b[?2004l\r\u001b[?2004h>                 search(tm, t2, fm, f2, depth + 1)\r\n\u001b[?2004l\r\u001b[?2004h>     search(t_min, t_max, eval_f(t_min), eval_f(t_max), 0)\r\n\u001b[?2004l\r\u001b[?2004h>     return kinks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     np.random.seed(42)\r\n\u001b[?2004l\r\u001b[?2004h>     extracted_directions = []\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(30):\r\n\u001b[?2004l\r\u001b[?2004h>         x0 = np.random.randn(10) * 5\r\n\u001b[?2004l\r\u001b[?2004h>         v = np.random.randn(10)\r\n\u001b[?2004l\r\u001b[?2004h>         v /= np.linalg."]
[56.836417, "o", "norm(v)\r\n\u001b[?2004l\r\u001b[?2004h>         kinks = find_kinks(x0, v, t_min=-20.0, t_max=20.0)\r\n\u001b[?2004l\r\u001b[?2004h>         for t in kinks:\r\n\u001b[?2004l\r\u001b[?2004h>             delta_t = 1e-3\r\n\u001b[?2004l\r\u001b[?2004h>             g_left = grad(x0 + (t - delta_t) * v)\r\n\u001b[?2004l\r\u001b[?2004h>             g_right = grad(x0 + (t + delta_t) * v)\r\n\u001b[?2004l\r\u001b[?2004h>             dg = g_right - g_left\r\n\u001b[?2004l\r\u001b[?2004h>             norm_dg = np.linalg.norm(dg)\r\n\u001b[?2004l\r\u001b[?2004h>             if norm_dg > 1e-4:\r\n\u001b[?2004l\r\u001b[?2004h>                 r = dg / norm_dg\r\n\u001b[?2004l\r\u001b[?2004h>                 is_new = True\r\n\u001b[?2004l\r\u001b[?2004h>                 for u in extracted_directions:\r\n\u001b[?2004l\r\u001b[?2004h>                     if abs(abs(np.dot(r, u)) - 1.0) < 1e-3:\r\n\u001b[?2004l\r\u001b[?2004h>                         is_new = False\r\n\u001b[?2004l\r\u001b[?2004h>                         break\r\n\u001b[?2004l\r\u001b[?2004h>                 if is_new:\r\n\u001b[?2004l\r\u001b[?2004h>                     extracted_directions.append(r)\r\n\u001b[?2004l\r\u001b[?2004h>     stolen_A1 = np.array(extracted_directi"]
