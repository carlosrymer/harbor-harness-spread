[160.799572, "i", "cat << 'EOF' > /app/make_script.py\nimport mujoco\nimport numpy as np\nimport time\nfrom pathlib import Path\nfrom test_opt import eval_xml\n\nbase_xml = Path('model_ref.xml').read_text()\n\ndef add_option(xml_str, opt_tag):\n    idx = xml_str.find('<worldbody>')\n    return xml_str[:idx] + opt_tag + '\\n' + xml_str[idx:]\n\ntests = [\n    ('baseline', base_xml),\n    ('solver=CG', add_option(base_xml, '<option solver=\"CG\"/>')),\n    ('solver=PGS', add_option(base_xml, '<option solver=\"PGS\"/>')),\n    ('integrator=implicit', add_option(base_xml, '<option integrator=\"implicit\"/>')),\n    ('integrator=implicitfast', add_option(base_xml, '<option integrator=\"implicitfast\"/>')),\n    ('iterations=10', add_option(base_xml, '<option iterations=\"10\"/>')),\n    ('iterations=20', add_option(base_xml, '<option iterations=\"20\"/>')),\n    ('iterations=50', add_option(base_xml, '<option iterations=\"50\"/>')),\n    ('tolerance=1e-4', add_option(base_xml, '<option tolerance=\"1e-4\"/>')),\n    ('tolerance=1e-3', add_option(base_xml, '<option toleranc"]
[160.800588, "i", "e=\"1e-3\"/>')),\n    ('jacobian=sparse', add_option(base_xml, '<option jacobian=\"sparse\"/>')),\n    ('jacobian=dense', add_option(base_xml, '<option jacobian=\"dense\"/>')),\n    ('flag collision=disable', add_option(base_xml, '<option><flag collision=\"disable\"/></option>')),\n    ('flag contact=disable', add_option(base_xml, '<option><flag contact=\"disable\"/></option>')),\n    ('flag warmstart=enable', add_option(base_xml, '<option><flag warmstart=\"enable\"/></option>')),\n    ('flag warmstart=disable', add_option(base_xml, '<option><flag warmstart=\"disable\"/></option>')),\n]\n\nfor name, xml in tests:\n    try:\n        diff, t = eval_xml(xml)\n        pass_tol = 'PASS' if diff <= 1e-5 else 'FAIL'\n        print(f'{name:30s} | diff: {diff:.8f} ({pass_tol}) | time: {t:.4f}s')\n    except Exception as e:\n        print(f'{name:30s} | ERROR: {e}')\nEOF\npython3 /app/make_script.py\n"]
