[87.739635, "i", "cat << 'EOF' > /app/test_opt.py\nimport time\nimport mujoco\nimport numpy as np\nfrom pathlib import Path\n\ndef eval_xml(xml_str, seed=42):\n    m_ref = mujoco.MjModel.from_xml_path('model_ref.xml')\n    m_test = mujoco.MjModel.from_xml_string(xml_str)\n    \n    diffs = []\n    for s in [seed, seed+1, seed+2, seed+3, seed+4]:\n        d_ref = mujoco.MjData(m_ref)\n        d_test = mujoco.MjData(m_test)\n        \n        rng = np.random.default_rng(s)\n        jiggle = rng.normal(0, 0.01, size=d_ref.qpos.shape)\n        d_ref.qpos += jiggle\n        d_test.qpos += jiggle\n        \n        mujoco.mj_forward(m_ref, d_ref)\n        mujoco.mj_forward(m_test, d_test)\n        \n        nstep_ref = int(2.0 / m_ref.opt.timestep)\n        nstep_test = int(2.0 / m_test.opt.timestep)\n        \n        for _ in range(nstep_ref):\n            mujoco.mj_step(m_ref, d_ref)\n        for _ in range(nstep_test):\n            mujoco.mj_step(m_test, d_test)\n            \n        full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS\n        st_ref = np.zero"]
[87.740974, "i", "s(mujoco.mj_stateSize(m_ref, full_physics))\n        st_test = np.zeros(mujoco.mj_stateSize(m_test, full_physics))\n        mujoco.mj_getState(m_ref, d_ref, st_ref, full_physics)\n        mujoco.mj_getState(m_test, d_test, st_test, full_physics)\n        \n        if np.isnan(st_test).any() or np.isinf(st_test).any():\n            return 999.0, 999.0\n        \n        diffs.append(np.linalg.norm(st_ref - st_test))\n    \n    max_diff = np.max(diffs)\n    \n    t0 = time.perf_counter()\n    for _ in range(5):\n        d_test = mujoco.MjData(m_test)\n        d_test.qpos += jiggle\n        mujoco.mj_forward(m_test, d_test)\n        for _ in range(nstep_test):\n            mujoco.mj_step(m_test, d_test)\n    t1 = time.perf_counter()\n    avg_time = (t1 - t0) / 5.0\n    return max_diff, avg_time\n\nbase_xml = Path('model_ref.xml').read_text()\nprint(\"Baseline:\")\ndiff, t = eval_xml(base_xml)\nprint(f\"Diff: {diff:.8f}, Time: {t:.4f}s\")\nEOF\npython3 /app/test_opt.py\n"]
