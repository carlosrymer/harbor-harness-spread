[172.865073, "i", "python3 -c '\nwith open(\"/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat\", \"rb\") as f:\n    data = f.read()\n\nfor keyword in [b\"8XD\", b\"W54\", b\"launchcode\", b\"PASSWORD\", b\"PASSWORD=\"]:\n    pos = 0\n    while True:\n        idx = data.find(keyword, pos)\n        if idx == -1:\n            break\n        print(f\"Found {keyword} at offset {idx} (0x{idx:x}): {data[max(0, idx-20):min(len(data), idx+50)]}\")\n        pos = idx + 1\n'\n"]
