[189.660356, "i", "python3 -c '\nimport zipfile, io\n\nwith open(\"/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat\", \"rb\") as f:\n    data = f.read()\n\n# Find PK header offsets (b\"PK\\x03\\x04\")\npos = 0\nwhile True:\n    idx = data.find(b\"PK\\x03\\x04\", pos)\n    if idx == -1:\n        break\n    print(f\"Found PK\\x03\\x04 at offset {idx} (0x{idx:x})\")\n    try:\n        zf = zipfile.ZipFile(io.BytesIO(data[idx:]))\n        print(\"Zip contents:\", zf.namelist())\n        for name in zf.namelist():\n            content = zf.read(name)\n            print(f\"  {name}: {content}\")\n    except Exception as e:\n        print(\"  Error opening zip:\", e)\n    pos = idx + 1\n'\n"]
