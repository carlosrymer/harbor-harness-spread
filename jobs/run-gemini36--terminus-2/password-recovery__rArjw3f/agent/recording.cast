[61.589377, "o", "debugfs 1.47.0 (5-Feb-2023)\r\ndebugfs: Bad magic number in super-block while trying to open /app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat\r\n"]
[61.589655, "o", "ls: Filesystem not open\r\n"]
[61.590164, "o", "\u001b[?2004hroot@e8b72b416e99:/app# "]
[73.094863, "i", "python3 -c '\nimport re, os\n\npattern = re.compile(rb\"8XD[A-Z0-9]{17}W54\")\npattern2 = re.compile(rb\"8XD[A-Z0-9]*W54\")\npattern3 = re.compile(rb\"PASSWORD=[A-Za-z0-9]+\")\n\nfor root, dirs, files in os.walk(\"/app\"):\n    for f in files:\n        path = os.path.join(root, f)\n        try:\n            with open(path, \"rb\") as fp:\n                data = fp.read()\n                m1 = pattern.findall(data)\n                m2 = pattern2.findall(data)\n                m3 = pattern3.findall(data)\n                if m1 or m2 or m3:\n                    print(path, \"m1:\", m1, \"m2:\", m2, \"m3:\", m3)\n        except Exception as e:\n            pass\n'\n"]
[73.09528, "o", "python3 -c '\r\n\u001b[?2004l\r"]
[73.095341, "o", "\u001b[?2004h> "]
[73.096854, "o", "import re, os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pattern = re.compile(rb\"8XD[A-Z0-9]{17}W54\")\r\n\u001b[?2004l\r\u001b[?2004h> pattern2 = re.compile(rb\"8XD[A-Z0-9]*W54\")\r\n\u001b[?2004l\r\u001b[?2004h> pattern3 = re.compile(rb\"PASSWORD=[A-Za-z0-9]+\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for root, dirs, files in os.walk(\"/app\"):\r\n\u001b[?2004l\r\u001b[?2004h>     for f in files:\r\n\u001b[?2004l\r\u001b[?2004h>         path = os.path.join(root, f)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             with open(path, \"rb\") as fp:\r\n\u001b[?2004l\r\u001b[?2004h>                 data = fp.read()\r\n\u001b[?2004l\r\u001b[?2004h>                 m1 = pattern.findall(data)\r\n\u001b[?2004l\r\u001b[?2004h>                 m2 = pattern2.findall(data)\r\n\u001b[?2004l\r\u001b[?2004h>                 m3 = pattern3.findall(data)\r\n\u001b[?2004l\r\u001b[?2004h>                 if m1 or m2 or m3:\r\n\u001b[?2004l\r\u001b[?2004h>                     print(path, \"m1:\", m1, \"m2:\", m2, \"m3:\", m3)\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h> '\r\n\u001b[?2004l\r"]
[73.122226, "o", "/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat m1: [] m2: [] m3: [b'PASSWORD=8XDP5Q2RT9Z']\r\n"]
[73.126023, "o", "\u001b[?2004hroot@e8b72b416e99:/app# "]
[79.57195, "i", "python3 -c '\nimport re\n\npattern = re.compile(rb\"8XD[A-Z0-9]{17}W54\")\npattern2 = re.compile(rb\"8XD[A-Z0-9]{14,22}W54\")\n\ntry:\n    with open(\"/dev/vda\", \"rb\") as f:\n        chunk_size = 10 * 1024 * 1024\n        overlap = 100\n        offset = 0\n        matches = set()\n        while True:\n            data = f.read(chunk_size)\n            if not data:\n                break\n            for m in pattern.findall(data):\n                matches.add(m)\n            for m in pattern2.findall(data):\n                matches.add(m)\n            if len(data) < chunk_size:\n                break\n            f.seek(f.tell() - overlap)\n        print(\"Matches found on /dev/vda:\", matches)\nexcept Exception as e:\n    print(\"Error:\", e)\n'\n"]
[79.573344, "o", "python3 -c '\r\n"]
[79.573469, "o", "\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.576586, "o", "pattern = re.compile(rb\"8XD[A-Z0-9]{17}W54\")"]
[79.577842, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> pattern2 = re.compile(rb\"8XD[A-Z0-9]{14,22}W54\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     with open(\"/dev/vda\", \"rb\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>         chunk_size = 10 * 1024 * 1024\r\n\u001b[?2004l\r\u001b[?2004h>         overlap = 100\r\n\u001b[?2004l\r\u001b[?2004h>         offset = 0\r\n\u001b[?2004l\r\u001b[?2004h>         matches = set()\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             data = f.read(chunk_size)\r\n\u001b[?2004l\r\u001b[?2004h>             if not data:\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>             for m in pattern.findall(data):\r\n\u001b[?2004l\r\u001b[?2004h>                 matches.add(m)\r\n\u001b[?2004l\r\u001b[?2004h>             for m in pattern2.findall(data):\r\n\u001b[?2004l\r\u001b[?2004h>                 matches.add(m)\r\n\u001b[?2004l\r\u001b[?2004h>             if len(data) < chunk_size:\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>             f.seek(f.tell() - overlap)\r\n\u001b[?2004l\r\u001b[?2004h> "]
