[131.303095, "i", "python3 -c '\nwith open(\"/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat\", \"rb\") as f:\n    data = f.read()\nprint(\"Size:\", len(data))\n# Print printable character sequences longer than 3 chars\nimport re\nstrings = re.findall(rb\"[a-zA-Z0-9_=\\-]{4,}\", data)\nprint(\"Found\", len(strings), \"printable strings. Sample:\", strings[:50])\n'\n"]
[131.303456, "o", "python3 -c '\r\nwith open(\"/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat\", \"rb\") as f:\r\n    data = f.read()\r\nprint(\"Size:\", len(data))\r\n# Print printable character sequences longer than 3 chars\r\nimport re\r\nstrings = re.findall(rb\"[a-zA-Z0-9_=\\-]{4,}\", data)\r\nprint(\"Found\", len(strings), \"printable strings. Sample:\", strings[:50])\r\n'\r\n"]
[140.346007, "i", "python3 -c '\nimport os, re\nfor root, dirs, files in os.walk(\"/app/varsea\"):\n    for fname in files:\n        path = os.path.join(root, fname)\n        with open(path, \"rb\") as f:\n            data = f.read()\n            strs = re.findall(rb\"[a-zA-Z0-9_=\\-]{4,}\", data)\n            print(path, len(data), strs)\n'\n"]
[140.347688, "o", "python3 -c '\r\nimport os, re\r\nfor root, dirs, files in os.walk(\"/app/varsea\"):\r\n    for fname in files:\r\n        path = os.path.join(root, fname)\r\n        with open(path, \"rb\") as f:\r\n            data = f.read()\r\n            strs = re.findall(rb\"[a-zA-Z0-9_=\\-]{4,}\", data)\r\n            print(path, len(data), strs)\r\n'\r\n"]
