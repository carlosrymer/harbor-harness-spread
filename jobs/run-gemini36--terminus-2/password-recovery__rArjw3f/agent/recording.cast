[152.620503, "i", "python3 -c '\nimport re\n\nwith open(\"/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat\", \"rb\") as f:\n    data = f.read()\n\n# Let us search for 8XD followed by 17 alphanumeric characters and ending with W54 (total length 23)\nmatches1 = re.findall(rb\"8XD[A-Z0-9]{17}W54\", data)\nprint(\"Strict match (23 chars starting 8XD ending W54):\", matches1)\n\n# Search for PASSWORD=8XD...\nmatches2 = re.findall(rb\"PASSWORD=[^\r\n\\x00]+\", data)\nprint(\"PASSWORD= matches:\", matches2)\n\n# Search for any string starting with 8XD and ending with W54 with anything in between\nmatches3 = re.findall(rb\"8XD.{1,30}?W54\", data)\nprint(\"Broad 8XD...W54 matches:\", matches3)\n'\n"]
[152.625927, "o", "python3 -c '\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open(\"/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat\", \"rb\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let us search for 8XD followed by 17 alphanumeric characters and ending with W54 (total length 23)\r\n\u001b[?2004l\r\u001b[?2004h> matches1 = re.findall(rb\"8XD[A-Z0-9]{17}W54\", data)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Strict match (23 chars starting 8XD ending W54):\", matches1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Search for PASSWORD=8XD...\r\n\u001b[?2004l\r\u001b[?2004h> matches2 = re.findall(rb\"PASSWORD=[^\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \\x00]+\", data)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"PASSWORD= matches:\", matches2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Search for any string starting with 8XD and ending with W54 with anything in between\r\n\u001b[?2004l\r\u001b[?2004h> matches3 = re.findall(rb\"8XD.{1,30}?W54\", data)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Broad 8XD...W54 matches:\", matches3)\r\n\u001b[?2004l\r\u001b[?2004h> '\r\n\u001b[?2004l\r"]
