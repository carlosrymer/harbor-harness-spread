[111.074404, "i", "python3 -c \"\nimport re, subprocess, random\n\nsyn_map = {}\nwith open('synonyms.txt') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        words = [w.strip() for w in line.split(',') if w.strip()]\n        for w in words:\n            syn_map[w] = words\n            syn_map[w.lower()] = words\n            syn_map[w.capitalize()] = [x.capitalize() for x in words]\n            syn_map[w.upper()] = [x.upper() for x in words]\n\nwith open('input.tex') as f: orig_text = f.read()\n\ndef get_overfulls(text):\n    with open('input.tex', 'w') as f: f.write(text)\n    res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)\n    return [l for l in res.stdout.splitlines() if 'Overfull' in l]\n\ntokens = re.split(r'(\\b[A-Za-z]+\\b)', orig_text)\nreplaceable = [(i, t, syn_map[t]) for i, t in enumerate(tokens) if t in syn_map and len(syn_map[t]) > 1]\nprint(f'Replaceable tokens: {len(replaceable)}')\n\ncurr_tokens = list(tokens)\nbest_of = get_overfulls(''.join(curr_tokens))\nprint(f'Initial overfulls: {len(best_of)}')\n\nstep = 0\nwhile len(best_of) > 0 and step < 100:\n    step += 1\n    improved = False\n    for t_idx, orig_tok, options in replaceable:\n        curr_val = curr_tokens[t_idx]\n        for opt in options:\n            if opt == curr_val: continue\n            test_tokens = list(curr_tokens)\n            test_tokens[t_idx] = opt\n            of = get_overfulls(''.join(test_tokens))\n            if len(of) < len(best_of):\n                print(f'Step {step}: Improved {len(best_of)} -> {len(of)} ({curr_val} -> {opt})')\n                curr_tokens = test_tokens\n                best_of = of\n                improved = True\n                break\n        if improved: break\n    if not improved:\n        print('Random tweak...')\n        t_idx, orig_tok, options = random.choice(replaceable)\n        curr_tokens[t_idx] = random.choice(options)\n        best_of = get_overfulls(''.join(curr_tokens))\n\nif len(best_of) == 0:\n    print('SUCCESS! Zero overfull hboxes!')\n    with open('input.tex', 'w') as f: f.write(''.join(curr_tokens))\nelse:\n    print(f'Ended with {len(best_of)} overfulls')\n\" > run.log 2>&1 &\n"]
