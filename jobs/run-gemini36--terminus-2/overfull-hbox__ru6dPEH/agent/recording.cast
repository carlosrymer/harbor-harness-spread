[111.08074, "o", "            if len(of) < len(best_of):\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f'Step {step}: Improved {len(best_of)} -> {len(of)} ({curr_val} -> {opt})')\r\n\u001b[?2004l\r\u001b[?2004h>                 curr_tokens = test_tokens\r\n\u001b[?2004l\r\u001b[?2004h>                 best_of = of\r\n\u001b[?2004l\r\u001b[?2004h>                 improved = True\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>         if improved: break\r\n\u001b[?2004l\r\u001b[?2004h>     if not improved:\r\n\u001b[?2004l\r\u001b[?2004h>         print('Random tweak...')\r\n\u001b[?2004l\r\u001b[?2004h>         t_idx, orig_tok, options = random.choice(replaceable)\r\n\u001b[?2004l\r\u001b[?2004h>         curr_tokens[t_idx] = random.choice(options)\r\n\u001b[?2004l\r\u001b[?2004h>         best_of = get_overfulls(''.join(curr_tokens))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if len(best_of) == 0:\r\n\u001b[?2004l\r\u001b[?2004h>     print('SUCCESS! Zero overfull hboxes!')\r\n\u001b[?2004l\r\u001b[?2004h>     with open('input.tex', 'w') as f: f.write(''.join(curr_tokens))\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Ended with {len(best_of)} overfulls')\r\n\u001b[?2004l\r\u001b[?2004h> \" > run.log 2>&1 &\r\n\u001b[?2004l\r"]
