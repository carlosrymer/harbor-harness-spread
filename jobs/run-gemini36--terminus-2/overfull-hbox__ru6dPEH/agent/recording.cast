[116.929708, "o", "root        2690  0.1  0.1 103336 22988 pts/0    Sl+  15:38   0:00 /usr/bin/\u001b[01;31m\u001b[Kpython3\u001b[m\u001b[K /usr/bin/asciinema rec --stdin /logs/agent/recording.cast\r\nroot        2691  0.0  0.0  29572 15868 pts/0    S+   15:38   0:00 /usr/bin/\u001b[01;31m\u001b[Kpython3\u001b[m\u001b[K /usr/bin/asciinema rec --stdin /logs/agent/recording.cast\r\nroot        2692  0.0  0.0  29584 16444 pts/0    S+   15:38   0:00 /usr/bin/\u001b[01;31m\u001b[Kpython3\u001b[m\u001b[K /usr/bin/asciinema rec --stdin /logs/agent/recording.cast\r\nroot        3013  1.3  0.0  18240 13060 pts/1    S    15:40   0:00 \u001b[01;31m\u001b[Kpython3\u001b[m\u001b[K -c  import re, subprocess, random  syn_map = {} with open('synonyms.txt') as f:     for line in f:         line = line.strip()         if not line: continue         words = [w.strip() for w in line.split(',') if w.strip()]         for w in words:             syn_map[w] = words             syn_map[w.lower()] = words             syn_map[w.capitalize()] = [x.capitalize() for x in words]             syn_map[w.upper()] = [x.upper() for x in words]  with open('input.tex') as f: orig_text = f.read()  def get_overfulls(text):     with open('input.tex', 'w') as f: f.write(text)     res = subprocess.run(['pdflatex', '-interaction=nonstopmode', 'main.tex'], capture_output=True, text=True)     return [l for l in res.stdout.splitlines() if 'Overfull' in l]  tokens = re.split(r'(\\b[A-Za-z]+\\b)', orig_text) replaceable = [(i, t, syn_map[t]) for i, t in enumerate(tokens) if t in syn_map and len(syn_map[t]) > 1] print(f'Replaceable tokens: {len(replaceable)}')  curr_tokens = list(tokens) best_of = get_overfulls(''.join(curr_tokens)) print(f'Initial overfulls: {len(best_of)}')  step = 0 while len(best_of) > 0 and step < 100:     step += 1     improved = False     for t_idx, orig_tok, options in replaceable:         curr_val = curr_tokens[t_idx]         for opt in options:             if opt == curr_val: continue             test_tokens = list(curr_tokens)             test_tokens[t_idx] = opt             of = get_overfulls(''.join(test_tokens))             if len(of) < len(best_of):                 print(f'Step {step}: Improved {len(best_of)} -> {len(of)} ({curr_val} -> {opt})')                 curr_tokens = test_tokens                 best_of = of                 improved = True                 break         if improved: break     if not improved:         print('Random tweak...')         t_idx, orig_tok, options = random.choice(replaceable)         curr_tokens[t_idx] = random.choice(options)         best_of = get_overfulls(''.join(curr_tokens))  if len(best_of) == 0:     print('SUCCESS! Zero overfull hboxes!')     with open('input.tex', 'w') as f: f.write(''.join(curr_tokens)) else:     print(f'Ended with {len(best_of)} overfulls') \r\nroot        3090  0.0  0.0   3920  2124 pts/1    S+   15:40   0:00 grep --color=auto \u001b[01;31m\u001b[Kpython3\u001b[m\u001b[K\r\n"]
