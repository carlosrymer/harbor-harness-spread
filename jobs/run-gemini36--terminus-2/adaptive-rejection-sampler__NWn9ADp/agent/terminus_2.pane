[?2004l[?2004h> ars <- function(g, n, lb = -Inf, ub = Inf, x = NULL, ...) {
[?2004l[?2004h>   validate_inputs(g, n, lb, ub, x)
[?2004l[?2004h>   
[?2004l[?2004h>   if (is.null(x)) {
[?2004l[?2004h>     if (is.finite(lb) && is.finite(ub)) {
[?2004l[?2004h>       x <- seq(lb + 0.25 * (ub - lb), ub - 0.25 * (ub - lb), length.out = 3)
[?2004l[?2004h>     } else if (is.finite(lb)) {
[?2004l[?2004h>       x <- c(lb + 0.5, lb + 1.5, lb + 3.0)
[?2004l[?2004h>     } else if (is.finite(ub)) {
[?2004l[?2004h>       x <- c(ub - 3.0, ub - 1.5, ub - 0.5)
[?2004l[?2004h>     } else {
[?2004l[?2004h>       x <- c(-1.0, 0.0, 1.0)
[?2004l[?2004h>     }
[?2004l[?2004h>   } else {
[?2004l[?2004h>     x <- sort(unique(x))
[?2004l[?2004h>     if (length(x) < 2) {
[?2004l[?2004h>       stop("Initial points 'x' must contain at least 2 distinct values")
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h>   
[?2004l[?2004h>   res <- eval_h_and_prime(g, x, ...)
[?2004l[?2004h>   h <- res$h
[?2004l[?2004h>   h_prime <- res$h_prime
[?2004l[?2004h>   
[?2004l[?2004h>   check_log_concavity(x, h_prime)
[?2004l[?2004h>   
[?2004l[?2004h>   if (is.infinite(lb) && h_prime[1] <= 0) {
[?2004l[?2004h>     stop("For unbounded lower domain (lb = -Inf), initial derivative at lowest point must be positive")
[?2004l[?2004h>   }
[?2004l[?2004h>   if (is.infinite(ub) && h_prime[length(h_prime)] >= 0) {
[?2004l[?2004h>     stop("For unbounded upper domain (ub = Inf), initial derivative at highest point must be negative")
[?2004l[?2004h>   }
[?2004l[?2004h>   
[?2004l[?2004h>   z <- compute_intersections(x, h, h_prime, lb, ub)
[?2004l[?2004h>   I <- compute_envelope_integrals(x, h, h_prime, z)
[?2004l[?2004h>   
[?2004l[?2004h>   samples <- numeric(n)
[?2004l[?2004h>   n_accepted <- 0
[?2004l[?2004h>   
[?2004l[?2004h>   while (n_accepted < n) {
[?2004l[?2004h>     samp_res <- sample_upper_envelope(x, h, h_prime, z, I)
[?2004l[?2004h>     x_cand <- samp_res$x_cand
[?2004l[?2004h>     j <- samp_res$j
[?2004l[?2004h>     
[?2004l[?2004h>     u_val <- h[j] + (x_cand - x[j]) * h_prime[j]
[?2004l[?2004h>     
[?2004l[?2004h>     if (x_cand >= x[1] && x_cand <= x[length(x)]) {
[?2004l[?2004h>       idx <- findInterval(x_cand, x, rightmost.closed = TRUE)
[?2004l[?2004h>       if (idx == length(x)) idx <- length(x) - 1
[?2004l[?2004h>       l_val <- ((x[idx + 1] - x_cand) * h[idx] + (x_cand - x[idx]) * h[idx + 1]) / (x[idx + 1] - x[idx])
[?2004l[?2004h>     } else {
[?2004l[?2004h>       l_val <- -Inf
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     w <- runif(1)
[?2004l[?2004h>     log_w <- log(w)
[?2004l[?2004h>     
[?2004l[?2004h>     if (l_val > -Inf && log_w <= l_val - u_val) {
[?2004l[?2004h>       n_accepted <- n_accepted + 1
