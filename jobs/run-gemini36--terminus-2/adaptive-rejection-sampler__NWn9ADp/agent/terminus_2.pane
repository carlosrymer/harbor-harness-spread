[?2004l[?2004h> compute_integrals <- function(x, h, h_prime, z) {
[?2004l[?2004h>   k <- length(x)
[?2004l[?2004h>   I <- numeric(k)
[?2004l[?2004h>   for (i in 1:k) {
[?2004l[?2004h>     b <- h_prime[i]
[?2004l[?2004h>     z_lower <- z[i]
[?2004l[?2004h>     z_upper <- z[i + 1]
[?2004l[?2004h>     
[?2004l[?2004h>     u_lower <- if (is.infinite(z_lower)) -Inf else h[i] + (z_lower - x[i]) * b
[?2004l[?2004h>     u_upper <- if (is.infinite(z_upper)) -Inf else h[i] + (z_upper - x[i]) * b
[?2004l[?2004h>     
[?2004l[?2004h>     if (abs(b) < 1e-10) {
[?2004l[?2004h>       I[i] <- exp(h[i]) * (z_upper - z_lower)
[?2004l[?2004h>     } else if (is.infinite(z_upper)) {
[?2004l[?2004h>       I[i] <- exp(u_lower) / (-b)
[?2004l[?2004h>     } else if (is.infinite(z_lower)) {
[?2004l[?2004h>       I[i] <- exp(u_upper) / b
[?2004l[?2004h>     } else {
[?2004l[?2004h>       u_max <- max(u_lower, u_upper)
