[?2004l[?2004h>       h_prime_cand <- res_cand$h_prime
[?2004l[?2004h>       
[?2004l[?2004h>       accepted <- (log_w <= h_cand - u_val)
[?2004l[?2004h>       if (accepted) {
[?2004l[?2004h>         n_accepted <- n_accepted + 1
