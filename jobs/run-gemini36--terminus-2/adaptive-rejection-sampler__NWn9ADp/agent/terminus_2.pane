[?2004l[?2004h>       }
[?2004l[?2004h>       
[?2004l[?2004h>       insert_pos <- findInterval(x_cand, x) + 1
[?2004l[?2004h>       x <- append(x, x_cand, after = insert_pos - 1)
[?2004l[?2004h>       h <- append(h, h_cand, after = insert_pos - 1)
[?2004l[?2004h>       h_prime <- append(h_prime, h_prime_cand, after = insert_pos - 1)
