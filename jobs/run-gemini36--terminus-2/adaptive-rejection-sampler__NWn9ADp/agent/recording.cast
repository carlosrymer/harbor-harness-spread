[195.799233, "i", "cat << 'EOF' > /tmp/test_sample_envelope.R\nsample_candidate <- function(x, h, h_prime, z, I) {\n  k <- length(x)\n  I_tot <- sum(I)\n  p <- I / I_tot\n  cum_p <- c(0, cumsum(p))\n  \n  u_rand <- runif(1)\n  j <- findInterval(u_rand, cum_p, rightmost.closed = TRUE)\n  if (j < 1) j <- 1\n  if (j > k) j <- k\n  \n  u_prime <- (u_rand - cum_p[j]) / p[j]\n  u_prime <- min(max(u_prime, 1e-15), 1 - 1e-15)\n  \n  b <- h_prime[j]\n  z_lower <- z[j]\n  z_upper <- z[j + 1]\n  \n  if (abs(b) < 1e-10) {\n    x_cand <- z_lower + u_prime * (z_upper - z_lower)\n  } else if (is.infinite(z_upper)) {\n    x_cand <- z_lower + log(1 - u_prime) / b\n  } else if (is.infinite(z_lower)) {\n    x_cand <- z_upper + log(u_prime) / b\n  } else {\n    delta <- z_upper - z_lower\n    b_delta <- b * delta\n    if (b > 0) {\n      x_cand <- z_lower + log1p(u_prime * expm1(b_delta)) / b\n    } else {\n      x_cand <- z_upper + log1p((1 - u_prime) * expm1(-b_delta)) / b\n    }\n  }\n  return(list(x_cand = x_cand, j = j))\n}\n\nx <- c(-1, 0, 1)\nh <- log(dnorm(x))\nh_p <- -x\nz <- c(-Inf, -0.5, 0.5, Inf)\nI <- c(0.3989423, 0.3989423, 0.3989423)\n\nsamples <- replicate(10000, sample_candidate(x, h, h_p, z, I)$x_cand)\ncat(\"Mean:\", mean(samples), \"SD:\", sd(samples), \"\\n\")\nEOF\nRscript /tmp/test_sample_envelope.R\n"]
