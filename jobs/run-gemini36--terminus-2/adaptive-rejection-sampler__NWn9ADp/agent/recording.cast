[311.614743, "i", "cat << 'EOF' > /tmp/test_eps.R\neval_g <- function(g, x_val, ...) {\n  if (is.function(g)) return(g(x_val, ...))\n  if (is.character(g)) return(match.fun(g)(x_val, ...))\n  if (is.expression(g) || is.call(g) || is.language(g)) return(eval(g, list(x = x_val, ...)))\n  stop(\"'g' must be a function, function name string, or expression\")\n}\n\neval_h_and_prime_safe <- function(g, x, lb = -Inf, ub = Inf, eps_default = 1e-5, ...) {\n  f_vals <- eval_g(g, x, ...)\n  if (any(is.na(f_vals)) || any(f_vals < 0)) {\n    stop(\"Density function returned invalid (NA or negative) values\")\n  }\n  \n  f_vals_safe <- ifelse(f_vals == 0, 1e-300, f_vals)\n  h_vals <- log(f_vals_safe)\n  \n  dist_lb <- if (is.finite(lb)) (x - lb) / 2 else eps_default\n  dist_ub <- if (is.finite(ub)) (ub - x) / 2 else eps_default\n  eps <- pmin(eps_default, dist_lb, dist_ub)\n  eps <- pmax(eps, 1e-10)\n  \n  f_plus <- eval_g(g, x + eps, ...)\n  f_minus <- eval_g(g, x - eps, ...)\n  \n  f_plus_safe <- ifelse(f_plus == 0, 1e-300, f_plus)\n  f_minus_safe <- ifelse(f_minus == 0, 1e-300, f_minus)\n  \n  h_plus <- log(f_plus_safe)\n  h_minus <- log(f_minus_safe)\n  \n  h_prime_vals <- (h_plus - h_minus) / (2 * eps)\n  \n  return(list(f = f_vals, h = h_vals, h_prime = h_prime_vals))\n}\n\nprint(eval_h_and_prime_safe(dexp, 1e-7, lb = 0))\nEOF\nRscript /tmp/test_eps.R\n"]
