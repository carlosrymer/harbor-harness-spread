[284.783938, "i", "cat << 'EOF' > /app/ars.R\n# Adaptive Rejection Sampling (ARS) Implementation\n# Reference: Gilks, W. R., & Wild, P. (1992).\n\neval_g <- function(g, x_val, ...) {\n  if (is.function(g)) {\n    return(g(x_val, ...))\n  } else if (is.character(g)) {\n    g_fn <- match.fun(g)\n    return(g_fn(x_val, ...))\n  } else if (is.expression(g) || is.call(g) || is.language(g)) {\n    env <- list(x = x_val, ...)\n    return(eval(g, envir = env))\n  } else {\n    stop(\"'g' must be a function, function name string, or expression\")\n  }\n}\n\neval_h_and_prime <- function(g, x, eps = 1e-5, ...) {\n  f_vals <- eval_g(g, x, ...)\n  if (any(is.na(f_vals)) || any(f_vals < 0)) {\n    stop(\"Density function returned invalid (NA or negative) values\")\n  }\n  \n  f_vals_safe <- ifelse(f_vals == 0, 1e-300, f_vals)\n  h_vals <- log(f_vals_safe)\n  \n  f_plus <- eval_g(g, x + eps, ...)\n  f_minus <- eval_g(g, x - eps, ...)\n  \n  f_plus_safe <- ifelse(f_plus == 0, 1e-300, f_plus)\n  f_minus_safe <- ifelse(f_minus == 0, 1e-300, f_minus)\n  \n  h_plus <- log(f_plus_safe)\n  h_minus <- log(f_minus_safe)\n  \n  h_prime_vals <- (h_plus - h_minus) / (2 * eps)\n  \n  return(list(f = f_vals, h = h_vals, h_prime = h_prime_vals))\n}\n\nvalidate_inputs <- function(g, n, lb, ub, x) {\n  if (!is.numeric(n) || length(n) != 1 || is.na(n) || n <= 0 || n != as.integer(n)) {\n    stop(\"Invalid sample count: 'n' must be a positive integer\")\n  }\n  if (!is.numeric(lb) || length(lb) != 1 || is.na(lb) ||\n      !is.numeric(ub) || length(ub) != 1 || is.na(ub) || lb >= ub) {\n    stop(\"Invalid domain: 'lb' must be strictly less than 'ub'\")\n  }\n  if (!is.null(x)) {\n    if (!is.numeric(x) || length(x) < 2) {\n      stop(\"Initial points 'x' must be a numeric vector of length at least 2\")\n    }\n    if (any(x <= lb) || any(x >= ub)) {\n      stop(\"Initial points 'x' must lie strictly within domain (lb, ub)\")\n    }\n  }\n  TRUE\n}\n\ncheck_log_concavity <- function(x, h_prime, tol = 1e-5) {\n  if (length(x) < 2) return(TRUE)\n  diffs <- diff(h_prime)\n  if (any(diffs > tol)) {\n    stop(\"Density is not log-concave: derivative of log-density is increasing\")\n  }\n  TRUE\n}\n\ncompute_intersections <- function(x, h, h_prime, lb, ub) {\n  k <- length(x)\n  z <- numeric(k + 1)\n  z[1] <- lb\n  z[k + 1] <- ub\n  if (k > 1) {\n    for (i in 1:(k - 1)) {\n      dh_p <- h_prime[i] - h_prime[i + 1]\n      if (abs(dh_p) < 1e-12) {\n        z[i + 1] <- (x[i] + x[i + 1]) / 2\n      } else {\n        z[i + 1] <- (h[i + 1] - h[i] - x[i + 1] * h_prime[i + 1] + x[i] * h_prime[i]) / dh_p\n      }\n    }\n  }\n  z\n}\n\ncompute_envelope_integrals <- function(x, h, h_prime, z) {\n  k <- length(x)\n  I <- numeric(k)\n  for (i in 1:k) {\n    b <- h_prime[i]\n    z_lower <- z[i]\n    z_upper <- z[i + 1]\n    \n    u_lower <- if (is.infinite(z_lower)) -Inf else h[i] + (z_lower - x[i]) * b\n    u_upper <- if (is.infinite(z_upper)) -Inf else h[i] + (z_upper - x[i]) * b\n    \n    if (abs(b) < 1e-10) {\n      I[i] <- exp(h[i]) * (z_upper - z_lower)\n    } else if (is.infinite(z_upper)) {\n      I[i] <- exp(u_lower) / (-b)\n    } else if (is.infinite(z_lower)) {\n      I[i] <- exp(u_upper) / b\n    } else {\n      u_max <- max(u_lower, u_upper)\n      I[i] <- (exp(u_max) / b) * (exp(u_upper - u_max) - exp(u_lower - u_max))\n    }\n  }\n  I\n}\n\nsample_upper_envelope <- function(x, h, h_prime, z, I) {\n  k <- length(x)\n  I_tot <- sum(I)\n  if (is.na(I_tot) || I_tot <= 0) {\n    stop(\"Envelope integral is invalid or zero\")\n  }\n  p <- I / I_tot\n  cum_p <- c(0, cumsum(p))\n  \n  u_rand <- runif(1)\n  j <- findInterval(u_rand, cum_p, rightmost.closed = TRUE)\n  if (j < 1) j <- 1\n  if (j > k) j <- k\n  \n  u_prime <- (u_rand - cum_p[j]) / p[j]\n  u_prime <- min(max(u_prime, 1e-15), 1 - 1e-15)\n  \n  b <- h_prime[j]\n  z_lower <- z[j]\n  z_upper <- z[j + 1]\n  \n  if (abs(b) < 1e-10) {\n    x_cand <- z_lower + u_prime * (z_upper - z_lower)\n  } else if (is.infinite(z_upper)) {\n    x_cand <- z_lower + log(1 - u_prime) / b\n  } else if (is.infinite(z_lower)) {\n    x_cand <- z_upper + log(u_prime) / b\n  } else {\n    delta <- z_upper - z_lower\n    b_delta <- b * delta\n    if (b > 0) {\n      x_cand <- z_lower + log1p(u_prime * expm1(b"]
[284.784379, "i", "_delta)) / b\n    } else {\n      x_cand <- z_upper + log1p((1 - u_prime) * expm1(-b_delta)) / b\n    }\n  }\n  \n  return(list(x_cand = x_cand, j = j))\n}\n\nars <- function(g, n, lb = -Inf, ub = Inf, x = NULL, ...) {\n  validate_inputs(g, n, lb, ub, x)\n  \n  if (is.null(x)) {\n    if (is.finite(lb) && is.finite(ub)) {\n      x <- seq(lb + 0.25 * (ub - lb), ub - 0.25 * (ub - lb), length.out = 3)\n    } else if (is.finite(lb)) {\n      x <- c(lb + 0.5, lb + 1.5, lb + 3.0)\n    } else if (is.finite(ub)) {\n      x <- c(ub - 3.0, ub - 1.5, ub - 0.5)\n    } else {\n      x <- c(-1.0, 0.0, 1.0)\n    }\n  } else {\n    x <- sort(unique(x))\n    if (length(x) < 2) {\n      stop(\"Initial points 'x' must contain at least 2 distinct values\")\n    }\n  }\n  \n  res <- eval_h_and_prime(g, x, ...)\n  h <- res$h\n  h_prime <- res$h_prime\n  \n  check_log_concavity(x, h_prime)\n  \n  if (is.infinite(lb) && h_prime[1] <= 0) {\n    stop(\"For unbounded lower domain (lb = -Inf), initial derivative at lowest point must be positive\")\n  }\n  if (is.infinite(ub) && h_prime[length(h_prime)] >= 0) {\n    stop(\"For unbounded upper domain (ub = Inf), initial derivative at highest point must be negative\")\n  }\n  \n  z <- compute_intersections(x, h, h_prime, lb, ub)\n  I <- compute_envelope_integrals(x, h, h_prime, z)\n  \n  samples <- numeric(n)\n  n_accepted <- 0\n  \n  while (n_accepted < n) {\n    samp_res <- sample_upper_envelope(x, h, h_prime, z, I)\n    x_cand <- samp_res$x_cand\n    j <- samp_res$j\n    \n    u_val <- h[j] + (x_cand - x[j]) * h_prime[j]\n    \n    if (x_cand >= x[1] && x_cand <= x[length(x)]) {\n      idx <- findInterval(x_cand, x, rightmost.closed = TRUE)\n      if (idx == length(x)) idx <- length(x) - 1\n      l_val <- ((x[idx + 1] - x_cand) * h[idx] + (x_cand - x[idx]) * h[idx + 1]) / (x[idx + 1] - x[idx])\n    } else {\n      l_val <- -Inf\n    }\n    \n    w <- runif(1)\n    log_w <- log(w)\n    \n    if (l_val > -Inf && log_w <= l_val - u_val) {\n      n_accepted <- n_accepted + 1\n      samples[n_accepted] <- x_cand\n    } else {\n      res_cand <- eval_h_and_prime(g, x_cand, ...)\n      h_cand <- res_cand$h\n      h_prime_cand <- res_cand$h_prime\n      \n      accepted <- (log_w <= h_cand - u_val)\n      if (accepted) {\n        n_accepted <- n_accepted + 1\n        samples[n_accepted] <- x_cand\n      }\n      \n      insert_pos <- findInterval(x_cand, x) + 1\n      x <- append(x, x_cand, after = insert_pos - 1)\n      h <- append(h, h_cand, after = insert_pos - 1)\n      h_prime <- append(h_prime, h_prime_cand, after = insert_pos - 1)\n      \n      check_log_concavity(x, h_prime)\n      \n      z <- compute_intersections(x, h, h_prime, lb, ub)\n      I <- compute_envelope_integrals(x, h, h_prime, z)\n    }\n  }\n  \n  return(samples)\n}\n\ntest <- function() {\n  cat(\"=========================================\\n\")\n  cat(\"   ARS Implementation Formal Tests\\n\")\n  cat(\"=========================================\\n\\n\")\n  \n  all_passed <- TRUE\n  \n  cat(\"Running Test: Standard Normal Distribution...\\n\")\n  tryCatch({\n    set.seed(42)\n    norm_samples <- ars(dnorm, 5000)\n    m_norm <- mean(norm_samples)\n    sd_norm <- sd(norm_samples)\n    \n    write.table(norm_samples, file = \"/app/normal_samples.txt\", row.names = FALSE, col.names = FALSE)\n    \n    if (abs(m_norm - 0) < 0.1 && abs(sd_norm - 1) < 0.1) {\n      cat(sprintf(\"TEST_NORMAL: PASS | Mean: %.4f (Expected: 0.0000), SD: %.4f (Expected: 1.0000)\\n\", m_norm, sd_norm))\n    } else {\n      cat(sprintf(\"TEST_NORMAL: FAIL | Mean: %.4f, SD: %.4f\\n\", m_norm, sd_norm))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_NORMAL: FAIL | Error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\nRunning Test: Exponential Distribution...\\n\")\n  tryCatch({\n    set.seed(42)\n    exp_samples <- ars(dexp, 5000, lb = 0)\n    m_exp <- mean(exp_samples)\n    sd_exp <- sd(exp_samples)\n    \n    write.table(exp_samples, file = \"/app/exponential_samples.txt\", row.names = FALSE, col.names = FALSE)\n    \n    if (abs(m_exp - 1) < 0.1 && abs(sd_exp - 1) < 0.1) {\n      cat(sprintf(\"TEST_EXPONENTIAL: PASS | Mean: %.4f (Expected: 1.0000), SD: %.4f (Expected:"]
[284.784496, "i", " 1.0000)\\n\", m_exp, sd_exp))\n    } else {\n      cat(sprintf(\"TEST_EXPONENTIAL: FAIL | Mean: %.4f, SD: %.4f\\n\", m_exp, sd_exp))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_EXPONENTIAL: FAIL | Error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\nRunning Test: Uniform Distribution...\\n\")\n  tryCatch({\n    set.seed(42)\n    unif_samples <- ars(dunif, 5000, lb = 0, ub = 1)\n    m_unif <- mean(unif_samples)\n    sd_unif <- sd(unif_samples)\n    exp_sd_unif <- sqrt(1/12)\n    \n    if (abs(m_unif - 0.5) < 0.05 && abs(sd_unif - exp_sd_unif) < 0.05) {\n      cat(sprintf(\"TEST_UNIFORM: PASS | Mean: %.4f (Expected: 0.5000), SD: %.4f (Expected: %.4f)\\n\", m_unif, sd_unif, exp_sd_unif))\n    } else {\n      cat(sprintf(\"TEST_UNIFORM: FAIL | Mean: %.4f, SD: %.4f\\n\", m_unif, sd_unif))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_UNIFORM: FAIL | Error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\nRunning Test: Non-Log-Concave Density Detection...\\n\")\n  tryCatch({\n    non_lc <- function(x) exp(x^3)\n    err_caught <- FALSE\n    tryCatch({\n      ars(non_lc, 100, lb = 0, ub = 2, x = c(0.5, 1.0, 1.5))\n    }, error = function(e) {\n      err_caught <<- TRUE\n    })\n    \n    if (err_caught) {\n      cat(\"TEST_NON_LOG_CONCAVE: PASS | Correctly detected non-log-concave density and raised error\\n\")\n    } else {\n      cat(\"TEST_NON_LOG_CONCAVE: FAIL | Did not raise error on non-log-concave density\\n\")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_NON_LOG_CONCAVE: FAIL | Unexpected error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\nRunning Test: Invalid Inputs Validation...\\n\")\n  tryCatch({\n    invalid_n_caught <- FALSE\n    invalid_domain_caught <- FALSE\n    \n    tryCatch(ars(dnorm, n = -5), error = function(e) invalid_n_caught <<- TRUE)\n    tryCatch(ars(dnorm, n = 100, lb = 5, ub = 2), error = function(e) invalid_domain_caught <<- TRUE)\n    \n    if (invalid_n_caught && invalid_domain_caught) {\n      cat(\"TEST_INVALID_INPUTS: PASS | Correctly caught invalid sample count and domain boundaries\\n\")\n    } else {\n      cat(\"TEST_INVALID_INPUTS: FAIL | Failed to catch invalid inputs\\n\")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_INVALID_INPUTS: FAIL | Unexpected error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\n=========================================\\n\")\n  if (all_passed) {\n    cat(\"  ALL TESTS PASSED SUCCESSFULLY!\\n\")\n  } else {\n    cat(\"  SOME TESTS FAILED!\\n\")\n  }\n  cat(\"=========================================\\n\")\n}\n\nif (!interactive()) {\n  test()\n}\nEOF\nRscript /app/ars.R\n"]
[284.789389, "o", "cat << 'EOF' > /app/ars.R\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.789663, "o", "# Adaptive Rejection Sampling (ARS) Implementation\r\n"]
[284.789736, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.790791, "o", "# Reference: Gilks, W. R., & Wild, P. (1992).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> eval_g <- function(g, x_val, ...) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (is.function(g)) {\r\n\u001b[?2004l\r\u001b[?2004h>     return(g(x_val, ...))\r\n\u001b[?2004l\r\u001b[?2004h>   } else if (is.character(g)) {\r\n\u001b[?2004l\r\u001b[?2004h>     g_fn <- match.fun(g)\r\n\u001b[?2004l\r\u001b[?2004h>     return(g_fn(x_val, ...))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.79104, "o", "  } else if (is.expression(g) || is.call(g) || is.language(g)) {\r\n"]
[284.79113, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.791236, "o", "    env <- list(x = x_val, ...)\r\n"]
[284.791383, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.791464, "o", "    return(eval(g, envir = env))\r\n"]
[284.791528, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.791593, "o", "  } else {\r\n"]
[284.791824, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.791919, "o", "    stop(\"'g' must be a function, function name string, or expression\")\r\n"]
[284.791973, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.792033, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.792667, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.793027, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.793201, "o", "eval_h_and_prime <- function(g, x, eps = 1e-5, ...) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.793393, "o", "  f_vals <- eval_g(g, x, ...)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.793632, "o", "  if (any(is.na(f_vals)) || any(f_vals < 0)) {\r\n"]
[284.793728, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.793958, "o", "    stop(\"Density function returned invalid (NA or negative) values\")\r\n"]
[284.794065, "o", "\u001b[?2004l\r\u001b[?2004h"]
[284.79421, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.794251, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.794671, "o", "  f_vals_safe <- ifelse(f_vals == 0, 1e-300, f_vals)\r\n"]
[284.79476, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.79486, "o", "  h_vals <- log(f_vals_safe)\r\n"]
[284.794914, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.795049, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h"]
[284.795116, "o", "> "]
[284.795246, "o", "  f_plus <- eval_g(g, x + eps, ...)"]
[284.795407, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.795641, "o", "  f_minus <- eval_g(g, x - eps, ...)\r\n\u001b[?2004l\r"]
[284.795847, "o", "\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.795953, "o", "  f_plus_safe <- ifelse(f_plus == 0, 1e-300, f_plus)"]
[284.796001, "o", "\r\n"]
[284.796045, "o", "\u001b[?2004l\r\u001b[?2004h"]
[284.796322, "o", "> "]
[284.796582, "o", "  f_minus_safe <- ifelse(f_minus == 0, 1e-300, f_minus)\r\n"]
[284.796663, "o", "\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.796746, "o", "  h_plus <- log(f_plus_safe)\r\n"]
[284.796916, "o", "\u001b[?2004l\r\u001b[?2004h"]
[284.79699, "o", ">   h_minus <- log(f_minus_safe)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r"]
[284.797211, "o", "\u001b[?2004h> "]
[284.79744, "o", "  h_prime_vals <- (h_plus - h_minus) / (2 * eps)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.797631, "o", "  return(list(f = f_vals, h = h_vals, h_prime = h_prime_vals))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.797667, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.797688, "o", "> \r\n\u001b[?2004l\r"]
[284.797726, "o", "\u001b[?2004h> "]
[284.798089, "o", "validate_inputs <- function(g, n, lb, ub, x) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.798456, "o", "  if (!is.numeric(n) || length(n) != 1 || is.na(n) || n <= 0 || n != as.integer(n)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.798588, "o", "    stop(\"Invalid sample count: 'n' must be a positive integer\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.798653, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.798952, "o", "  if (!is.numeric(lb) || length(lb) != 1 || is.na(lb) ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.799215, "o", "      !is.numeric(ub) || length(ub) != 1 || is.na(ub) || lb >= ub) {\r\n\u001b[?2004l\r"]
[284.799309, "o", "\u001b[?2004h> "]
[284.80036, "o", "    stop(\"Invalid domain: 'lb' must be strictly less than 'ub'\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.800604, "o", "> "]
[284.800767, "o", "  }\r\n\u001b[?2004l\r  id"]
[284.800829, "o", "\u001b[?2004h> "]
[284.801007, "o", "  if (!is.null(x)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.801327, "o", "    if (!is.numeric(x) || length(x) < 2) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.801436, "o", "> "]
[284.80165, "o", "      stop(\"Initial points 'x' must be a numeric vector of length at least 2\")\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[284.80185, "o", "\u001b[?2004h>     if (any(x <= lb) || any(x >= ub)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.802108, "o", "      stop(\"Initial points 'x' must lie strictly within domain (lb, ub)\")\r\n\u001b[?2004l\r"]
[284.802281, "o", "\u001b[?2004h> "]
[284.802596, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   TRUE\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.802662, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.802951, "o", "check_log_concavity <- function(x, h_prime, tol = 1e-5) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.803094, "o", "  if (length(x) < 2) return(TRUE)\r\n\u001b[?2004l\r\u001b[?2004h>   diffs <- diff(h_prime)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.803217, "o", "  if (any(diffs > tol)) {\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"Density is not log-concave: derivative of log-density is increasing\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.803363, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h>   TRUE\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.803484, "o", "compute_intersections <- function(x, h, h_prime, lb, ub) {\r\n\u001b[?2004l\r\u001b[?2004h>   k <- length(x)\r\n\u001b[?2004l\r\u001b[?2004h>   z <- numeric(k + 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.803597, "o", "  z[1] <- lb\r\n\u001b[?2004l\r\u001b[?2004h>   z[k + 1] <- ub\r\n\u001b[?2004l\r\u001b[?2004h>   if (k > 1) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.803704, "o", "    for (i in 1:(k - 1)) {\r\n\u001b[?2004l\r\u001b[?2004h>       dh_p <- h_prime[i] - h_prime[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.803831, "o", "      if (abs(dh_p) < 1e-12) {\r\n\u001b[?2004l\r\u001b[?2004h>         z[i + 1] <- (x[i] + x[i + 1]) / 2\r\n\u001b[?2004l\r\u001b[?2004h>       } else {\r\n\u001b[?2004l\r"]
[284.803931, "o", "\u001b[?2004h> "]
[284.804033, "o", "        z[i + 1] <- (h[i + 1] - h[i] - x[i + 1] * h_prime[i + 1] + x[i] * h_prime[i]) / dh_p\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.804157, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h>   z\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.80425, "o", "compute_envelope_integrals <- function(x, h, h_prime, z) {\r\n\u001b[?2004l\r\u001b[?2004h>   k <- length(x)\r\n\u001b[?2004l\r\u001b[?2004h>   I <- numeric(k)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.804422, "o", ">   for (i in 1:k) {\r\n\u001b[?2004l\r\u001b[?2004h>     b <- h_prime[i]\r\n\u001b[?2004l\r\u001b[?2004h>     z_lower <- z[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.804544, "o", "    z_upper <- z[i + 1]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.804673, "o", "    u_lower <- if (is.infinite(z_lower)) -Inf else h[i] + (z_lower - x[i]) * b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.804774, "o", "    u_upper <- if (is.infinite(z_upper)) -Inf else h[i] + (z_upper - x[i]) * b\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if (abs(b) < 1e-10) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.804911, "o", "      I[i] <- exp(h[i]) * (z_upper - z_lower)\r\n\u001b[?2004l\r\u001b[?2004h>     } else if (is.infinite(z_upper)) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.804998, "o", ">       I[i] <- exp(u_lower) / (-b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.805092, "o", "    } else if (is.infinite(z_lower)) {\r\n\u001b[?2004l\r\u001b[?2004h>       I[i] <- exp(u_upper) / b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.805168, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h>       u_max <- max(u_lower, u_upper)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.805302, "o", "> "]
[284.805405, "o", "      I[i] <- (exp(u_max) / b) * (exp(u_upper - u_max) - exp(u_lower - u_max))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   I\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.80551, "o", "sample_upper_envelope <- function(x, h, h_prime, z, I) {\r\n\u001b[?2004l\r\u001b[?2004h>   k <- length(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.805579, "o", ">   I_tot <- sum(I)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.805654, "o", "  if (is.na(I_tot) || I_tot <= 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.80572, "o", "    stop(\"Envelope integral is invalid or zero\")\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   p <- I / I_tot\r\n\u001b[?2004l\r"]
[284.80581, "o", "\u001b[?2004h>   cum_p <- c(0, cumsum(p))\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.805905, "o", "  u_rand <- runif(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.805978, "o", "  j <- findInterval(u_rand, cum_p, rightmost.closed = TRUE)\r\n\u001b[?2004l\r\u001b[?2004h>   if (j < 1) j <- 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.806064, "o", "  if (j > k) j <- k\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.806177, "o", "  u_prime <- (u_rand - cum_p[j]) / p[j]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.80684, "o", "  u_prime <- min(max(u_prime, 1e-15), 1 - 1e-15)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   b <- h_prime[j]\r\n\u001b[?2004l\r\u001b[?2004h>   z_lower <- z[j]\r\n\u001b[?2004l\r\u001b[?2004h>   z_upper <- z[j + 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.810027, "o", "> "]
[284.810292, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.814544, "o", "  if (abs(b) < 1e-10) {\r\n\u001b[?2004l\r\u001b[?2004h>     x_cand <- z_lower + u_prime * (z_upper - z_lower)\r\n\u001b[?2004l\r\u001b[?2004h>   } else if (is.infinite(z_upper)) {\r\n\u001b[?2004l\r   wr\u001b[?2004h>     x_cand <- z_lower + log(1 - u_prime) / b\r\n\u001b[?2004l\r\u001b[?2004h>   } else if (is.infinite(z_lower)) {\r\n\u001b[?2004l\r\u001b[?2004h>     x_cand <- z_upper + log(u_prime) / b\r\n\u001b[?2004l\r\u001b[?2004h>   } else {\r\n\u001b[?2004l\r \u001b[?2004h>     delta <- z_upper - z_lower\r\n\u001b[?2004l\r\u001b[?2004h>     b_delta <- b * delta\r\n\u001b[?2004l\rPO\u001b[?2004h>     if (b > 0) {\r\n\u001b[?2004l\r M\u001b[?2004h>       x_cand <- z_lower + log1p(u_prime * expm1(b_delta)) / b\r\n\u001b[?2004l\r, \u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       x_cand <- z_upper + log1p((1 - u_prime) * expm1(-b_delta)) / b\r\n\u001b[?2004l\rMean: %.4\u001b[?2004h>     }\r\n\u001b[?2004l\rf, SD:\u001b[?2004h>   }\r\n\u001b[?2004l\r %.4\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.81469, "o", "  return(list(x_cand = x_cand, j = j))"]
[284.814783, "o", "\r\n"]
[284.814901, "o", "\u001b[?2004l\r"]
[284.818491, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ars <- function(g, n, lb = -Inf, ub = Inf, x = NULL, ...) {\r\n\u001b[?2004l\r\u001b[?2004h>   validate_inputs(g, n, lb, ub, x)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   if (is.null(x)) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (is.finite(lb) && is.finite(ub)) {\r\n\u001b[?2004l\r\u001b[?2004h>       x <- seq(lb + 0.25 * (ub - lb), ub - 0.25 * (ub - lb), length.out = 3)\r\n\u001b[?2004l\r\u001b[?2004h>     } else if (is.finite(lb)) {\r\n\u001b[?2004l\r\u001b[?2004h>       x <- c(lb + 0.5, lb + 1.5, lb + 3.0)\r\n\u001b[?2004l\r\u001b[?2004h>     } else if (is.finite(ub)) {\r\n\u001b[?2004l\r\u001b[?2004h>       x <- c(ub - 3.0, ub - 1.5, ub - 0.5)\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       x <- c(-1.0, 0.0, 1.0)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   } else {\r\n\u001b[?2004l\r\u001b[?2004h>     x <- sort(unique(x))\r\n\u001b[?2004l\r\u001b[?2004h>     if (length(x) < 2) {\r\n\u001b[?2004l\r\u001b[?2004h>       stop(\"Initial points 'x' must contain at least 2 distinct values\")\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   res <- eval_h_and_prime(g, x, ...)\r\n\u001b[?2004l\r\u001b[?2004h>   h <- res$h\r\n\u001b[?2004l\r\u001b[?2004h>   h_prime <- res$h_prime\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   check_log_concavity(x, h_prime)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   if (is.infinite(lb) && h_prime[1] <= 0) {\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"For unbounded lower domain (lb = -Inf), initial derivative at lowest point must be positive\")\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (is.infinite(ub) && h_prime[length(h_prime)] >= 0) {\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"For unbounded upper domain (ub = Inf), initial derivative at highest point must be negative\")\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   z <- compute_intersections(x, h, h_prime, lb, ub)\r\n\u001b[?2004l\r\u001b[?2004h>   I <- compute_envelope_integrals(x, h, h_prime, z)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   samples <- numeric(n)\r\n\u001b[?2004l\r\u001b[?2004h>   n_accepted <- 0\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   while (n_accepted < n) {\r\n\u001b[?2004l\r\u001b[?2004h>     samp_res <- sample_upper_envelope(x, h, h_prime, z, I)\r\n\u001b[?2004l\r\u001b[?2004h>     x_cand <- samp_res$x_cand\r\n\u001b[?2004l\r\u001b[?2004h>     j <- samp_res$j\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     u_val <- h[j] + (x_cand - x[j]) * h_prime[j]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if (x_cand >= x[1] && x_cand <= x[length(x)]) {\r\n\u001b[?2004l\r\u001b[?2004h>       idx <- findInterval(x_cand, x, rightmost.closed = TRUE)\r\n\u001b[?2004l\r\u001b[?2004h>       if (idx == length(x)) idx <- length(x) - 1\r\n\u001b[?2004l\r\u001b[?2004h>       l_val <- ((x[idx + 1] - x_cand) * h[idx] + (x_cand - x[idx]) * h[idx + 1]) / (x[idx + 1] - x[idx])\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       l_val <- -Inf\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     w <- runif(1)\r\n\u001b[?2004l\r\u001b[?2004h>     log_w <- log(w)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if (l_val > -Inf && log_w <= l_val - u_val) {\r\n\u001b[?2004l\r\u001b[?2004h>       n_accepted <- n_accepted + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.818656, "o", "      samples[n_accepted] <- x_cand\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.818733, "o", "    } else {"]
[284.818762, "o", "\r\n"]
[284.818789, "o", "\u001b[?2004l\r"]
[284.818828, "o", "\u001b[?2004h"]
[284.818873, "o", "> "]
[284.819241, "o", "      res_cand <- eval_h_and_prime(g, x_cand, ...)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.81931, "o", "> "]
[284.81946, "o", "      h_cand <- res_cand$h"]
[284.819648, "o", "\r\n"]
[284.819684, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.820007, "o", "      h_prime_cand <- res_cand$h_prime\r\n\u001b[?2004l\r"]
[284.820196, "o", "\u001b[?2004h>       \r\n\u001b[?2004l\r\u001b[?2004h"]
[284.820439, "o", "> "]
[284.820674, "o", "      accepted <- (log_w <= h_cand - u_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.820821, "o", "      if (accepted) {\r\n\u001b[?2004l\r\u001b[?2004h>         n_accepted <- n_accepted + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.820948, "o", "> "]
[284.821114, "o", "        samples[n_accepted] <- x_cand\r\n\u001b[?2004l\r"]
[284.821281, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.82142, "o", ">       \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.821845, "o", "      insert_pos <- findInterval(x_cand, x) + 1\r\n"]
[284.822117, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.822286, "o", "      x <- append(x, x_cand, after = insert_pos - 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.82254, "o", "> "]
[284.822772, "o", "      h <- append(h, h_cand, after = insert_pos - 1)\r\n"]
[284.822963, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.823099, "o", "      h_prime <- append(h_prime, h_prime_cand, after = insert_pos - 1)\r\n"]
[284.823314, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[284.823515, "o", "      \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.823667, "o", "      check_log_concavity(x, h_prime)\r\n\u001b[?2004l\r\u001b[?2004h>       \r\n\u001b[?2004l\r"]
[284.823749, "o", "\u001b[?2004h> "]
[284.823947, "o", "      z <- compute_intersections(x, h, h_prime, lb, ub)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.824208, "o", "      I <- compute_envelope_integrals(x, h, h_prime, z)\r\n"]
[284.824374, "o", "\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[284.824514, "o", "\u001b[?2004h> "]
[284.824664, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.824733, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h>   return(samples)"]
