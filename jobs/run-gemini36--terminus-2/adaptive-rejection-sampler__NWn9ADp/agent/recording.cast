[284.825098, "o", "test <- function() {"]
[284.825353, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   cat(\"=========================================\\n\")"]
[284.825565, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   cat(\"   ARS Implementation Formal Tests\\n\")\r\n"]
[284.825686, "o", "\u001b[?2004l\r\u001b[?2004h>   cat(\"=========================================\\n\\n\")"]
[284.826408, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.826686, "o", "  \r\n\u001b[?2004l\r\u001b[?2004h>   all_passed <- TRUE\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   cat(\"Running Test: Standard Normal Distribution...\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>   tryCatch({\r\n\u001b[?2004l\r\u001b[?2004h>     set.seed(42)\r\n\u001b[?2004l\r\u001b[?2004h>     norm_samples <- ars(dnorm, 5000)\r\n\u001b[?2004l\r\u001b[?2004h>     m_norm <- mean(norm_samples)\r\n\u001b[?2004l\r\u001b[?2004h>     sd_norm <- sd(norm_samples)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[284.827187, "o", "\u001b[?2004l\r\u001b[?2004h"]
[284.827603, "o", ">     write.table(norm_samples, file = \"/app/normal_samples.txt\", row.names = FALSE, col.names = FALSE)"]
[284.827772, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[284.828007, "o", ">     if (abs(m_norm - 0) < 0.1 && abs(sd_norm - 1) < 0.1) {"]
[284.8283, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>       cat(sprintf(\"TEST_NORMAL: PASS | Mean: %.4f (Expected: 0.0000), SD: %.4f (Expected: 1.0000)\\n\", m_norm, sd_norm))"]
[284.828426, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.828579, "o", "      cat(sprintf(\"TEST_NORMAL: FAIL | Mean: %.4f, SD: %.4f\\n\", m_norm, sd_norm))"]
[284.82878, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.828914, "o", "      all_passed <- FALSE\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }, error = function(e) {\r\n\u001b[?2004l\r"]
[284.828943, "o", "\u001b[?2004h>     cat(sprintf(\"TEST_NORMAL: FAIL | Error: %s\\n\", e$message))"]
[284.829051, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.829365, "o", "    all_passed <<- FALSE"]
