[163.73438, "i", "cat << 'EOF' > /tmp/test_ars_math.R\neval_h_prime <- function(g, x, eps = 1e-5) {\n  h_plus <- suppressWarnings(log(g(x + eps)))\n  h_minus <- suppressWarnings(log(g(x - eps)))\n  (h_plus - h_minus) / (2 * eps)\n}\nprint(eval_h_prime(dnorm, c(-1, 0, 1)))\nEOF\nRscript /tmp/test_ars_math.R\n"]
[163.734898, "o", "cat << 'EOF' > /tmp/test_ars_math.R"]
[163.735849, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> eval_h_prime <- function(g, x, eps = 1e-5) {\r\n\u001b[?2004l\r\u001b[?2004h>   h_plus <- suppressWarnings(log(g(x + eps)))\r\n\u001b[?2004l\r\u001b[?2004h>   h_minus <- suppressWarnings(log(g(x - eps)))\r\n\u001b[?2004l\r\u001b[?2004h>   (h_plus - h_minus) / (2 * eps)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> print(eval_h_prime(dnorm, c(-1, 0, 1)))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[163.737779, "o", "\u001b[?2004hroot@712776fd52a0:/app# Rscript /tmp/test_ars_math.R\r\n\u001b[?2004l\r"]
[163.919622, "o", "[1]  1  0 -1\r\n"]
[163.925482, "o", "\u001b[?2004hroot@712776fd52a0:/app# "]
[182.916288, "i", "cat << 'EOF' > /tmp/test_envelope.R\ncompute_z <- function(x, h, h_prime, lb, ub) {\n  k <- length(x)\n  z <- numeric(k + 1)\n  z[1] <- lb\n  z[k + 1] <- ub\n  if (k > 1) {\n    for (i in 1:(k - 1)) {\n      dh_p <- h_prime[i] - h_prime[i + 1]\n      if (abs(dh_p) < 1e-12) {\n        z[i + 1] <- (x[i] + x[i + 1]) / 2\n      } else {\n        z[i + 1] <- (h[i + 1] - h[i] - x[i + 1] * h_prime[i + 1] + x[i] * h_prime[i]) / dh_p\n      }\n    }\n  }\n  z\n}\n\ncompute_integrals <- function(x, h, h_prime, z) {\n  k <- length(x)\n  I <- numeric(k)\n  for (i in 1:k) {\n    b <- h_prime[i]\n    z_lower <- z[i]\n    z_upper <- z[i + 1]\n    \n    u_lower <- if (is.infinite(z_lower)) -Inf else h[i] + (z_lower - x[i]) * b\n    u_upper <- if (is.infinite(z_upper)) -Inf else h[i] + (z_upper - x[i]) * b\n    \n    if (abs(b) < 1e-10) {\n      I[i] <- exp(h[i]) * (z_upper - z_lower)\n    } else if (is.infinite(z_upper)) {\n      I[i] <- exp(u_lower) / (-b)\n    } else if (is.infinite(z_lower)) {\n      I[i] <- exp(u_upper) / b\n    } else {\n      u_max <- max(u_lower, u_upper)\n      I[i] <- (exp(u_max) / b) * (exp(u_upper - u_max) - exp(u_lower - u_max))\n    }\n  }\n  I\n}\n\nx <- c(-1, 0, 1)\nh <- log(dnorm(x))\nh_p <- -x\nz <- compute_z(x, h, h_p, -Inf, Inf)\nprint(z)\nI <- compute_integrals(x, h, h_p, z)\nprint(I)\nprint(sum(I))\nEOF\nRscript /tmp/test_envelope.R\n"]
