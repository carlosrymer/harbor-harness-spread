[353.258136, "i", "cat << 'EOF' > /app/ars.R\n# Adaptive Rejection Sampling (ARS) Implementation\n# Reference: Gilks, W. R., & Wild, P. (1992).\n\neval_g <- function(g, x_val, ...) {\n  if (is.function(g)) {\n    return(g(x_val, ...))\n  } else if (is.character(g)) {\n    g_fn <- match.fun(g)\n    return(g_fn(x_val, ...))\n  } else if (is.expression(g) || is.call(g) || is.language(g)) {\n    env <- list(x = x_val, ...)\n    return(eval(g, envir = env))\n  } else {\n    stop(\"'g' must be a function, function name string, or expression\")\n  }\n}\n\neval_h_and_prime <- function(g, x, lb = -Inf, ub = Inf, eps_default = 1e-5, ...) {\n  f_vals <- eval_g(g, x, ...)\n  if (any(is.na(f_vals)) || any(f_vals < 0)) {\n    stop(\"Density function returned invalid (NA or negative) values\")\n  }\n  \n  f_vals_safe <- ifelse(f_vals == 0, 1e-300, f_vals)\n  h_vals <- log(f_vals_safe)\n  \n  dist_lb <- if (is.finite(lb)) (x - lb) / 2 else eps_default\n  dist_ub <- if (is.finite(ub)) (ub - x) / 2 else eps_default\n  eps <- pmin(eps_default, dist_lb, dist_ub)\n  eps <- pmax(eps, 1e-10)\n  \n  f_plus <- eval_g(g, x + eps, ...)\n  f_minus <- eval_g(g, x - eps, ...)\n  \n  f_plus_safe <- ifelse(f_plus == 0, 1e-300, f_plus)\n  f_minus_safe <- ifelse(f_minus == 0, 1e-300, f_minus)\n  \n  h_plus <- log(f_plus_safe)\n  h_minus <- log(f_minus_safe)\n  \n  h_prime_vals <- (h_plus - h_minus) / (2 * eps)\n  \n  return(list(f = f_vals, h = h_vals, h_prime = h_prime_vals))\n}\n\nvalidate_inputs <- function(g, n, lb, ub, x) {\n  if (!is.numeric(n) || length(n) != 1 || is.na(n) || n <= 0 || n != as.integer(n)) {\n    stop(\"Invalid sample count: 'n' must be a positive integer\")\n  }\n  if (!is.numeric(lb) || length(lb) != 1 || is.na(lb) ||\n      !is.numeric(ub) || length(ub) != 1 || is.na(ub) || lb >= ub) {\n    stop(\"Invalid domain: 'lb' must be strictly less than 'ub'\")\n  }\n  if (!is.null(x)) {\n    if (!is.numeric(x) || length(x) < 2) {\n      stop(\"Initial points 'x' must be a numeric vector of length at least 2\")\n    }\n    if (any(x <= lb) || any(x >= ub)) {\n      stop(\"Initial points 'x' must lie strictly within domain (lb, ub)\")\n    }\n  }\n  TRUE\n}\n\ncheck_log_concavity <- function(x, h_prime, tol = 1e-5) {\n  if (length(x) < 2) return(TRUE)\n  diffs <- diff(h_prime)\n  if (any(diffs > tol)) {\n    stop(\"Density is not log-concave: derivative of log-density is increasing\")\n  }\n  TRUE\n}\n\ncompute_intersections <- function(x, h, h_prime, lb, ub) {\n  k <- length(x)\n  z <- numeric(k + 1)\n  z[1] <- lb\n  z[k + 1] <- ub\n  if (k > 1) {\n    for (i in 1:(k - 1)) {\n      dh_p <- h_prime[i] - h_prime[i + 1]\n      if (abs(dh_p) < 1e-12) {\n        z[i + 1] <- (x[i] + x[i + 1]) / 2\n      } else {\n        z[i + 1] <- (h[i + 1] - h[i] - x[i + 1] * h_prime[i + 1] + x[i] * h_prime[i]) / dh_p\n      }\n    }\n  }\n  z\n}\n\ncompute_envelope_integrals <- function(x, h, h_prime, z) {\n  k <- length(x)\n  I <- numeric(k)\n  for (i in 1:k) {\n    b <- h_prime[i]\n    z_lower <- z[i]\n    z_upper <- z[i + 1]\n    \n    u_lower <- if (is.infinite(z_lower)) -Inf else h[i] + (z_lower - x[i]) * b\n    u_upper <- if (is.infinite(z_upper)) -Inf else h[i] + (z_upper - x[i]) * b\n    \n    if (abs(b) < 1e-10) {\n      I[i] <- exp(h[i]) * (z_upper - z_lower)\n    } else if (is.infinite(z_upper)) {\n      I[i] <- exp(u_lower) / (-b)\n    } else if (is.infinite(z_lower)) {\n      I[i] <- exp(u_upper) / b\n    } else {\n      u_max <- max(u_lower, u_upper)\n      I[i] <- (exp(u_max) / b) * (exp(u_upper - u_max) - exp(u_lower - u_max))\n    }\n  }\n  I\n}\n\nsample_upper_envelope <- function(x, h, h_prime, z, I) {\n  k <- length(x)\n  I_tot <- sum(I)\n  if (is.na(I_tot) || I_tot <= 0) {\n    stop(\"Envelope integral is invalid or zero\")\n  }\n  p <- I / I_tot\n  cum_p <- c(0, cumsum(p))\n  \n  u_rand <- runif(1)\n  j <- findInterval(u_rand, cum_p, rightmost.closed = TRUE)\n  if (j < 1) j <- 1\n  if (j > k) j <- k\n  \n  u_prime <- (u_rand - cum_p[j]) / p[j]\n  u_prime <- min(max(u_prime, 1e-15), 1 - 1e-15)\n  \n  b <- h_prime[j]\n  z_lower <- z[j]\n  z_upper <- z[j + 1]\n  \n  if (abs(b) < 1e-10) {\n    x_cand <- z_lower + u_prime * (z_upper - z_lower)\n  } else if (is.infinite(z_upper)) {\n    x_cand <- z_lower + log(1"]
[353.258257, "i", " - u_prime) / b\n  } else if (is.infinite(z_lower)) {\n    x_cand <- z_upper + log(u_prime) / b\n  } else {\n    delta <- z_upper - z_lower\n    b_delta <- b * delta\n    if (b > 0) {\n      x_cand <- z_lower + log1p(u_prime * expm1(b_delta)) / b\n    } else {\n      x_cand <- z_upper + log1p((1 - u_prime) * expm1(-b_delta)) / b\n    }\n  }\n  \n  return(list(x_cand = x_cand, j = j))\n}\n\nars <- function(g, n, lb = -Inf, ub = Inf, x = NULL, ...) {\n  validate_inputs(g, n, lb, ub, x)\n  \n  if (is.null(x)) {\n    if (is.finite(lb) && is.finite(ub)) {\n      x <- seq(lb + 0.25 * (ub - lb), ub - 0.25 * (ub - lb), length.out = 3)\n    } else if (is.finite(lb)) {\n      x <- c(lb + 0.5, lb + 1.5, lb + 3.0)\n    } else if (is.finite(ub)) {\n      x <- c(ub - 3.0, ub - 1.5, ub - 0.5)\n    } else {\n      x <- c(-1.0, 0.0, 1.0)\n    }\n  } else {\n    x <- sort(unique(x))\n    if (length(x) < 2) {\n      stop(\"Initial points 'x' must contain at least 2 distinct values\")\n    }\n  }\n  \n  res <- eval_h_and_prime(g, x, lb = lb, ub = ub, ...)\n  h <- res$h\n  h_prime <- res$h_prime\n  \n  check_log_concavity(x, h_prime)\n  \n  if (is.infinite(lb) && h_prime[1] <= 0) {\n    stop(\"For unbounded lower domain (lb = -Inf), initial derivative at lowest point must be positive\")\n  }\n  if (is.infinite(ub) && h_prime[length(h_prime)] >= 0) {\n    stop(\"For unbounded upper domain (ub = Inf), initial derivative at highest point must be negative\")\n  }\n  \n  z <- compute_intersections(x, h, h_prime, lb, ub)\n  I <- compute_envelope_integrals(x, h, h_prime, z)\n  \n  samples <- numeric(n)\n  n_accepted <- 0\n  \n  while (n_accepted < n) {\n    samp_res <- sample_upper_envelope(x, h, h_prime, z, I)\n    x_cand <- samp_res$x_cand\n    j <- samp_res$j\n    \n    u_val <- h[j] + (x_cand - x[j]) * h_prime[j]\n    \n    if (x_cand >= x[1] && x_cand <= x[length(x)]) {\n      idx <- findInterval(x_cand, x, rightmost.closed = TRUE)\n      if (idx == length(x)) idx <- length(x) - 1\n      l_val <- ((x[idx + 1] - x_cand) * h[idx] + (x_cand - x[idx]) * h[idx + 1]) / (x[idx + 1] - x[idx])\n    } else {\n      l_val <- -Inf\n    }\n    \n    w <- runif(1)\n    log_w <- log(w)\n    \n    if (l_val > -Inf && log_w <= l_val - u_val) {\n      n_accepted <- n_accepted + 1\n      samples[n_accepted] <- x_cand\n    } else {\n      res_cand <- eval_h_and_prime(g, x_cand, lb = lb, ub = ub, ...)\n      h_cand <- res_cand$h\n      h_prime_cand <- res_cand$h_prime\n      \n      accepted <- (log_w <= h_cand - u_val)\n      if (accepted) {\n        n_accepted <- n_accepted + 1\n        samples[n_accepted] <- x_cand\n      }\n      \n      x_new <- c(x, x_cand)\n      h_new <- c(h, h_cand)\n      h_prime_new <- c(h_prime, h_prime_cand)\n      \n      ord <- order(x_new)\n      x_new <- x_new[ord]\n      h_new <- h_new[ord]\n      h_prime_new <- h_prime_new[ord]\n      \n      dup_mask <- duplicated(x_new)\n      if (any(dup_mask)) {\n        x <- x_new[!dup_mask]\n        h <- h_new[!dup_mask]\n        h_prime <- h_prime_new[!dup_mask]\n      } else {\n        x <- x_new\n        h <- h_new\n        h_prime <- h_prime_new\n      }\n      \n      check_log_concavity(x, h_prime)\n      \n      z <- compute_intersections(x, h, h_prime, lb, ub)\n      I <- compute_envelope_integrals(x, h, h_prime, z)\n    }\n  }\n  \n  return(samples)\n}\n\ntest <- function() {\n  cat(\"=========================================\\n\")\n  cat(\"   ARS Implementation Formal Tests\\n\")\n  cat(\"=========================================\\n\\n\")\n  \n  all_passed <- TRUE\n  \n  cat(\"Running Test: Standard Normal Distribution...\\n\")\n  tryCatch({\n    set.seed(42)\n    norm_samples <- ars(dnorm, 5000)\n    m_norm <- mean(norm_samples)\n    sd_norm <- sd(norm_samples)\n    \n    write.table(norm_samples, file = \"/app/normal_samples.txt\", row.names = FALSE, col.names = FALSE)\n    \n    if (abs(m_norm - 0) < 0.1 && abs(sd_norm - 1) < 0.1) {\n      cat(sprintf(\"TEST_NORMAL: PASS | Mean: %.4f (Expected: 0.0000), SD: %.4f (Expected: 1.0000)\\n\", m_norm, sd_norm))\n    } else {\n      cat(sprintf(\"TEST_NORMAL: FAIL | Mean: %.4f, SD: %.4f\\n\", m_norm, sd_norm))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_NOR"]
[353.258517, "i", "MAL: FAIL | Error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\nRunning Test: Exponential Distribution...\\n\")\n  tryCatch({\n    set.seed(42)\n    exp_samples <- ars(dexp, 5000, lb = 0)\n    m_exp <- mean(exp_samples)\n    sd_exp <- sd(exp_samples)\n    \n    write.table(exp_samples, file = \"/app/exponential_samples.txt\", row.names = FALSE, col.names = FALSE)\n    \n    if (abs(m_exp - 1) < 0.1 && abs(sd_exp - 1) < 0.1) {\n      cat(sprintf(\"TEST_EXPONENTIAL: PASS | Mean: %.4f (Expected: 1.0000), SD: %.4f (Expected: 1.0000)\\n\", m_exp, sd_exp))\n    } else {\n      cat(sprintf(\"TEST_EXPONENTIAL: FAIL | Mean: %.4f, SD: %.4f\\n\", m_exp, sd_exp))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_EXPONENTIAL: FAIL | Error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\nRunning Test: Uniform Distribution...\\n\")\n  tryCatch({\n    set.seed(42)\n    unif_samples <- ars(dunif, 5000, lb = 0, ub = 1)\n    m_unif <- mean(unif_samples)\n    sd_unif <- sd(unif_samples)\n    exp_sd_unif <- sqrt(1/12)\n    \n    if (abs(m_unif - 0.5) < 0.05 && abs(sd_unif - exp_sd_unif) < 0.05) {\n      cat(sprintf(\"TEST_UNIFORM: PASS | Mean: %.4f (Expected: 0.5000), SD: %.4f (Expected: %.4f)\\n\", m_unif, sd_unif, exp_sd_unif))\n    } else {\n      cat(sprintf(\"TEST_UNIFORM: FAIL | Mean: %.4f, SD: %.4f\\n\", m_unif, sd_unif))\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_UNIFORM: FAIL | Error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\nRunning Test: Non-Log-Concave Density Detection...\\n\")\n  tryCatch({\n    non_lc <- function(x) exp(x^3)\n    err_caught <- FALSE\n    tryCatch({\n      ars(non_lc, 100, lb = 0, ub = 2, x = c(0.5, 1.0, 1.5))\n    }, error = function(e) {\n      err_caught <<- TRUE\n    })\n    \n    if (err_caught) {\n      cat(\"TEST_NON_LOG_CONCAVE: PASS | Correctly detected non-log-concave density and raised error\\n\")\n    } else {\n      cat(\"TEST_NON_LOG_CONCAVE: FAIL | Did not raise error on non-log-concave density\\n\")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_NON_LOG_CONCAVE: FAIL | Unexpected error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\nRunning Test: Invalid Inputs Validation...\\n\")\n  tryCatch({\n    invalid_n_caught <- FALSE\n    invalid_domain_caught <- FALSE\n    \n    tryCatch(ars(dnorm, n = -5), error = function(e) invalid_n_caught <<- TRUE)\n    tryCatch(ars(dnorm, n = 100, lb = 5, ub = 2), error = function(e) invalid_domain_caught <<- TRUE)\n    \n    if (invalid_n_caught && invalid_domain_caught) {\n      cat(\"TEST_INVALID_INPUTS: PASS | Correctly caught invalid sample count and domain boundaries\\n\")\n    } else {\n      cat(\"TEST_INVALID_INPUTS: FAIL | Failed to catch invalid inputs\\n\")\n      all_passed <- FALSE\n    }\n  }, error = function(e) {\n    cat(sprintf(\"TEST_INVALID_INPUTS: FAIL | Unexpected error: %s\\n\", e$message))\n    all_passed <<- FALSE\n  })\n  \n  cat(\"\\n=========================================\\n\")\n  if (all_passed) {\n    cat(\"  ALL TESTS PASSED SUCCESSFULLY!\\n\")\n  } else {\n    cat(\"  SOME TESTS FAILED!\\n\")\n  }\n  cat(\"=========================================\\n\")\n}\n\nif (!interactive()) {\n  test()\n}\nEOF\nRscript /app/ars.R\n"]
[353.262484, "o", "cat << 'EOF' > /app/ars.R\r\n\u001b[?2004l\r\u001b[?2004h> # Adaptive Rejection Sampling (ARS) Implementation\r\n\u001b[?2004l\r\u001b[?2004h> # Reference: Gilks, W. R., & Wild, P. (1992).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> eval_g <- function(g, x_val, ...) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (is.function(g)) {\r\n\u001b[?2004l\r\u001b[?2004h>     return(g(x_val, ...))\r\n\u001b[?2004l\r\u001b[?2004h>   } else if (is.character(g)) {\r\n\u001b[?2004l\r\u001b[?2004h>     g_fn <- match.fun(g)\r\n\u001b[?2004l\r\u001b[?2004h>     return(g_fn(x_val, ...))\r\n\u001b[?2004l\r\u001b[?2004h>   } else if (is.expression(g) || is.call(g) || is.language(g)) {\r\n\u001b[?2004l\r\u001b[?2004h>     env <- list(x = x_val, ...)\r\n\u001b[?2004l\r\u001b[?2004h>     return(eval(g, envir = env))\r\n\u001b[?2004l\r\u001b[?2004h>   } else {\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"'g' must be a function, function name string, or expression\")\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> eval_h_and_prime <- function(g, x, lb = -Inf, ub = Inf, eps_default = 1e-5, ...) {\r\n\u001b[?2004l\r\u001b[?2004h>   f_vals <- eval_g(g, x, ...)\r\n\u001b[?2004l\r\u001b[?2004h>   if (any(is.na(f_vals)) || any(f_vals < 0)) {\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"Density function returned invalid (NA or negative) values\")\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   f_vals_safe <- ifelse(f_vals == 0, 1e-300, f_vals)\r\n\u001b[?2004l\r\u001b[?2004h>   h_vals <- log(f_vals_safe)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   dist_lb <- if (is.finite(lb)) (x - lb) / 2 else eps_default\r\n\u001b[?2004l\r\u001b[?2004h>   dist_ub <- if (is.finite(ub)) (ub - x) / 2 else eps_default\r\n\u001b[?2004l\r\u001b[?2004h>   eps <- pmin(eps_default, dist_lb, dist_ub)\r\n\u001b[?2004l\r\u001b[?2004h>   eps <- pmax(eps, 1e-10)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   f_plus <- eval_g(g, x + eps, ...)\r\n\u001b[?2004l\r\u001b[?2004h>   f_minus <- eval_g(g, x - eps, ...)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   f_plus_safe <- ifelse(f_plus == 0, 1e-300, f_plus)\r\n\u001b[?2004l\r\u001b[?2004h>   f_minus_safe <- ifelse(f_minus == 0, 1e-300, f_minus)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   h_plus <- log(f_plus_safe)\r\n\u001b[?2004l\r\u001b[?2004h>   h_minus <- log(f_minus_safe)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   h_prime_vals <- (h_plus - h_minus) / (2 * eps)\r\n\u001b[?2004l\r\u001b[?2004h>   \r\n\u001b[?2004l\r\u001b[?2004h>   return(list(f = f_vals, h = h_vals, h_prime = h_prime_vals))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> validate_inputs <- function(g, n, lb, ub, x) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.numeric(n) || length(n) != 1 || is.na(n) || n <= 0 || n != as.integer(n)) {\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"Invalid sample count: 'n' must be a positive integer\")\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.numeric(lb) || length(lb) != 1 || is.na(lb) ||\r\n\u001b[?2004l\r\u001b[?2004h>       !is.numeric(ub) || length(ub) != 1 || is.na(ub) || lb >= ub) {\r\n\u001b[?2004l\r\u001b[?2004h>     stop(\"Invalid domain: 'lb' must be strictly less than 'ub'\")\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (!is.null(x)) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!is.numeric(x) || length(x) < 2) {\r\n\u001b[?2004l\r\u001b[?2004h>       stop(\"Initial points 'x' must be a numeric vector of length at least 2\")\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (any(x <= lb) || any(x >= ub)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
