[239.867322, "i", "cat << 'EOF' > /tmp/test_eval_g.R\neval_g <- function(g, x_val, ...) {\n  if (is.function(g)) {\n    return(g(x_val, ...))\n  } else if (is.character(g)) {\n    g_fn <- match.fun(g)\n    return(g_fn(x_val, ...))\n  } else if (is.expression(g) || is.call(g) || is.language(g)) {\n    env <- list(x = x_val, ...)\n    return(eval(g, envir = env))\n  } else {\n    stop(\"'g' must be a function, function name string, or expression\")\n  }\n}\n\nprint(eval_g(dnorm, c(-1, 0, 1)))\nprint(eval_g(\"dnorm\", c(-1, 0, 1)))\nprint(eval_g(expression(exp(-x^2 / 2)), c(-1, 0, 1)))\nEOF\nRscript /tmp/test_eval_g.R\n"]
