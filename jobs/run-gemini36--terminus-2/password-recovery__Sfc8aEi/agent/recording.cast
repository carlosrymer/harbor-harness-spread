[123.880829, "i", "python3 -c '\nimport re, os\npattern = re.compile(b\"8XD[A-Z0-9]{17}W54\")\nfor root, dirs, files in os.walk(\"/\"):\n    if root.startswith((\"/proc\", \"/sys\", \"/dev\")):\n        continue\n    for fname in files:\n        path = os.path.join(root, fname)\n        try:\n            with open(path, \"rb\") as f:\n                data = f.read()\n                m = pattern.findall(data)\n                if m:\n                    print(path, m)\n        except Exception:\n            pass\n'\n"]
[123.882064, "o", "python3 -c '\r\n\u001b[?2004l\r"]
