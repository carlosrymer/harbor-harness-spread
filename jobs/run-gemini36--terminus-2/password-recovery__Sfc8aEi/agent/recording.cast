[212.312997, "i", "python3 -c '\nimport os, struct\nfor root, dirs, files in os.walk(\"/app\"):\n    for fname in files:\n        path = os.path.join(root, fname)\n        try:\n            with open(path, \"rb\") as f:\n                data = f.read()\n            idx = 0\n            while True:\n                idx = data.find(b\"PK\\x03\\x04\", idx)\n                if idx == -1: break\n                sig, ver, flag, method, time, date, crc, csize, usize, fnlen, elen = struct.unpack(\"<IHHHHHIIIHH\", data[idx:idx+30])\n                fn = data[idx+30:idx+30+fnlen]\n                payload = data[idx+30+fnlen+elen:idx+30+fnlen+elen+csize]\n                print(path, \"offset:\", idx, \"fn:\", fn, \"payload:\", payload)\n                idx += 1\n        except Exception:\n            pass\n'\n"]
