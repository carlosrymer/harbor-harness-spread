[160.606561, "i", "python3 -c '\nimport re\nwith open(\"/dev/vda\", \"rb\") as f:\n    chunk_size = 10*1024*1024\n    offset = 0\n    p1 = re.compile(b\"launchcode\")\n    p2 = re.compile(b\"8XD[A-Z0-9]{17}W54\")\n    p3 = re.compile(b\"PASSWORD=8XD[A-Z0-9]+\")\n    for i in range(50):\n        chunk = f.read(chunk_size)\n        if not chunk: break\n        for m in p1.finditer(chunk):\n            print(\"p1 match at\", offset + m.start(), chunk[max(0, m.start()-20):m.start()+80])\n        for m in p2.finditer(chunk):\n            print(\"p2 MATCH!!\", offset + m.start(), m.group())\n        for m in p3.finditer(chunk):\n            print(\"p3 match at\", offset + m.start(), m.group())\n        offset += len(chunk)\n'\n"]
