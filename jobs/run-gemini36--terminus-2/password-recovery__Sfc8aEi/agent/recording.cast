[199.782539, "i", "python3 -c '\nimport struct\nwith open(\"/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat\", \"rb\") as f:\n    data = f.read()\nidx = 0\nwhile True:\n    idx = data.find(b\"PK\\x03\\x04\", idx)\n    if idx == -1: break\n    print(\"=== PK0304 at\", idx, \"===\")\n    sig, ver, flag, method, time, date, crc, csize, usize, fnlen, elen = struct.unpack(\"<IHHHHHIIIHH\", data[idx:idx+30])\n    fn = data[idx+30:idx+30+fnlen]\n    extra = data[idx+30+fnlen:idx+30+fnlen+elen]\n    payload = data[idx+30+fnlen+elen:idx+30+fnlen+elen+csize]\n    print(\"filename:\", fn, \"method:\", method, \"crc:\", hex(crc), \"csize:\", csize, \"usize:\", usize)\n    print(\"flag:\", hex(flag), \"payload:\", payload)\n    idx += 1\n'\n"]
