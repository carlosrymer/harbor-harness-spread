{
    "job_name": "oracle-baseline",
    "agent_timeout_multiplier": 1.0,
    "quiet": true,
    "environment": {
        "type": "docker",
        "mounts": [
            {
                "type": "bind",
                "source": "/root/.ccr/ca-bundle.crt",
                "target": "/ccr-ca.crt",
                "read_only": true
            },
            {
                "type": "bind",
                "source": "/root/.local/bin/uv",
                "target": "/usr/local/bin/uv",
                "read_only": true
            },
            {
                "type": "bind",
                "source": "/root/.local/bin/uvx",
                "target": "/usr/local/bin/uvx",
                "read_only": true
            }
        ]
    },
    "verifier": {
        "env": {
            "SSL_CERT_FILE": "/ccr-ca.crt",
            "REQUESTS_CA_BUNDLE": "/ccr-ca.crt",
            "CURL_CA_BUNDLE": "/ccr-ca.crt",
            "PIP_CERT": "/ccr-ca.crt",
            "UV_NATIVE_TLS": "1"
        }
    },
    "datasets": [
        {
            "path": "terminal-bench",
            "task_names": [
                "overfull-hbox",
                "gpt2-codegolf",
                "password-recovery",
                "gcode-to-text",
                "log-summary-date-ranges",
                "pytorch-model-recovery",
                "sqlite-with-gcov",
                "tune-mjcf"
            ]
        }
    ]
}