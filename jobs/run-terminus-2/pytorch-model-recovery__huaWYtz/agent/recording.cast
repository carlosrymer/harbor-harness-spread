[221.78601, "i", "model.pt')\n    print('Saved TorchScript model to /app/model.pt')\n\n    # Verify the scripted model can load the original weights\n    loaded_script = torch.jit.load('/app/model.pt')\n    loaded_script.load_state_dict(original_sd, strict=True)\n    print('Verified: scripted model loads original weights.pt with no errors.')\n\n    # Verify state-dict differences are only in output_layer\n    saved_sd = loaded_script.state_dict()\n    diffs = []\n    for k in original_sd:\n        if k not in saved_sd:\n            diffs.append(f'missing in saved: {k}')\n        elif not torch.equal(original_sd[k], saved_sd[k]):\n            diffs.append(k)\n    extra = [k for k in saved_sd if k not in original_sd]\n    print('Keys differing from original weights:', diffs)\n    print('Extra keys in saved model:', extra)\n    assert set(diffs) == {'output_layer.weight', 'output_layer.bias'}, \\\n        f'Unexpected differences: {diffs}'\n    print('All success criteria satisfied.')\n\nif __name__ == '__main__':\n    main()\nPY\n"]
