[316.492461, "i", "cat > /app/solve.py <<'PY'\nimport torch\nimport torch.nn as nn\n\nD_MODEL = 128\nNHEAD = 4\nDIM_FEEDFORWARD = 256\nNUM_ENCODER_LAYERS = 3\nNUM_DECODER_LAYERS = 1\nINPUT_DIM = 64\nMAX_LEN = 5000\n\nclass PositionalEncoding(nn.Module):\n    def __init__(self, d_model, max_len=5000):\n        super().__init__()\n        self.register_buffer('pe', torch.zeros(1, max_len, d_model))\n\n    def forward(self, x):\n        return self.pe[:, :x.size(1), :]\n\nclass RecoveredModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.embedding = nn.Linear(INPUT_DIM, D_MODEL)\n        self.pos_encoder = PositionalEncoding(D_MODEL, max_len=MAX_LEN)\n        encoder_layer = nn.TransformerEncoderLayer(\n            d_model=D_MODEL, nhead=NHEAD, dim_feedforward=DIM_FEEDFORWARD, batch_first=True\n        )\n        self.transformer_encoder = nn.TransformerEncoder(encoder_layer, num_layers=NUM_ENCODER_LAYERS)\n        decoder_layer = nn.TransformerDecoderLayer(\n            d_model=D_MODEL, nhead=NHEAD, dim_feedforward=DIM_FEEDFOR"]
[316.492596, "i", "WARD, batch_first=True\n        )\n        self.transformer_decoder = nn.TransformerDecoder(decoder_layer, num_layers=NUM_DECODER_LAYERS)\n        self.output_layer = nn.Linear(D_MODEL, INPUT_DIM)\n\n    def forward(self, src, tgt):\n        src_emb = self.embedding(src) + self.pos_encoder(self.embedding(src))\n        tgt_emb = self.embedding(tgt) + self.pos_encoder(self.embedding(tgt))\n        memory = self.transformer_encoder(src_emb)\n        out = self.transformer_decoder(tgt_emb, memory)\n        return self.output_layer(out)\n\ndef main():\n    device = torch.device('cpu')\n    data = torch.load('/app/dataset.pt', map_location=device)\n    src = data['src_sequences']\n    tgt = data['tgt_sequences']\n\n    model = RecoveredModel().to(device).eval()\n    original_sd = torch.load('/app/weights.pt', map_location=device)\n    missing, unexpected = model.load_state_dict(original_sd, strict=True)\n    print('Missing keys:', missing)\n    print('Unexpected keys:', unexpected)\n\n    with torch.no_grad():\n        pred = model(src, t"]
[316.492626, "i", "gt)\n    mse_loss = nn.MSELoss()(pred, tgt)\n    print(f'Original MSE: {mse_loss.item():.6f}')\n\n    # Compute least-squares optimal output layer while everything else is frozen\n    with torch.no_grad():\n        src_emb = model.embedding(src) + model.pos_encoder(model.embedding(src))\n        tgt_emb = model.embedding(tgt) + model.pos_encoder(model.embedding(tgt))\n        memory = model.transformer_encoder(src_emb)\n        features = model.transformer_decoder(tgt_emb, memory)\n\n    X = features.reshape(-1, D_MODEL)\n    Y = tgt.reshape(-1, INPUT_DIM)\n    ones = torch.ones(X.size(0), 1, device=X.device, dtype=X.dtype)\n    X_aug = torch.cat([X, ones], dim=1)\n    sol, *_ = torch.linalg.lstsq(X_aug, Y)\n    new_weight = sol[:D_MODEL, :].t().contiguous()\n    new_bias = sol[D_MODEL, :].contiguous()\n\n    with torch.no_grad():\n        model.output_layer.weight.copy_(new_weight)\n        model.output_layer.bias.copy_(new_bias)\n\n    with torch.no_grad():\n        pred2 = model(src, tgt)\n    new_mse = nn.MSELoss()(pred2, tgt)\n  "]
[316.492638, "i", "  print(f'Updated MSE: {new_mse.item():.6f}')\n    assert new_mse.item() < mse_loss.item(), 'Updated MSE is not lower!'\n\n    # Save TorchScript model\n    example_src = src[:1]\n    example_tgt = tgt[:1]\n    scripted = torch.jit.trace(model, (example_src, example_tgt))\n    scripted.eval()\n    torch.jit.save(scripted, '/app/model.pt')\n    print('Saved TorchScript model to /app/model.pt')\n\n    # 1. Verify saved model differs from original only in output_layer\n    loaded_fresh = torch.jit.load('/app/model.pt')\n    saved_sd = loaded_fresh.state_dict()\n    diffs = []\n    for k in original_sd:\n        if k not in saved_sd:\n            diffs.append(f'missing in saved: {k}')\n        elif not torch.equal(original_sd[k], saved_sd[k]):\n            diffs.append(k)\n    extra = [k for k in saved_sd if k not in original_sd]\n    print('Keys differing from original weights:', diffs)\n    print('Extra keys in saved model:', extra)\n    assert set(diffs) == {'output_layer.weight', 'output_layer.bias'}, \\\n        f'Unexpected differe"]
[316.493779, "i", "nces: {diffs}'\n\n    # 2. Verify saved model can load original weights without errors\n    loadable = torch.jit.load('/app/model.pt')\n    loadable.load_state_dict(original_sd, strict=True)\n    print('Verified: scripted model loads original weights.pt with no errors.')\n\n    print('All success criteria satisfied.')\n\nif __name__ == '__main__':\n    main()\nPY\n"]
