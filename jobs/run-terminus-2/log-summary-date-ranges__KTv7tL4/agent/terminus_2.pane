[?2004hroot@ffa1b4afc86a:/app# cat > /app/summarize.py << 'PY'
[?2004l[?2004h> import glob
[?2004l[?2004h> import os
[?2004l[?2004h> import re
[?2004l[?2004h> import csv
[?2004l[?2004h> from datetime import date, timedelta
[?2004l[?2004h> 
[?2004l[?2004h> ref = date(2025, 8, 12)
[?2004l[?2004h> periods = {
[?2004l[?2004h>     'today': (ref, ref),
[?2004l[?2004h>     'last_7_days': (ref - timedelta(days=6), ref),
[?2004l[?2004h>     'last_30_days': (ref - timedelta(days=29), ref),
[?2004l[?2004h>     'month_to_date': (date(ref.year, ref.month, 1), ref),
[?2004l[?2004h> }
[?2004l[?2004h> severities = ['ERROR', 'WARNING', 'INFO']
[?2004l[?2004h> counts = {p: {s: 0 for s in severities} for p in periods}
[?2004l[?2004h> counts['total'] = {s: 0 for s in severities}
[?2004l[?2004h> 
[?2004l[?2004h> sev_re = re.compile(r'\[(ERROR|WARNING|INFO)\]')
[?2004l[?2004h> 
[?2004l[?2004h> for path in glob.glob('/app/logs/*.log'):
[?2004l[?2004h>     fname = os.path.basename(path)
[?2004l[?2004h>     try:
[?2004l[?2004h>         file_date = date.fromisoformat(fname.split('_')[0])
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         continue
[?2004l[?2004h>     with open(path, 'r', encoding='utf-8', errors='ignore') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             m = sev_re.search(line)
[?2004l[?2004h>             if not m:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             sev = m.group(1)
[?2004l[?2004h>             counts['total'][sev] += 1
[?2004l[?2004h>             for p, (start, end) in periods.items():
[?2004l[?2004h>                 if start <= file_date <= end:
[?2004l[?2004h>                     counts[p][sev] += 1
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/summary.csv', 'w', newline='') as out:
[?2004l[?2004h>     writer = csv.writer(out)
[?2004l[?2004h>     writer.writerow(['period', 'severity', 'count'])
[?2004l[?2004h>     for p in ['today', 'last_7_days', 'last_30_days', 'month_to_date', 'total']:
[?2004l[?2004h>         for s in severities:
[?2004l[?2004h>             writer.writerow([p, s, counts[p][s]])
[?2004l[?2004h> PY
[?2004l[?2004hroot@ffa1b4afc86a:/app# python3 /app/summarize.py
