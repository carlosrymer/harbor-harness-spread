[39.392678, "i", "cat > /app/summarize.py << 'PY'\nimport glob\nimport os\nimport re\nimport csv\nfrom datetime import date, timedelta\n\nref = date(2025, 8, 12)\nperiods = {\n    'today': (ref, ref),\n    'last_7_days': (ref - timedelta(days=6), ref),\n    'last_30_days': (ref - timedelta(days=29), ref),\n    'month_to_date': (date(ref.year, ref.month, 1), ref),\n}\nseverities = ['ERROR', 'WARNING', 'INFO']\ncounts = {p: {s: 0 for s in severities} for p in periods}\ncounts['total'] = {s: 0 for s in severities}\n\nsev_re = re.compile(r'\\[(ERROR|WARNING|INFO)\\]')\n\nfor path in glob.glob('/app/logs/*.log'):\n    fname = os.path.basename(path)\n    try:\n        file_date = date.fromisoformat(fname.split('_')[0])\n    except Exception:\n        continue\n    with open(path, 'r', encoding='utf-8', errors='ignore') as f:\n        for line in f:\n            m = sev_re.search(line)\n            if not m:\n                continue\n            sev = m.group(1)\n            counts['total'][sev] += 1\n            for p, (start, end) in periods.items():\n              "]
[39.39278, "i", "  if start <= file_date <= end:\n                    counts[p][sev] += 1\n\nwith open('/app/summary.csv', 'w', newline='') as out:\n    writer = csv.writer(out)\n    writer.writerow(['period', 'severity', 'count'])\n    for p in ['today', 'last_7_days', 'last_30_days', 'month_to_date', 'total']:\n        for s in severities:\n            writer.writerow([p, s, counts[p][s]])\nPY\n"]
