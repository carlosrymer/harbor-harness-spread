[416.529098, "i", "python3 - <<'PY'\nimport struct, re\nd=open('/app/varsea/disks/sub1/subA/subAlpha/ae3f4c.dat','rb').read()\nfor m in re.finditer(b'PK\\x03\\x04', d):\n    p=m.start()\n    if p+30>len(d): continue\n    hdr=d[p:p+30]\n    sig,ver,flags,method,time,date,cs,us,fnl,efl=struct.unpack('<IHHHHHIIHH',hdr)\n    if fnl>200 or us>10000 or cs>10000: continue\n    fname=d[p+30:p+30+fnl]\n    if b'launchcode' in fname:\n        start=p+30+fnl+efl\n        content=d[start:start+us]\n        print('PK at',hex(p),'method',method,'fname',fname,'content',content)\nPY\n"]
