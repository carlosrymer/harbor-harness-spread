Sending keys: ["cat > ascii.py << 'PY'\nimport re\n\nwith open('text.gcode') as f:\n    lines = f.readlines()\n\nsegs = []\ncur = None\nfor line in lines:\n    if not (line.startswith('G1') or line.startswith('G0')):\n        continue\n    m = re.search(r'X([-0-9.]+)', line)\n    x = float(m.group(1)) if m else None\n    m = re.search(r'Y([-0-9.]+)', line)\n    y = float(m.group(1)) if m else None\n    m = re.search(r'E([-0-9.]+)', line)\n    e = m is not None\n    if x is None or y is None:\n        cur = None\n        continue\n    pt = (x,y)\n    if e:\n        if cur is not None:\n            segs.append((cur, pt))\n        cur = pt\n    else:\n        cur = None\n\nxs = [p[0] for s in segs for p in s]\nys = [p[1] for s in segs for p in s]\nxmin,xmax = min(xs), max(xs)\nymin,ymax = min(ys), max(ys)\nprint('bbox', xmin,xmax, ymin,ymax, 'segs', len(segs))\n\nW=200\nH=int(W*(ymax-ymin)/(xmax-xmin))\nif H<20: H=20\nif H>100: H=100\n\ndef tx(x):\n    return int((x-xmin)/(xmax-xmin)*(W-1))\ndef ty(y):\n    return int((y-ymin)/(ymax-ymin)*(H-1))\n\ngrid = [[' ']*W for _ in range(H)]\n\ndef line(x0,y0,x1,y1):\n    dx = abs(x1-x0); dy = abs(y1-y0)\n    sx = 1 if x0<x1 else -1\n    sy = 1 if y0<y1 else -1\n    err = dx-dy\n    while True:\n        if 0<=y0<H and 0<=x0<W:\n            grid[y0][x0] = '#'\n        if x0==x1 and y0==y1:\n            break\n        e2 = 2*err\n        if e2 > -dy:\n            err -= dy; x0 += sx\n        if e2 < dx:\n            err += dx; y0 += sy\n\nfor (x0,y0),(x1,y1) in segs:\n    line(tx(x0), ty(y0), tx(x1), ty(y1))\n\nfor row in grid:\n    print(''.join(row))\nPY\npython3 ascii.py > ascii.txt\nhead -n 120 ascii.txt\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
