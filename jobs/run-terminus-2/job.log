Sending keys: ['cat > segments.py << \'PY\'\nimport re\n\nwith open(\'text.gcode\') as f:\n    lines = f.readlines()\n\nobjs = []\ncur = None\ncur_id = None\nfor i,line in enumerate(lines):\n    s = line.strip()\n    if s.startswith(\'M486 S\'):\n        val = int(s.split()[1][1:])\n        if val >= 0:\n            cur_id = val\n            if cur_id == 0:\n                cur = {\'start\': i, \'segs\': [], \'last\': None}\n        else:\n            if cur_id == 0 and cur is not None:\n                cur[\'end\'] = i\n                objs.append(cur)\n                cur = None\n            cur_id = None\n        continue\n    if cur_id != 0 or cur is None:\n        continue\n    if not (s.startswith(\'G1\') or s.startswith(\'G0\')):\n        continue\n    m = re.search(r\'X([-0-9.]+)\', s)\n    x = float(m.group(1)) if m else None\n    m = re.search(r\'Y([-0-9.]+)\', s)\n    y = float(m.group(1)) if m else None\n    m = re.search(r\'E([-0-9.]+)\', s)\n    e = m is not None\n    if x is None or y is None:\n        cur[\'last\'] = None\n        continue\n    pt = (x,y)\n    if e:\n        if cur[\'last\'] is not None:\n            cur[\'segs\'].append((cur[\'last\'], pt))\n        cur[\'last\'] = pt\n    else:\n        cur[\'last\'] = None\n\nprint(\'num object0 segments\', len(objs))\n\ndef render(segs, W=40):\n    xs = [p[0] for s in segs for p in s]\n    ys = [p[1] for s in segs for p in s]\n    if not xs:\n        return []\n    xmin,xmax = min(xs), max(xs)\n    ymin,ymax = min(ys), max(ys)\n    H = max(10, int(W*(ymax-ymin)/(xmax-xmin))) if xmax!=xmin else 10\n    if H>60: H=60\n    def tx(x): return int((x-xmin)/(xmax-xmin)*(W-1)) if xmax!=xmin else 0\n    def ty(y): return int((y-ymin)/(ymax-ymin)*(H-1)) if ymax!=ymin else 0\n    grid = [[\' \']*(W+2) for _ in range(H)]\n    def line(x0,y0,x1,y1):\n        dx = abs(x1-x0); dy = abs(y1-y0)\n        sx = 1 if x0<x1 else -1\n        sy = 1 if y0<y1 else -1\n        err = dx-dy\n        while True:\n            if 0<=y0<H and 0<=x0<W:\n                grid[y0][x0] = \'#\'\n            if x0==x1 and y0==y1:\n                break\n            e2 = 2*err\n            if e2 > -dy:\n                err -= dy; x0 += sx\n            if e2 < dx:\n                err += dx; y0 += sy\n    for (x0,y0),(x1,y1) in segs:\n        line(tx(x0), ty(y0), tx(x1), ty(y1))\n    return grid, (xmin, xmax, ymin, ymax)\n\nfor idx,o in enumerate(objs):\n    res = render(o[\'segs\'], W=50)\n    if not res:\n        continue\n    grid,bbox = res\n    print(f\'--- segment {idx} lines {o["start"]}-{o["end"]} bbox {bbox[0]:.1f},{bbox[1]:.1f} {bbox[2]:.1f},{bbox[3]:.1f} ---\')\n    for row in grid:\n        print(\'\'.join(row))\n    print()\nPY\npython3 segments.py > segments.txt\nhead -n 250 segments.txt\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
