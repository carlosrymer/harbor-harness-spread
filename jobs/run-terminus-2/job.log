Sending keys: ["cat > /app/solve.py <<'PY'\nimport torch\nimport torch.nn as nn\n\nD_MODEL = 128\nNHEAD = 4\nDIM_FEEDFORWARD = 256\nNUM_ENCODER_LAYERS = 3\nNUM_DECODER_LAYERS = 1\nINPUT_DIM = 64\nMAX_LEN = 5000\n\nclass PositionalEncoding(nn.Module):\n    def __init__(self, d_model, max_len=5000):\n        super().__init__()\n        self.register_buffer('pe', torch.zeros(1, max_len, d_model))\n\n    def forward(self, x):\n        # x: (batch, seq_len, d_model)\n        return self.pe[:, :x.size(1), :]\n\nclass RecoveredModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.embedding = nn.Linear(INPUT_DIM, D_MODEL)\n        self.pos_encoder = PositionalEncoding(D_MODEL, max_len=MAX_LEN)\n        encoder_layer = nn.TransformerEncoderLayer(\n            d_model=D_MODEL,\n            nhead=NHEAD,\n            dim_feedforward=DIM_FEEDFORWARD,\n            batch_first=True,\n        )\n        self.transformer_encoder = nn.TransformerEncoder(\n            encoder_layer, num_layers=NUM_ENCODER_LAYERS\n        )\n        decoder_layer = nn.TransformerDecoderLayer(\n            d_model=D_MODEL,\n            nhead=NHEAD,\n            dim_feedforward=DIM_FEEDFORWARD,\n            batch_first=True,\n        )\n        self.transformer_decoder = nn.TransformerDecoder(\n            decoder_layer, num_layers=NUM_DECODER_LAYERS\n        )\n        self.output_layer = nn.Linear(D_MODEL, INPUT_DIM)\n\n    def forward(self, src, tgt):\n        # src/tgt: (batch, seq_len, INPUT_DIM)\n        src_emb = self.embedding(src)\n        src_emb = src_emb + self.pos_encoder(src_emb)\n        tgt_emb = self.embedding(tgt)\n        tgt_emb = tgt_emb + self.pos_encoder(tgt_emb)\n        memory = self.transformer_encoder(src_emb)\n        out = self.transformer_decoder(tgt_emb, memory)\n        out = self.output_layer(out)\n        return out\n\ndef main():\n    device = torch.device('cpu')\n    data = torch.load('/app/dataset.pt', map_location=device)\n    src = data['src_sequences']  # (20,20,64)\n    tgt = data['tgt_sequences']  # (20,20,64)\n\n    model = RecoveredModel().to(device).eval()\n    original_sd = torch.load('/app/weights.pt', map_location=device)\n    missing, unexpected = model.load_state_dict(original_sd, strict=True)\n    print('Missing keys:', missing)\n    print('Unexpected keys:', unexpected)\n\n    with torch.no_grad():\n        pred = model(src, tgt)\n    mse_loss = nn.MSELoss()(pred, tgt)\n    print(f'Original MSE: {mse_loss.item():.6f}')\n\n    # Freeze everything except output_layer\n    for name, param in model.named_parameters():\n        param.requires_grad = False\n    model.output_layer.weight.requires_grad = True\n    model.output_layer.bias.requires_grad = True\n\n    # Extract features right before output_layer\n    with torch.no_grad():\n        src_emb = model.embedding(src) + model.pos_encoder(model.embedding(src))\n        tgt_emb = model.embedding(tgt) + model.pos_encoder(model.embedding(tgt))\n        memory = model.transformer_encoder(src_emb)\n        features = model.transformer_decoder(tgt_emb, memory)\n\n    B, S, _ = features.shape\n    X = features.reshape(-1, D_MODEL)          # (N, 128)\n    Y = tgt.reshape(-1, INPUT_DIM)             # (N, 64)\n    ones = torch.ones(X.size(0), 1, device=X.device, dtype=X.dtype)\n    X_aug = torch.cat([X, ones], dim=1)        # (N, 129)\n\n    # Least-squares solution for all output dimensions simultaneously\n    sol, *_ = torch.linalg.lstsq(X_aug, Y)\n    # sol shape (129, 64)\n    new_weight = sol[:D_MODEL, :].t().contiguous()  # (64, 128)\n    new_bias = sol[D_MODEL, :].contiguous()         # (64,)\n\n    with torch.no_grad():\n        model.output_layer.weight.copy_(new_weight)\n        model.output_layer.bias.copy_(new_bias)\n\n    with torch.no_grad():\n        pred2 = model(src, tgt)\n    new_mse = nn.MSELoss()(pred2, tgt)\n    print(f'Updated MSE: {new_mse.item():.6f}')\n    assert new_mse.item() < mse_loss.item(), 'Updated MSE is not lower!'\n\n    # Save updated model as TorchScript\n    example_src = src[:1]\n    example_tgt = tgt[:1]\n    scripted = torch.jit.trace(model, (example_src, example_tgt))\n    scripted.eval()\n    torch.jit.save(scripted, '/app/model.pt')\n    print('Saved TorchScript model to /app/model.pt')\n\n    # Verify the scripted model can load the original weights\n    loaded_script = torch.jit.load('/app/model.pt')\n    loaded_script.load_state_dict(original_sd, strict=True)\n    print('Verified: scripted model loads original weights.pt with no errors.')\n\n    # Verify state-dict differences are only in output_layer\n    saved_sd = loaded_script.state_dict()\n    diffs = []\n    for k in original_sd:\n        if k not in saved_sd:\n            diffs.append(f'missing in saved: {k}')\n        elif not torch.equal(original_sd[k], saved_sd[k]):\n            diffs.append(k)\n    extra = [k for k in saved_sd if k not in original_sd]\n    print('Keys differing from original weights:', diffs)\n    print('Extra keys in saved model:', extra)\n    assert set(diffs) == {'output_layer.weight', 'output_layer.bias'}, \\\n        f'Unexpected differences: {diffs}'\n    print('All success criteria satisfied.')\n\nif __name__ == '__main__':\n    main()\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
