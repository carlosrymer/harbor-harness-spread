[48.14124, "i", "python3 - <<'PY'\ntry:\n import torch\n ck=torch.load('gpt2-124M.ckpt',map_location='cpu')\n print(type(ck))\n if isinstance(ck,dict):\n  for k,v in list(ck.items())[:10]: print(k, v.shape if hasattr(v,'shape') else type(v), v.dtype if hasattr(v,'dtype') else '')\nexcept Exception as e: print('torch error',e)\nPY\n"]
