[82.501267, "i", "python3 - <<'PY'\nimport mmap, re\nwith open('gpt2-124M.ckpt','rb') as f:\n    mm=mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)\nprint('mmap len', len(mm))\n# find printable runs\nfor m in re.finditer(b'[\\x20-\\x7e]{10,}', mm):\n    s=m.group(0)\n    if b'model' in s or b'wte' in s or b'wpe' in s or b'/h' in s:\n        print(m.start(), s[:100])\nPY\n"]
