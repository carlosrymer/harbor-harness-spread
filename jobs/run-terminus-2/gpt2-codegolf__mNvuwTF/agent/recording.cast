[63.910843, "i", "python3 - <<'PY'\nimport struct\nwith open('gpt2-124M.ckpt','rb') as f:\n    data=f.read()\nprint('len',len(data))\nprint('floats',len(data)//4)\n# find ASCII strings\nidx=0\nfound=[]\nwhile True:\n    i=data.find(b'model/', idx)\n    if i==-1: break\n    j=i\n    while j<len(data) and data[j]>=32 and data[j]<127: j+=1\n    found.append(data[i:j])\n    idx=j\nprint('model/ strings', found[:50])\nPY\n"]
