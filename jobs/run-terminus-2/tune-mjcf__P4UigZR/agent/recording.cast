[445.13952, "i", "python3 - <<'PY'\nimport mujoco, numpy as np\nm = mujoco.MjModel.from_xml_path('/app/model_ref.xml')\nd = mujoco.MjData(m)\nrng = np.random.default_rng(42)\nd.qpos += rng.normal(0,0.01,size=d.qpos.shape)\nmujoco.mj_forward(m,d)\nsteps = int(2.0/m.opt.timestep)\nmax_ncon = 0\nfor i in range(steps):\n    mujoco.mj_step(m,d)\n    max_ncon = max(max_ncon, d.ncon)\nprint('max contacts', max_ncon)\nPY\n"]
[445.145696, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import mujoco, numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> m = mujoco.MjModel.from_xml_path('/app/model_ref.xml')\r\n\u001b[?2004l\r\u001b[?2004h> d = mujoco.MjData(m)\r\n\u001b[?2004l\r\u001b[?2004h> rng = np.random.default_rng(42)\r\n\u001b[?2004l\r\u001b[?2004h> d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n\u001b[?2004l\r\u001b[?2004h> mujoco.mj_forward(m,d)\r\n\u001b[?2004l\r\u001b[?2004h> steps = int(2.0/m.opt.timestep)\r\n\u001b[?2004l\r\u001b[?2004h> max_ncon = 0\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(steps):\r\n\u001b[?2004l\r\u001b[?2004h>     mujoco.mj_step(m,d)\r\n\u001b[?2004l\r\u001b[?2004h>     max_ncon = max(max_ncon, d.ncon)\r\n\u001b[?2004l\r\u001b[?2004h> print('max contacts', max_ncon)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
