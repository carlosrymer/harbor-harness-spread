[454.964178, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport subprocess\nbase = Path('/app/model_ref.xml').read_text()\n# disable contact\nopt = '<compiler autolimits=\"true\"/>\\n  <option>\\n    <flag contact=\"disable\"/>\\n  </option>'\nxml = base.replace('<compiler autolimits=\"true\"/>', opt)\nPath('/app/model.xml').write_text(xml)\nprint(xml)\nPY\n"]
[454.965968, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> base = Path('/app/model_ref.xml').read_text()\r\n\u001b[?2004l\r\u001b[?2004h> # disable contact\r\n\u001b[?2004l\r\u001b[?2004h> opt = '<compiler autolimits=\"true\"/>\\n  <option>\\n    <flag contact=\"disable\"/>\\n  </option>'\r\n\u001b[?2004l\r\u001b[?2004h> xml = base.replace('<compiler autolimits=\"true\"/>', opt)\r\n\u001b[?2004l\r\u001b[?2004h> Path('/app/model.xml').write_text(xml)\r\n\u001b[?2004l\r\u001b[?2004h> print(xml)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[455.003242, "o", "<!-- Inspired by https://github.com/google-deepmind/mujoco/blob/main/model/plugin/elasticity/cable.xml -->\r\n<mujoco model=\"Cable\">\r\n\r\n  <extension>\r\n    <plugin plugin=\"mujoco.elasticity.cable\"/>\r\n  </extension>\r\n\r\n  <statistic center=\"0 0 .3\" extent=\"1\"/>\r\n  <visual>\r\n    <global elevation=\"-30\"/>\r\n  </visual>\r\n\r\n  <compiler autolimits=\"true\"/>\r\n  <option>\r\n    <flag contact=\"disable\"/>"]
[455.003556, "o", "\r\n  </option>\r\n\r\n  <size memory=\"2M\"/>\r\n\r\n  <worldbody>\r\n    <composite type=\"cable\" curve=\"s\" count=\"41 1 1\" size=\"1\" offset=\"-.3 0 .6\" initial=\"none\">\r\n      <plugin plugin=\"mujoco.elasticity.cable\">\r\n        <!--Units are in Pa (SI)-->\r\n        <config key=\"twist\" value=\"1e7\"/>\r\n        <config key=\"bend\" value=\"4e6\"/>\r\n        <config key=\"vmax\" value=\"0.05\"/>\r\n      </plugin>\r\n      <joint kind=\"main\" damping=\".015\"/>\r\n      <geom type=\"capsule\" size=\".005\" rgba=\".8 .2 .1 1\" condim=\"1\"/>\r\n    </composite>\r\n    <body name=\"slider\" pos=\".7 0 .6\">\r\n      <joint type=\"slide\" axis=\"1 0 0\" damping=\".1\"/>\r\n      <geom size=\".01\"/>\r\n    </body>\r\n  </worldbody>\r\n  <equality>\r\n    <connect name=\"right_boundary\" body1=\"B_last\" body2=\"slider\" anchor=\".025 0 0\"/>\r\n  </equality>\r\n  <contact>\r\n    <exclude body1=\"B_last\" body2=\"slider\"/>\r\n  </contact>\r\n  <actuator>\r\n    <motor site=\"S_last\" gear=\"0 0 0 1 0 0\" ctrlrange=\"-.03 .03\"/>\r\n  </actuator>\r\n</mujoco>\r\n"]
