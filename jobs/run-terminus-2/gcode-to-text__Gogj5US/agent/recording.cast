[391.718165, "i", "cat > render.py << 'PY'\nimport re\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom PIL import Image\n\nwith open('text.gcode') as f:\n    lines = f.readlines()\n\nsegs = []\ncur = None\ncur_id = None\nfor line in lines:\n    s = line.strip()\n    if s.startswith('M486 S'):\n        val = int(s.split()[1][1:])\n        cur_id = val if val >= 0 else None\n        cur = None\n        continue\n    if cur_id != 0:\n        cur = None\n        continue\n    if not (s.startswith('G1') or s.startswith('G0')):\n        continue\n    m = re.search(r'X([-0-9.]+)', s)\n    x = float(m.group(1)) if m else None\n    m = re.search(r'Y([-0-9.]+)', s)\n    y = float(m.group(1)) if m else None\n    m = re.search(r'E([-0-9.]+)', s)\n    e = m is not None\n    if x is None or y is None:\n        cur = None\n        continue\n    pt = (x,y)\n    if e:\n        if cur is not None:\n            segs.append((cur, pt))\n        cur = pt\n    else:\n        cur = None\n\nxs = [p[0] for s in segs for p in s]\nys = [p[1] for s"]
[391.71825, "i", " in segs for p in s]\nxmin, xmax = min(xs), max(xs)\nymin, ymax = min(ys), max(ys)\nprint('bbox', xmin, xmax, ymin, ymax, 'segs', len(segs))\n\n# Plot to image\nfig, ax = plt.subplots(figsize=(14, 7))\nfor (x0,y0),(x1,y1) in segs:\n    ax.plot([x0,x1],[y0,y1], 'k-', linewidth=0.3)\nax.set_xlim(xmin, xmax)\nax.set_ylim(ymin, ymax)\nax.set_aspect('equal')\nax.axis('off')\nfig.tight_layout(pad=0)\nfig.savefig('text.png', dpi=400, bbox_inches='tight', pad_inches=0)\nplt.close()\n\n# Convert to ASCII\nimg = Image.open('text.png').convert('L')\nw, h = img.size\n# Determine ASCII size: width ~160 chars, height proportional to pixel aspect with char aspect ~2:1 (width:height)\naw = 160\nah = int((h/w)*aw*0.5)  # chars are ~2x tall\nif ah < 20: ah = 20\nimg2 = img.resize((aw, ah), Image.Resampling.LANCZOS)\narr = np.array(img2)\n# Invert so dark lines are high\nchars = [' ', '.', ':', '-', '=', '+', '*', '#', '@']\nout = []\nfor row in arr:\n    line = ''\n    for v in row:\n        idx = int((255 - v) / 255 * (len(chars)-1))\n        line += chars[i"]
[391.718318, "i", "dx]\n    out.append(line)\nwith open('text_ascii.txt','w') as f:\n    f.write('\\n'.join(out))\nprint('saved text_ascii.txt', aw, ah)\nPY\npython3 render.py\nhead -n 80 text_ascii.txt\n"]
