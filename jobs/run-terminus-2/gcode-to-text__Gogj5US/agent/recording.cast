[511.889645, "i", "cat > render2.py << 'PY'\nimport re\nfrom PIL import Image, ImageDraw\nimport numpy as np\n\nwith open('text.gcode') as f:\n    lines = f.readlines()\n\nsegs = []\ncur = None\ncur_id = None\nfor line in lines:\n    s = line.strip()\n    if s.startswith('M486 S'):\n        val = int(s.split()[1][1:])\n        cur_id = val if val >= 0 else None\n        cur = None\n        continue\n    if cur_id != 0:\n        cur = None\n        continue\n    if not (s.startswith('G1') or s.startswith('G0')):\n        continue\n    m = re.search(r'X([-0-9.]+)', s)\n    x = float(m.group(1)) if m else None\n    m = re.search(r'Y([-0-9.]+)', s)\n    y = float(m.group(1)) if m else None\n    m = re.search(r'E([-0-9.]+)', s)\n    e = m is not None\n    if x is None or y is None:\n        cur = None\n        continue\n    pt = (x,y)\n    if e:\n        if cur is not None:\n            segs.append((cur, pt))\n        cur = pt\n    else:\n        cur = None\n\nxs = [p[0] for s in segs for p in s]\nys = [p[1] for s in segs for p in s]\nxmin, xmax = min(xs), max(xs)\nymin, yma"]
[511.889989, "o", "cat > render2.py << 'PY'"]
[511.891531, "i", "x = min(ys), max(ys)\nprint('bbox', xmin, xmax, ymin, ymax, 'segs', len(segs))\n\nW = 2400\nscale = W / (xmax - xmin)\nH = int((ymax - ymin) * scale)\nprint('raster', W, H)\nimg = Image.new('L', (W, H), 0)\ndraw = ImageDraw.Draw(img)\nfor (x0,y0),(x1,y1) in segs:\n    draw.line([( (x0-xmin)*scale, H-1-(y0-ymin)*scale ),\n               ( (x1-xmin)*scale, H-1-(y1-ymin)*scale )], fill=255, width=1)\nimg.save('text2.png')\n\n# ASCII downsample\naw = 180\nah = int((H/W)*aw*0.5)\nif ah < 20: ah = 20\nif ah > 80: ah = 80\nimg2 = img.resize((aw, ah), Image.Resampling.LANCZOS)\narr = np.array(img2)\nchars = [' ', '.', ':', '-', '=', '+', '*', '#', '@']\nout = []\nfor row in arr:\n    line = ''\n    for v in row:\n        idx = int(v/255*(len(chars)-1))\n        line += chars[idx]\n    out.append(line)\nwith open('text2_ascii.txt','w') as f:\n    f.write('\\n'.join(out))\nprint('saved text2_ascii.txt', aw, ah)\nPY\npython3 render2.py\nhead -n 100 text2_ascii.txt\n"]
