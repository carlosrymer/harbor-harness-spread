[91.791256, "i", "cat > analyze.py << 'PY'\nimport re\n\nwith open('text.gcode') as f:\n    lines = f.readlines()\n\nobjs = []\ncur = None\nfor i, line in enumerate(lines):\n    line = line.strip()\n    if line.startswith('M486 S'):\n        s = int(line.split()[0].split('S')[1])\n        if s >= 0:\n            cur = {'start': i, 'id': s, 'lines': []}\n        elif cur is not None:\n            cur['end'] = i\n            objs.append(cur)\n            cur = None\n    if cur is not None and (line.startswith('G1') or line.startswith('G0')):\n        cur['lines'].append(line)\nif cur is not None:\n    cur['end'] = len(lines)\n    objs.append(cur)\n\nfor o in objs:\n    xs=[]; ys=[]; es=[]\n    for l in o['lines']:\n        # parse X Y E\n        m=re.search(r'X([-0-9.]+)', l)\n        x=float(m.group(1)) if m else None\n        m=re.search(r'Y([-0-9.]+)', l)\n        y=float(m.group(1)) if m else None\n        m=re.search(r'E([-0-9.]+)', l)\n        e=float(m.group(1)) if m else None\n        if x is not None: xs.append(x)\n        if y is not None: ys.append(y)\n"]
[91.792798, "o", "cat > analyze.py << 'PY'"]
[91.792936, "i", "        if e is not None: es.append(e)\n    if xs and ys:\n        print(f\"obj {o['id']} lines {o['start']}-{o['end']} count {len(o['lines'])} bbox X {min(xs):.2f}-{max(xs):.2f} Y {min(ys):.2f}-{max(ys):.2f} Etot {es[-1]-es[0] if len(es)>1 else 0:.3f}\")\nPY\npython3 analyze.py\n"]
