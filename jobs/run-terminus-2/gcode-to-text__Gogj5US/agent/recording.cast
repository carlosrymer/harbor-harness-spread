[164.020083, "i", "cat > plot.py << 'PY'\nimport re\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\nwith open('text.gcode') as f:\n    lines = f.readlines()\n\nxs=[]; ys=[]\nfor line in lines:\n    if not line.startswith('G1') and not line.startswith('G0'):\n        continue\n    m=re.search(r'X([-0-9.]+)', line)\n    x=float(m.group(1)) if m else None\n    m=re.search(r'Y([-0-9.]+)', line)\n    y=float(m.group(1)) if m else None\n    m=re.search(r'E([-0-9.]+)', line)\n    e=m is not None\n    if x is not None and y is not None and e:\n        xs.append(x)\n        ys.append(y)\n\nplt.figure(figsize=(12,8))\nplt.scatter(xs, ys, s=0.1, c='black')\nplt.gca().set_aspect('equal')\nplt.gca().invert_yaxis()\nplt.savefig('all.png', dpi=300)\nprint('saved all.png points', len(xs))\nPY\npython3 plot.py\n"]
[164.021525, "o", "cat > plot.py << 'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> import matplotlib\r\n\u001b[?2004l\r\u001b[?2004h> matplotlib.use('Agg')\r\n\u001b[?2004l\r\u001b[?2004h> import matplotlib.pyplot as plt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('text.gcode') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> xs=[]; ys=[]\r\n\u001b[?2004l\r"]
