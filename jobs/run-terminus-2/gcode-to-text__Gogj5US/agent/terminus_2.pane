[?2004hroot@d27942192da0:/app# cat > render.py << 'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> import matplotlib
[?2004l[?2004h> matplotlib.use('Agg')
[?2004l[?2004h> import matplotlib.pyplot as plt
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> 
[?2004l[?2004h> with open('text.gcode') as f:
[?2004l[?2004h>     lines = f.readlines()
[?2004l[?2004h> 
[?2004l[?2004h> segs = []
[?2004l[?2004h> cur = None
[?2004l[?2004h> cur_id = None
[?2004l[?2004h> for line in lines:
[?2004l[?2004h>     s = line.strip()
[?2004l[?2004h>     if s.startswith('M486 S'):
[?2004l[?2004h>         val = int(s.split()[1][1:])
[?2004l[?2004h>         cur_id = val if val >= 0 else None
[?2004l[?2004h>         cur = None
[?2004l[?2004h>         continue
[?2004l[?2004h>     if cur_id != 0:
[?2004l[?2004h>         cur = None
[?2004l[?2004h>         continue
[?2004l[?2004h>     if not (s.startswith('G1') or s.startswith('G0')):
[?2004l[?2004h>         continue
[?2004l[?2004h>     m = re.search(r'X([-0-9.]+)', s)
[?2004l[?2004h>     x = float(m.group(1)) if m else None
[?2004l[?2004h>     m = re.search(r'Y([-0-9.]+)', s)
[?2004l[?2004h>     y = float(m.group(1)) if m else None
[?2004l[?2004h>     m = re.search(r'E([-0-9.]+)', s)
[?2004l[?2004h>     e = m is not None
[?2004l[?2004h>     if x is None or y is None:
[?2004l[?2004h>         cur = None
[?2004l[?2004h>         continue
[?2004l[?2004h>     pt = (x,y)
[?2004l[?2004h>     if e:
[?2004l[?2004h>         if cur is not None:
[?2004l[?2004h>             segs.append((cur, pt))
[?2004l[?2004h>         cur = pt
[?2004l[?2004h>     else:
[?2004l[?2004h>         cur = None
[?2004l[?2004h> 
[?2004l[?2004h> xs = [p[0] for s in segs for p in s]
[?2004l[?2004h> ys = [p[1] for s in segs for p in s]
[?2004l[?2004h> xmin, xmax = min(xs), max(xs)
[?2004l[?2004h> ymin, ymax = min(ys), max(ys)
[?2004l[?2004h> print('bbox', xmin, xmax, ymin, ymax, 'segs', len(segs))
[?2004l[?2004h> 
[?2004l[?2004h> # Plot to image
[?2004l[?2004h> fig, ax = plt.subplots(figsize=(14, 7))
[?2004l[?2004h> for (x0,y0),(x1,y1) in segs:
[?2004l[?2004h>     ax.plot([x0,x1],[y0,y1], 'k-', linewidth=0.3)
[?2004l[?2004h> ax.set_xlim(xmin, xmax)
[?2004l[?2004h> ax.set_ylim(ymin, ymax)
[?2004l[?2004h> ax.set_aspect('equal')
[?2004l[?2004h> ax.axis('off')
[?2004l[?2004h> fig.tight_layout(pad=0)
[?2004l[?2004h> fig.savefig('text.png', dpi=400, bbox_inches='tight', pad_inches=0)
[?2004l[?2004h> plt.close()
[?2004l[?2004h> 
[?2004l[?2004h> # Convert to ASCII
[?2004l[?2004h> img = Image.open('text.png').convert('L')
[?2004l[?2004h> w, h = img.size
[?2004l[?2004h> # Determine ASCII size: width ~160 chars, height proportional to pixel aspect with char aspect ~2:1 (width:height)
[?2004l[?2004h> aw = 160
[?2004l[?2004h> ah = int((h/w)*aw*0.5)  # chars are ~2x tall
[?2004l[?2004h> if ah < 20: ah = 20
[?2004l[?2004h> img2 = img.resize((aw, ah), Image.Resampling.LANCZOS)
[?2004l[?2004h> arr = np.array(img2)
[?2004l[?2004h> # Invert so dark lines are high
[?2004l[?2004h> chars = [' ', '.', ':', '-', '=', '+', '*', '#', '@']
[?2004l[?2004h> out = []
[?2004l[?2004h> for row in arr:
[?2004l[?2004h>     line = ''
[?2004l[?2004h>     for v in row:
[?2004l[?2004h>         idx = int((255 - v) / 255 * (len(chars)-1))
[?2004l[?2004h>         line += chars[idx]
[?2004l[?2004h>     out.append(line)
[?2004l[?2004h> with open('text_ascii.txt','w') as f:
[?2004l[?2004h>     f.write('\n'.join(out))
[?2004l[?2004h> print('saved text_ascii.txt', aw, ah)
[?2004l[?2004h> PY
[?2004l[?2004hroot@d27942192da0:/app# python3 render.py
