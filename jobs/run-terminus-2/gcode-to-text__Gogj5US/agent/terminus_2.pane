[?2004hroot@d27942192da0:/app# cat > render2.py << 'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> from PIL import Image, ImageDraw
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> with open('text.gcode') as f:
[?2004l[?2004h>     lines = f.readlines()
[?2004l[?2004h> 
[?2004l[?2004h> segs = []
[?2004l[?2004h> cur = None
[?2004l[?2004h> cur_id = None
[?2004l[?2004h> for line in lines:
[?2004l[?2004h>     s = line.strip()
[?2004l[?2004h>     if s.startswith('M486 S'):
[?2004l[?2004h>         val = int(s.split()[1][1:])
[?2004l[?2004h>         cur_id = val if val >= 0 else None
[?2004l[?2004h>         cur = None
[?2004l[?2004h>         continue
[?2004l[?2004h>     if cur_id != 0:
[?2004l[?2004h>         cur = None
[?2004l[?2004h>         continue
[?2004l[?2004h>     if not (s.startswith('G1') or s.startswith('G0')):
[?2004l[?2004h>         continue
[?2004l[?2004h>     m = re.search(r'X([-0-9.]+)', s)
[?2004l[?2004h>     x = float(m.group(1)) if m else None
[?2004l[?2004h>     m = re.search(r'Y([-0-9.]+)', s)
[?2004l[?2004h>     y = float(m.group(1)) if m else None
[?2004l[?2004h>     m = re.search(r'E([-0-9.]+)', s)
[?2004l[?2004h>     e = m is not None
[?2004l[?2004h>     if x is None or y is None:
[?2004l[?2004h>         cur = None
[?2004l[?2004h>         continue
[?2004l[?2004h>     pt = (x,y)
[?2004l[?2004h>     if e:
[?2004l[?2004h>         if cur is not None:
[?2004l[?2004h>             segs.append((cur, pt))
[?2004l[?2004h>         cur = pt
[?2004l[?2004h>     else:
[?2004l[?2004h>         cur = None
[?2004l[?2004h> 
[?2004l[?2004h> xs = [p[0] for s in segs for p in s]
[?2004l[?2004h> ys = [p[1] for s in segs for p in s]
[?2004l[?2004h> xmin, xmax = min(xs), max(xs)
[?2004l[?2004h> ymin, ymax = min(ys), max(ys)
[?2004l[?2004h> print('bbox', xmin, xmax, ymin, ymax, 'segs', len(segs))
[?2004l[?2004h> 
[?2004l[?2004h> W = 2400
[?2004l[?2004h> scale = W / (xmax - xmin)
[?2004l[?2004h> H = int((ymax - ymin) * scale)
[?2004l[?2004h> print('raster', W, H)
[?2004l[?2004h> img = Image.new('L', (W, H), 0)
[?2004l[?2004h> draw = ImageDraw.Draw(img)
[?2004l[?2004h> for (x0,y0),(x1,y1) in segs:
[?2004l[?2004h>     draw.line([( (x0-xmin)*scale, H-1-(y0-ymin)*scale ),
[?2004l[?2004h>                ( (x1-xmin)*scale, H-1-(y1-ymin)*scale )], fill=255, width=1)
[?2004l[?2004h> img.save('text2.png')
[?2004l[?2004h> 
[?2004l[?2004h> # ASCII downsample
[?2004l[?2004h> aw = 180
[?2004l[?2004h> ah = int((H/W)*aw*0.5)
[?2004l[?2004h> if ah < 20: ah = 20
[?2004l[?2004h> if ah > 80: ah = 80
[?2004l[?2004h> img2 = img.resize((aw, ah), Image.Resampling.LANCZOS)
[?2004l[?2004h> arr = np.array(img2)
[?2004l[?2004h> chars = [' ', '.', ':', '-', '=', '+', '*', '#', '@']
[?2004l[?2004h> out = []
[?2004l[?2004h> for row in arr:
[?2004l[?2004h>     line = ''
[?2004l[?2004h>     for v in row:
[?2004l[?2004h>         idx = int(v/255*(len(chars)-1))
[?2004l[?2004h>         line += chars[idx]
[?2004l[?2004h>     out.append(line)
[?2004l[?2004h> with open('text2_ascii.txt','w') as f:
[?2004l[?2004h>     f.write('\n'.join(out))
[?2004l[?2004h> print('saved text2_ascii.txt', aw, ah)
[?2004l[?2004h> PY
