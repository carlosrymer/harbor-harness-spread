[?2004l[?2004h>         sx = 1 if x0<x1 else -1
[?2004l[?2004h>         sy = 1 if y0<y1 else -1
[?2004l[?2004h>         err = dx-dy
[?2004l[?2004h>         while True:
[?2004l[?2004h>             if 0<=y0<H and 0<=x0<W:
[?2004l[?2004h>                 grid[y0][x0] = '#'
[?2004l[?2004h>             if x0==x1 and y0==y1:
[?2004l[?2004h>                 break
[?2004l[?2004h>             e2 = 2*err
[?2004l[?2004h>             if e2 > -dy:
[?2004l[?2004h>                 err -= dy; x0 += sx
[?2004l[?2004h>             if e2 < dx:
[?2004l[?2004h>                 err += dx; y0 += sy
[?2004l[?2004h>     for (x0,y0),(x1,y1) in segs:
[?2004l[?2004h>         line(tx(x0), ty(y0), tx(x1), ty(y1))
[?2004l[?2004h>     return grid, (xmin, xmax, ymin, ymax)
[?2004l[?2004h> 
[?2004l[?2004h> for idx,o in enumerate(objs):
[?2004l[?2004h>     res = render(o['segs'], W=50)
[?2004l[?2004h>     if not res:
[?2004l[?2004h>         continue
[?2004l[?2004h>     grid,bbox = res
[?2004l[?2004h>     print(f'--- segment {idx} lines {o["start"]}-{o["end"]} bbox {bbox[0]:.1f},{bbox[1]:.1f} {bbox[2]:.1f},{bbox[3]:.1f} ---')
[?2004l[?2004h>     for row in grid:
[?2004l[?2004h>         print(''.join(row))
[?2004l[?2004h>     print()
[?2004l[?2004h> PY
